From: Stanislaw Pal <kuncy7@gmail.com>
Subject: [PATCH] ath11k: pick the memory profile at run time

The host-side memory profile - the data path ring sizes and whether the
rx descriptor carries the rx header TLV - was a build-time choice:
ATH11K_MEM_PROFILE_1G, _512M or _256M, 20 #ifdef sites in six files and
one value for every board in an image.

Do what ath12k does: keep the three profiles as rows of a table
(ath11k_mem_profile_params) and pick the row when the device probes,
from the amount of RAM the kernel manages or with the new mem_profile
module parameter (1 1G, 2 512M, 3 256M; 0, the default, chooses from the
RAM size). From the RAM size only two rows are chosen: 256M below
384 MB, 1G otherwise. The 512M row leaves the rx header TLV out of the
rx descriptor, which the PCI radios in this tree have not run with, so
no board gets it on its own. The rows hold what the three builds
compiled in, including the 1G monitor destination ring of 4096 entries
this tree has had since DP_RXDMA_MONITOR_DST_RING_SIZE was aliased to
the buffer ring size, and the 1024-entry RXDMA buffer ring of a QCN6122
radio on the 256M row.

What changes under the hood:

 - DP_TX_COMP_RING_SIZE, DP_TX_IDR_SIZE, DP_TX_COMP_MAX_ALLOWED and the
   DP_RXDMA_*_RING_SIZE macros take ab and read the profile; the idr
   bitmap in struct dp_tx_ring is sized for the largest profile (32768
   bits, 4 KB per ring);

 - the cap on frames in flight (tx_comp_max_allowed) is a value instead
   of an #ifdef: 0 on the 1G row means no cap;

 - the rx header TLV: rx_desc_get_offset is part of every hw_ops table
   and the rx_desc_get_hdr_status ops always return the descriptor's
   field; ath11k_dp_rx_h_80211_hdr() returns NULL and
   ath11k_dp_rxdma_ring_sel_config() tells the firmware to leave the
   TLV out only when ab->compact_rx_desc is set, which needs the
   profile's compact_rx_desc and an hw_ops table that has
   rx_desc_get_offset - wcn6855 and wcn6750 have none and keep the full
   descriptor whatever the profile;

 - the QMI target memory mode a hw_params entry used to take from the
   profile symbol (ATH11K_QMI_TARGET_MEM_MODE) is now
   ATH11K_QMI_TARGET_MEM_MODE_PROFILE in the table and resolved from
   the chosen profile right after the entry is copied; a device tree's
   qcom,ath11k-fw-memory-mode still overrides it, as before;

 - TARGET_NUM_VDEVS/PEERS/STATIONS are always the num_vdevs_peers table
   indexed by the target memory mode (the 512M and 256M builds had them
   as the constants 8/136/128; for a radio in firmware memory mode 1
   that is one vdev more than before);

 - the RX descriptor pool the NSS Wi-Fi datapath makes for a radio was
   three times the RXDMA buffer ring; it is a field of its own now
   (nss_rx_swdesc), with the same numbers, so that the pool and the
   ring can be sized apart;

 - ath11k_nss_256m_enabled() tests the chosen profile instead of the
   build symbol; ATH11K_NSS_MEM_PROFILE_256M stays a build option, off
   by default, and now only depends on ATH11K_NSS_SUPPORT;

 - the ATH11K_MEM_PROFILE_512M/256M Kconfig symbols are gone;

 - the unused ipq8074 M3 dump address #ifdef in qmi.h is gone (both
   values kept).

One line in the log says what was chosen:

  ath11k c000000.wifi: memory profile 1G (from the RAM size, 413 MB), rx descriptor full

Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
---
--- a/drivers/net/wireless/ath/ath11k/Kconfig
+++ b/drivers/net/wireless/ath/ath11k/Kconfig
@@ -31,20 +31,6 @@ config ATH11K_NSS_SUPPORT
 
 	  If unsure, say Y to enable NSS offload support.
 
-config ATH11K_MEM_PROFILE_512M
-	bool "ath11k enable 512MB memory profile"
-	depends on ATH11K
-	default n
-	---help---
-	Enables 512MB memory profile for ath11k
-
-config ATH11K_MEM_PROFILE_256M
-	bool "ath11k enable 256MB memory profile"
-	depends on ATH11K
-	default n
-	---help---
-	Enables 256MB memory profile for ath11k
-
 config ATH11K_AHB
 	tristate "Atheros ath11k AHB support"
 	depends on m
@@ -115,11 +101,13 @@ config ATH11K_CFR
 
 config ATH11K_NSS_MEM_PROFILE_256M
 	bool "Smaller NSS allocations for 256 MiB IPQ5018/QCN6122 devices"
-	depends on ATH11K_NSS_SUPPORT && ATH11K_MEM_PROFILE_256M
+	depends on ATH11K_NSS_SUPPORT
 	default n
 	help
 	  Skip unused host TX arrays, reduce NSS TX pools and completion
 	  rings, use private RX fragment caches, and reduce CE5 buffers.
-	  Only IPQ5018 and QCN6122 with active NSS use this profile.
+	  Only IPQ5018 and QCN6122 with active NSS on the 256M memory
+	  profile (chosen at run time from the RAM size, or with the
+	  mem_profile module parameter) use this.
 	  TX and CE5 queue capacity is lower. Other hardware and the
 	  host-only data path retain their existing allocations.
--- a/drivers/net/wireless/ath/ath11k/ce.c
+++ b/drivers/net/wireless/ath/ath11k/ce.c
@@ -742,7 +742,7 @@ static int ath11k_ce_alloc_pipe(struct a
 		if (ce5_256m)
 			ath11k_info(ab, "NSS 256 MiB: active host_tx=0 tx_desc=%u tx_comp=%u CE5=%u/%u buf=%u RX=private\n",
 				    ATH11K_NSS_256M_TX_DESC_LIMIT,
-				    min_t(u32, DP_TX_COMP_RING_SIZE,
+				    min_t(u32, DP_TX_COMP_RING_SIZE(ab),
 					  ATH11K_NSS_256M_TX_DESC_LIMIT),
 				    pipe->dest_ring->nentries,
 				    pipe->status_ring->nentries, pipe->buf_sz);
@@ -1056,7 +1056,7 @@ int ath11k_ce_init_pipes(struct ath11k_b
 		}
 
 		/* Report recorded sizes, including after NSS recovery. */
-		if (IS_ENABLED(CPTCFG_ATH11K_NSS_MEM_PROFILE_256M) && i == 5 &&
+		if (ath11k_nss_256m_enabled(ab) && i == 5 &&
 		    pipe->dest_ring && pipe->status_ring &&
 		    pipe->dest_ring->nentries == ATH11K_NSS_256M_CE5_ENTRIES)
 			ath11k_dbg(ab, ATH11K_DBG_CE, "NSS 256 MiB: CE5 rings ready dst=%u status=%u post_target=%u\n",
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -6,6 +6,8 @@
 
 #include <linux/export.h>
 #include <linux/module.h>
+#include <linux/mm.h>
+#include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/remoteproc.h>
 #include <linux/firmware.h>
@@ -44,6 +46,132 @@ bool ath11k_ftm_mode;
 module_param_named(ftm_mode, ath11k_ftm_mode, bool, 0444);
 MODULE_PARM_DESC(ftm_mode, "Boots up in factory test mode");
 
+static unsigned int ath11k_mem_profile_param;
+module_param_named(mem_profile, ath11k_mem_profile_param, uint, 0644);
+MODULE_PARM_DESC(mem_profile,
+		 "host memory profile: 0 from the RAM size (default: 256M below 384 MB, else 1G), 1 1G, 2 512M, 3 256M");
+
+/* The host-side memory profile, picked at run time from the amount of RAM
+ * or with the mem_profile parameter. The rows are what the build-time
+ * profiles ATH11K_MEM_PROFILE_1G, _512M and _256M used to compile in: 512M
+ * is 1G with smaller TX completion and monitor rings, a cap on the frames
+ * in flight and the rx descriptor without its rx header TLV; 256M is 512M
+ * with smaller RXDMA rings as well. nss_rx_swdesc is the RX descriptor pool
+ * the NSS Wi-Fi datapath is told to make for a radio; it used to be three
+ * times the RXDMA buffer ring and keeps those numbers, but it is a value of
+ * its own now: the pool and the ring need not move together. The _qcn6122
+ * fields, where not 0, replace the plain ones on that radio: at 512 its
+ * RXDMA buffer ring overflows under upload bursts. The firmware's own memory mode is a
+ * separate thing: it comes from the device tree, and only a hw_params
+ * entry that leaves it to the profile takes fw_mem_mode from here.
+ */
+static const struct ath11k_mem_profile_params ath11k_mem_profile_params[] = {
+	[ATH11K_MEM_PROFILE_1G] = {
+		.id = ATH11K_MEM_PROFILE_1G,
+		.name = "1G",
+		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE_DEFAULT,
+		.tx_comp_ring_size = 32768,
+		.tx_comp_max_allowed = 0,
+		.rxdma_buf_ring_size = 4096,
+		.nss_rx_swdesc = 12288,
+		.rxdma_refill_ring_size = 2048,
+		.rxdma_nss_refill_ring_size = 2048,
+		.rxdma_err_dst_ring_size = 1024,
+		.rxdma_mon_status_ring_size = 1024,
+		.rxdma_monitor_buf_ring_size = 4096,
+		.rxdma_monitor_dst_ring_size = 4096,
+		.rxdma_monitor_desc_ring_size = 4096,
+		.compact_rx_desc = false,
+	},
+	[ATH11K_MEM_PROFILE_512M] = {
+		.id = ATH11K_MEM_PROFILE_512M,
+		.name = "512M",
+		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE_512M,
+		.tx_comp_ring_size = 8192,
+		.tx_comp_max_allowed = 8192,
+		.rxdma_buf_ring_size = 4096,
+		.nss_rx_swdesc = 12288,
+		.rxdma_refill_ring_size = 2048,
+		/* 256b desc TLV + 4b(rounded) Pad + 30byte max nwifi header +
+		 * 18byte mesh hdr + 8byte snap + 1500 eth payload
+		 */
+		.rxdma_nss_refill_ring_size = 1816,
+		.rxdma_err_dst_ring_size = 1024,
+		.rxdma_mon_status_ring_size = 512,
+		.rxdma_monitor_buf_ring_size = 128,
+		.rxdma_monitor_dst_ring_size = 128,
+		.rxdma_monitor_desc_ring_size = 4096,
+		.compact_rx_desc = true,
+	},
+	[ATH11K_MEM_PROFILE_256M] = {
+		.id = ATH11K_MEM_PROFILE_256M,
+		.name = "256M",
+		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE_512M,
+		.tx_comp_ring_size = 8192,
+		.tx_comp_max_allowed = 8192,
+		.rxdma_buf_ring_size = 512,
+		.rxdma_buf_ring_size_qcn6122 = 1024,
+		.nss_rx_swdesc = 1536,
+		.nss_rx_swdesc_qcn6122 = 3072,
+		.rxdma_refill_ring_size = 2048,
+		.rxdma_nss_refill_ring_size = 1816,
+		.rxdma_err_dst_ring_size = 128,
+		.rxdma_mon_status_ring_size = 512,
+		.rxdma_monitor_buf_ring_size = 128,
+		.rxdma_monitor_dst_ring_size = 128,
+		.rxdma_monitor_desc_ring_size = 128,
+		.compact_rx_desc = true,
+	},
+};
+
+static enum ath11k_mem_profile ath11k_core_mem_profile_by_ram(unsigned long *total_mb)
+{
+	struct sysinfo si;
+	u64 total;
+
+	si_meminfo(&si);
+	total = (u64)si.totalram * si.mem_unit;
+	*total_mb = total >> 20;
+
+	/* What the kernel manages, after the reserved regions: a 256 MB board
+	 * shows about 200 MB here, a 512 MB board about 420 MB. Only the
+	 * 256 MB boards change profile on their own: the 512M row leaves the
+	 * rx header TLV out of the rx descriptor, which not every radio has
+	 * run with, so it is there for mem_profile=2 only.
+	 */
+	if (total < SZ_256M + SZ_128M)
+		return ATH11K_MEM_PROFILE_256M;
+
+	return ATH11K_MEM_PROFILE_1G;
+}
+
+/* Needs ab->hw_params: the rx header TLV can only be left out where the
+ * hw_ops can tell the firmware the descriptor offsets without it.
+ */
+static void ath11k_core_select_mem_profile(struct ath11k_base *ab)
+{
+	enum ath11k_mem_profile profile;
+	unsigned long total_mb;
+	const char *how = "from the RAM size";
+
+	profile = ath11k_core_mem_profile_by_ram(&total_mb);
+	if (ath11k_mem_profile_param > ATH11K_MEM_PROFILE_COUNT) {
+		ath11k_warn(ab, "mem_profile %u is not a profile, choosing from the RAM size\n",
+			    ath11k_mem_profile_param);
+	} else if (ath11k_mem_profile_param) {
+		profile = ath11k_mem_profile_param - 1;
+		how = "mem_profile parameter";
+	}
+
+	ab->mem_profile = &ath11k_mem_profile_params[profile];
+	ab->compact_rx_desc = ab->mem_profile->compact_rx_desc &&
+			      ab->hw_params.hw_ops->rx_desc_get_offset;
+
+	ath11k_info(ab, "memory profile %s (%s, %lu MB), rx descriptor %s\n",
+		    ab->mem_profile->name, how, total_mb,
+		    ab->compact_rx_desc ? "without the rx header TLV" : "full");
+}
+
 static const struct ath11k_num_vdevs_peers ath11k_vdevs_peers[];
 static const struct ath11k_num_vdevs_peers ath11k_vdevs_peers_ipq5018[];
 
