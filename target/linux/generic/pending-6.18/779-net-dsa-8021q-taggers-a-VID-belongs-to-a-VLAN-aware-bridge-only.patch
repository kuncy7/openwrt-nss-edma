 /* Is this VID a VLAN of a VLAN-aware bridge that @port is not in? The
  * tagger picks the bridge by the VID alone, so one VID cannot serve two.
+ * Asked of the VLAN table, not of the bridges: a VLAN-unaware bridge has
+ * VLANs too (the default PVID on every port), but none of them is on the
+ * wire.
  */
 static bool qca8k_vlan_in_other_bridge(struct dsa_switch *ds, int port,
 				       u16 vid)
 {
 	struct dsa_port *dp = dsa_to_port(ds, port), *other;
-	struct bridge_vlan_info vinfo;
-	bool found = false;
+	struct qca8k_priv *priv = ds->priv;
 
-	rcu_read_lock();
 	dsa_switch_for_each_user_port(other, ds) {
-		if (!other->bridge || !other->user ||
-		    dsa_port_bridge_same(dp, other))
+		if (other->index == port || dsa_port_bridge_same(dp, other))
 			continue;
-		if (!br_vlan_get_info_rcu(other->user, vid, &vinfo)) {
-			found = true;
-			break;
-		}
+		if (test_bit(vid, priv->bridge_vlans[other->index]))
+			return true;
 	}
-	rcu_read_unlock();
 
-	return found;
+	return false;
 }
 
 /* An 802.1Q upper of a port is delivered by its VID, so the VID must not
@@ -1191,6 +1188,10 @@
 	return 0;
 }
 
+static int qca8k_bridge_vlans_install(struct dsa_switch *ds, int port,
