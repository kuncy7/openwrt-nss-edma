From: Stanislaw Pal <kuncy7@gmail.com>
Date: Sun, 13 Sep 2026 20:40:00 +0200
Subject: [PATCH] net: dsa: realtek: rtl8365mb: add an 802.1Q VLAN-based tag driver

Same reason as the qca8k tagger before it: the 8-byte Realtek CPU tag
that tag_rtl8_4 puts behind the source address is understood by the
switch and by tag_rtl8_4 alone, so a hardware accelerator on the
conduit's MAC that only parses 802.1Q cannot follow the frame. On the
IPQ5018 that means the DSA ports of an RTL8367S and the NSS firmware
exclude each other.

Add a tag driver built on the tag_8021q framework, the same wire format
as tag_qca_8021q (the source port travels in a VLAN tag the switch
inserts, an 802.1Q upper of a standalone port is carried as it is), and
teach rtl8365mb the mode: change_tag_protocol turns the CPU tag off on
the CPU ports, takes the VLAN engine out of the transparent mode a
VLAN-unaware port normally gets (in 8021q mode the VLAN 4K membership
decides where a frame may go and the entry's untag mask whether the tag
stays on - the CPU port is never in an untag mask, the user ports are
in their own), registers with tag_8021q, and the tag_8021q VIDs go into
the VLAN 4K table and the PVID registers like any other VLAN. Bridge
join and leave swap the standalone VID for the bridge's; FDB and MDB
entries a VLAN-unaware bridge hands over with VID 0 go into the
tag_8021q VID the switch learns in (IVL). The user ports advertise
NETIF_F_HW_VLAN_CTAG_FILTER in this mode so that the VLAN of an 802.1Q
upper is installed on the port and the CPU port. The default stays the
Realtek tag; the VLAN tagger is chosen from the device tree
(dsa-tag-protocol = "rtl8365mb-8021q") or at runtime through
/sys/class/net/<conduit>/dsa/tagging.

A VLAN-aware bridge works as on the qca8k tagger: its VLANs go into
the VLAN 4K table as they are, PVID and untagged included, the CPU port
is a tagged member of each, and a frame received in one of them is
handed to a port of that bridge which is in the VLAN, tag left on. The
port keeps two PVIDs, the tag_8021q one and the bridge's, and
vlan_filtering picks which the register holds; a VID outside the
tag_8021q range names one thing on the switch. Ingress filtering is on
in this mode, so a tagged frame in a VLAN the port is not a member of
is dropped at the port instead of reaching an upper or a VLAN-aware
bridge it was never meant for.

Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -93,6 +93,7 @@
 
 #include <linux/bitfield.h>
 #include <linux/bitops.h>
+#include <linux/dsa/8021q.h>
 #include <linux/interrupt.h>
 #include <linux/irqdomain.h>
 #include <linux/mii.h>
@@ -836,6 +837,7 @@ struct rtl8365mb_port {
  * struct rtl8365mb - driver private data
  * @priv: pointer to parent realtek_priv data
  * @irq: registered IRQ or zero
+ * @tag_proto: the tag protocol in use, see rtl8365mb_change_tag_protocol()
  * @chip_info: chip-specific info about the attached switch
  * @cpu: CPU tagging and CPU port configuration for this chip
  * @mib_lock: prevent concurrent reads of MIB counters
@@ -849,6 +851,14 @@ struct rtl8365mb_port {
 struct rtl8365mb {
 	struct realtek_priv *priv;
 	int irq;
+	enum dsa_tag_protocol tag_proto;
+	/* The PVID a port carries under the rtl8365mb-8021q tagger: its
+	 * tag_8021q VLAN (standalone, or the VLAN of a VLAN-unaware bridge)
+	 * or, while it sits in a VLAN-aware bridge, that bridge's. One
+	 * register holds it, rtl8365mb_commit_pvid() picks.
+	 */
+	u16 tag_8021q_pvid[RTL8365MB_MAX_NUM_PORTS];
+	u16 bridge_pvid[RTL8365MB_MAX_NUM_PORTS];
 	const struct rtl8365mb_chip_info *chip_info;
 	struct rtl8365mb_cpu cpu;
 	struct mutex mib_lock;
@@ -1874,6 +1884,94 @@ static void rtl8365mb_port_stp_state_set
 			   val << RTL8365MB_MSTI_CTRL_PORT_STATE_OFFSET(port));
 }
 
+/* The rtl8365mb-8021q tagger: the switch talks to the CPU port in plain
+ * 802.1Q. A standalone port carries its tag_8021q VID as PVID, the ports
+ * of a bridge share the bridge's VID, and the CPU port is a tagged member
+ * of all of them. The CPU tag is off, so the conduit sees VLAN frames and
+ * nothing else.
+ */
+static bool rtl8365mb_is_8021q(struct realtek_priv *priv)
+{
+	struct rtl8365mb *mb = priv->chip_data;
+
+	return mb->tag_proto == DSA_TAG_PROTO_RTL8365MB_8021Q;
+}
+
+/* Under the tagger a port has two candidate PVIDs: its tag_8021q VLAN,
+ * and the PVID of the VLAN-aware bridge it may sit in. The register holds
+ * one; @vlan_aware says which applies - the caller knows the state being
+ * set, dp->vlan_filtering may still hold the old one.
+ */
+static int rtl8365mb_commit_pvid(struct dsa_switch *ds, int port,
+				 bool vlan_aware)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = priv->chip_data;
+	u16 pvid;
+	int ret;
+
+	pvid = vlan_aware ? mb->bridge_pvid[port] : mb->tag_8021q_pvid[port];
+
+	/* No PVID yet (a bridge's VLANs come after vlan_filtering): the
+	 * register keeps what it has until one arrives.
+	 */
+	if (!pvid)
+		return 0;
+
+	mutex_lock(&priv->vlan_lock);
+	ret = rtl8365mb_vlan_pvid_port_set(ds, port, pvid, NULL);
+	mutex_unlock(&priv->vlan_lock);
+
+	return ret;
+}
+
+/* Is this VID a VLAN of a VLAN-aware bridge that @port is not in? The
+ * tagger picks the bridge by the VID alone, so one VID cannot serve two.
+ */
+static bool rtl8365mb_vlan_in_other_bridge(struct dsa_switch *ds, int port,
+					   u16 vid)
+{
+	struct dsa_port *dp = dsa_to_port(ds, port), *other;
+	struct bridge_vlan_info vinfo;
+	bool found = false;
+
+	rcu_read_lock();
+	dsa_switch_for_each_user_port(other, ds) {
+		if (!other->bridge || !other->user ||
+		    dsa_port_bridge_same(dp, other))
+			continue;
+		if (!br_vlan_get_info_rcu(other->user, vid, &vinfo)) {
+			found = true;
+			break;
+		}
+	}
+	rcu_read_unlock();
+
+	return found;
+}
+
+/* An 802.1Q upper of a port is delivered by its VID, so the VID must not
+ * belong to a VLAN-aware bridge on another port. The core only checks the
+ * bridge this port is in.
+ */
+static int rtl8365mb_port_prechangeupper(struct dsa_switch *ds, int port,
+					 struct netdev_notifier_changeupper_info *info)
+{
+	struct net_device *upper = info->upper_dev;
+
+	if (!rtl8365mb_is_8021q(ds->priv) || !info->linking ||
+	    !is_vlan_dev(upper))
+		return 0;
+
+	if (rtl8365mb_vlan_in_other_bridge(ds, port, vlan_dev_vlan_id(upper))) {
+		NL_SET_ERR_MSG_MOD(info->info.extack,
+				   "VID is a VLAN of a VLAN-aware bridge on another port");
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
 static int rtl8365mb_port_set_transparent(struct realtek_priv *priv,
 					  int igr_port, int egr_port,
 					  bool enable)
@@ -1934,6 +2032,19 @@ static int rtl8365mb_port_vlan_filtering
 	dev_dbg(priv->dev, "port %d: %s VLAN filtering\n", port,
 		vlan_filtering ? "enable" : "disable");
 
+	/* With the rtl8365mb-8021q tagger the VLAN setup is the tagger's:
+	 * membership decides, the untag masks strip on the way out, and
+	 * the transparent mode that a VLAN-unaware port normally gets would
+	 * let frames out of the CPU port untagged - nothing of that
+	 * changes here. What a VLAN-aware bridge changes is whose PVID the
+	 * port carries. Its VLANs go into the table through
+	 * rtl8365mb_port_vlan_add() like the tagger's own, and the tagger
+	 * delivers a frame in one of them to the bridge by the VID
+	 * (tag_rtl8365mb_8021q.c).
+	 */
+	if (rtl8365mb_is_8021q(priv))
+		return rtl8365mb_commit_pvid(ds, port, vlan_filtering);
+
 	ret = rtl8365mb_vlan_port_get_framefilter(priv, port,
 						  &prev_accepted_frame);
 	if (ret) {
@@ -2029,14 +2140,57 @@ undo_transparent:
 	return ret;
 }
 
+/* The 802.1Q upper of @dev with this VID, looking at @dev's own uppers
+ * only: __vlan_find_dev_deep_rcu() climbs from a port that has no VLAN
+ * state of its own to its bridge, and would answer with the bridge's L3
+ * VLAN interface (br-lan.10) for every port of a VLAN-aware bridge.
+ */
+static struct net_device *rtl8365mb_vlan_upper_of(struct net_device *dev, u16 vid)
+{
+	struct net_device *upper;
+	struct list_head *iter;
+
+	netdev_for_each_upper_dev_rcu(dev, upper, iter) {
+		if (is_vlan_dev(upper) &&
+		    vlan_dev_vlan_proto(upper) == htons(ETH_P_8021Q) &&
+		    vlan_dev_vlan_id(upper) == vid)
+			return upper;
+	}
+
+	return NULL;
+}
+
+/* Does another user port already have an 802.1Q upper with this VID? */
+static bool rtl8365mb_vlan_upper_elsewhere(struct dsa_switch *ds, int port,
+					   u16 vid)
+{
+	struct dsa_port *dp;
+	bool found = false;
+
+	rcu_read_lock();
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (dp->index == port || !dp->user)
+			continue;
+		if (rtl8365mb_vlan_upper_of(dp->user, vid)) {
+			found = true;
+			break;
+		}
+	}
+	rcu_read_unlock();
+
+	return found;
+}
+
 static int rtl8365mb_port_vlan_add(struct dsa_switch *ds, int port,
 				   const struct switchdev_obj_port_vlan *vlan,
 				   struct netlink_ext_ack *extack)
 {
 	bool untagged = !!(vlan->flags & BRIDGE_VLAN_INFO_UNTAGGED);
 	bool pvid = !!(vlan->flags & BRIDGE_VLAN_INFO_PVID);
+	struct switchdev_obj_port_vlan cpu_vlan;
 	u16 pvid_vid;
 	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = priv->chip_data;
 	int ret;
 
 	dev_dbg(priv->dev, "add VLAN %d on port %d, %s, %s\n",
@@ -2050,6 +2204,58 @@ static int rtl8365mb_port_vlan_add(struc
 		return -EOPNOTSUPP;
 	}
 
+	if (rtl8365mb_is_8021q(priv)) {
+		if (vid_is_dsa_8021q(vlan->vid)) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "Range 3072-4095 reserved for dsa_8021q operation");
+			return -EBUSY;
+		}
+
+		if (dsa_is_cpu_port(ds, port)) {
+			/* The CPU port is a tagged member of every VLAN the
+			 * user ports carry - the tagger reads the VID - and
+			 * has no PVID of its own. A VLAN-unaware bridge's
+			 * replay (VID 1) lands here too and carries nothing.
+			 */
+			cpu_vlan = *vlan;
+			cpu_vlan.flags &= ~(BRIDGE_VLAN_INFO_PVID |
+					    BRIDGE_VLAN_INFO_UNTAGGED);
+			vlan = &cpu_vlan;
+			untagged = false;
+			pvid = false;
+		} else if (!dsa_port_is_vlan_filtering(dsa_to_port(ds, port))) {
+			/* On a VLAN-unaware port the bridge's PVID and untagged
+			 * replays are none of the switch's business - the
+			 * tag_8021q VIDs do the port separation. What is left
+			 * is the VLAN of an 802.1Q upper of the port (wan.35):
+			 * the port and the CPU port become tagged members, and
+			 * the tagger carries that tag as it is. One such VLAN
+			 * belongs to one port only, or the receive side could
+			 * not tell whose upper it is.
+			 */
+			if (pvid || untagged)
+				return 0;
+			if (rtl8365mb_vlan_upper_elsewhere(ds, port, vlan->vid)) {
+				NL_SET_ERR_MSG_MOD(extack,
+						   "VID is already an 802.1Q upper of another port");
+				return -EBUSY;
+			}
+		} else if (rtl8365mb_vlan_upper_elsewhere(ds, port, vlan->vid)) {
+			/* A VLAN-aware bridge's VLANs go in as they are, PVID
+			 * and untagged included; the tagger delivers by the
+			 * VID, so the VID may span the bridge's ports but not
+			 * reach beyond the bridge.
+			 */
+			NL_SET_ERR_MSG_MOD(extack,
+					   "VID is already an 802.1Q upper of another port");
+			return -EBUSY;
+		} else if (rtl8365mb_vlan_in_other_bridge(ds, port, vlan->vid)) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "VID is already a VLAN of another VLAN-aware bridge");
+			return -EBUSY;
+		}
+	}
+
 	mutex_lock(&priv->vlan_lock);
 
 	ret = rtl8365mb_vlan_port_get_pvid(priv, port, &pvid_vid);
@@ -2074,6 +2280,12 @@ static int rtl8365mb_port_vlan_add(struc
 	if (ret)
 		goto undo_set_pvid;
 
+	/* The PVID of a VLAN-aware bridge: remembered next to the
+	 * tag_8021q one, so vlan_filtering can switch between them.
+	 */
+	if (pvid && rtl8365mb_is_8021q(priv))
+		mb->bridge_pvid[port] = vlan->vid;
+
 	ret = 0;
 	goto out_unlock;
 
@@ -2108,6 +2320,24 @@ static int rtl8365mb_port_vlan_del(struc
 	if (vlan->vid == 0)
 		return -EOPNOTSUPP;
 
+	/* See rtl8365mb_port_vlan_add(): nothing was installed for the
+	 * tag_8021q range, nor for a VLAN-unaware bridge's VLANs
+	 * (PVID/untagged) on a user port. The rest was and goes; a
+	 * VLAN-aware bridge's PVID is forgotten here.
+	 */
+	if (rtl8365mb_is_8021q(priv)) {
+		struct rtl8365mb *mb = priv->chip_data;
+
+		if (vid_is_dsa_8021q(vlan->vid))
+			return 0;
+		if (dsa_is_user_port(ds, port) &&
+		    !dsa_port_is_vlan_filtering(dsa_to_port(ds, port)) &&
+		    (vlan->flags & (BRIDGE_VLAN_INFO_PVID | BRIDGE_VLAN_INFO_UNTAGGED)))
+			return 0;
+		if (mb->bridge_pvid[port] == vlan->vid)
+			mb->bridge_pvid[port] = 0;
+	}
+
 	mutex_lock(&priv->vlan_lock);
 	ret = rtl8365mb_vlan_pvid_port_clear(ds, port, vlan->vid);
 	if (ret)
@@ -2917,15 +3147,271 @@ static int rtl8365mb_cpu_config(struct r
 	return 0;
 }
 
+/* The tag_8021q framework hands out the VIDs (3072 + port for a standalone
+ * port, 3088 + n for bridge n): PVID and untagged on the user port, tagged
+ * on the CPU port. Same hardware path as a bridge VLAN, without the
+ * 8021q-mode checks of rtl8365mb_port_vlan_add().
+ */
+static int rtl8365mb_tag_8021q_vlan_add(struct dsa_switch *ds, int port,
+					u16 vid, u16 flags)
+{
+	struct switchdev_obj_port_vlan vlan = {
+		.vid = vid,
+		.flags = flags,
+	};
+	struct realtek_priv *priv = ds->priv;
+	int ret;
+
+	mutex_lock(&priv->vlan_lock);
+	if (flags & BRIDGE_VLAN_INFO_PVID) {
+		struct rtl8365mb *mb = priv->chip_data;
+		struct dsa_port *dp = dsa_to_port(ds, port);
+
+		/* Remembered for rtl8365mb_commit_pvid(); written now unless
+		 * the port sits in a VLAN-aware bridge, whose PVID it keeps.
+		 */
+		mb->tag_8021q_pvid[port] = vid;
+		if (dp->bridge && dsa_port_is_vlan_filtering(dp))
+			ret = 0;
+		else
+			ret = rtl8365mb_vlan_pvid_port_set(ds, port, vid, NULL);
+	} else {
+		ret = rtl8365mb_vlan_pvid_port_clear(ds, port, vid);
+	}
+	if (!ret)
+		ret = rtl8365mb_vlan_4k_port_add(ds, port, &vlan, NULL);
+	mutex_unlock(&priv->vlan_lock);
+
+	if (ret)
+		dev_err(priv->dev,
+			"Failed to add tag_8021q VLAN %d to port %d (%d)\n",
+			vid, port, ret);
+
+	return ret;
+}
+
+static int rtl8365mb_tag_8021q_vlan_del(struct dsa_switch *ds, int port,
+					u16 vid)
+{
+	struct switchdev_obj_port_vlan vlan = {
+		.vid = vid,
+	};
+	struct realtek_priv *priv = ds->priv;
+	int ret;
+
+	mutex_lock(&priv->vlan_lock);
+	ret = rtl8365mb_vlan_pvid_port_clear(ds, port, vid);
+	if (!ret)
+		ret = rtl8365mb_vlan_4k_port_del(ds, port, &vlan);
+	mutex_unlock(&priv->vlan_lock);
+
+	if (ret)
+		dev_err(priv->dev,
+			"Failed to delete tag_8021q VLAN %d from port %d (%d)\n",
+			vid, port, ret);
+
+	return ret;
+}
+
+/* In 8021q mode the user ports advertise NETIF_F_HW_VLAN_CTAG_FILTER, which
+ * is what makes the core ask for the VLAN of an 802.1Q upper (wan.35)
+ * through port_vlan_add. The core sets the feature on its own only for a
+ * switch that needs standalone VLAN filtering, and clears it when a port
+ * leaves a VLAN-aware bridge.
+ */
+static void rtl8365mb_user_vlan_filter_feature(struct dsa_switch *ds, bool on)
+{
+	struct dsa_port *dp;
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (!dp->user)
+			continue;
+		if (on)
+			dp->user->features |= NETIF_F_HW_VLAN_CTAG_FILTER;
+		else
+			dp->user->features &= ~NETIF_F_HW_VLAN_CTAG_FILTER;
+	}
+}
+
+static int rtl8365mb_port_enable(struct dsa_switch *ds, int port,
+				 struct phy_device *phy)
+{
+	struct dsa_port *dp = dsa_to_port(ds, port);
+	struct realtek_priv *priv = ds->priv;
+
+	if (rtl8365mb_is_8021q(priv) && dsa_port_is_user(dp) && dp->user)
+		dp->user->features |= NETIF_F_HW_VLAN_CTAG_FILTER;
+
+	return 0;
+}
+
+/* The VLAN engine for the two modes. A VLAN-unaware port normally runs
+ * transparent to every other port with the egress tag state left as
+ * received (rtl8365mb_port_vlan_filtering): in 8021q mode that would put
+ * an untagged frame on the CPU port. So there the VLAN 4K membership
+ * decides where a frame may go and the entry's untag mask decides whether
+ * the tag stays on - the CPU port is never in an untag mask, the user
+ * ports are in their own. Ingress stays accept-all: an untagged frame
+ * takes the port's PVID, a tagged one keeps its VID and membership sorts
+ * it out on the way out.
+ */
+static int rtl8365mb_set_8021q_vlan_mode(struct dsa_switch *ds, bool on)
+{
+	struct realtek_priv *priv = ds->priv;
+	struct dsa_port *dp, *egr;
+	int ret;
+
+	dsa_switch_for_each_available_port(dp, ds) {
+		if (!on) {
+			ret = rtl8365mb_port_vlan_filtering(ds, dp->index,
+							    dsa_port_is_vlan_filtering(dp),
+							    NULL);
+			if (ret)
+				return ret;
+			continue;
+		}
+
+		dsa_switch_for_each_available_port(egr, ds) {
+			ret = rtl8365mb_port_set_transparent(priv, dp->index,
+							     egr->index, false);
+			if (ret)
+				return ret;
+		}
+
+		ret = rtl8365mb_port_set_vlan_egress_mode(priv, dp->index,
+							  RTL8365MB_VLAN_EGRESS_MODE_ORIGINAL);
+		if (ret)
+			return ret;
+
+		/* A tagged frame in a VLAN the port is not a member of is
+		 * dropped at the port: without this any port could inject
+		 * into an upper's or a VLAN-aware bridge's VLAN. An untagged
+		 * frame takes the PVID, of which the port is a member.
+		 */
+		ret = rtl8365mb_port_set_ingress_filtering(priv, dp->index,
+							   true);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* A bridge that is not VLAN-aware hands its FDB and MDB entries over with
+ * VID 0; the switch learns with IVL in the tag_8021q VID the bridge's
+ * frames are classified into, and that is where the static entries have
+ * to go for the lookups to meet them.
+ */
+static u16 rtl8365mb_db_vid(struct realtek_priv *priv, struct dsa_db db,
+			    u16 vid)
+{
+	if (vid || !rtl8365mb_is_8021q(priv))
+		return vid;
+
+	switch (db.type) {
+	case DSA_DB_BRIDGE:
+		return dsa_tag_8021q_bridge_vid(db.bridge.num);
+	case DSA_DB_PORT:
+		return dsa_tag_8021q_standalone_vid(db.dp);
+	default:
+		return vid;
+	}
+}
+
+static int rtl8365mb_port_fdb_add(struct dsa_switch *ds, int port,
+				  const unsigned char *addr, u16 vid,
+				  struct dsa_db db)
+{
+	return rtl83xx_port_fdb_add(ds, port, addr,
+				    rtl8365mb_db_vid(ds->priv, db, vid), db);
+}
+
+static int rtl8365mb_port_fdb_del(struct dsa_switch *ds, int port,
+				  const unsigned char *addr, u16 vid,
+				  struct dsa_db db)
+{
+	return rtl83xx_port_fdb_del(ds, port, addr,
+				    rtl8365mb_db_vid(ds->priv, db, vid), db);
+}
+
+static int rtl8365mb_port_mdb_add(struct dsa_switch *ds, int port,
+				  const struct switchdev_obj_port_mdb *mdb,
+				  struct dsa_db db)
+{
+	struct switchdev_obj_port_mdb m = *mdb;
+
+	m.vid = rtl8365mb_db_vid(ds->priv, db, mdb->vid);
+
+	return rtl83xx_port_mdb_add(ds, port, &m, db);
+}
+
+static int rtl8365mb_port_mdb_del(struct dsa_switch *ds, int port,
+				  const struct switchdev_obj_port_mdb *mdb,
+				  struct dsa_db db)
+{
+	struct switchdev_obj_port_mdb m = *mdb;
+
+	m.vid = rtl8365mb_db_vid(ds->priv, db, mdb->vid);
+
+	return rtl83xx_port_mdb_del(ds, port, &m, db);
+}
+
+static int rtl8365mb_port_bridge_join(struct dsa_switch *ds, int port,
+				      struct dsa_bridge bridge,
