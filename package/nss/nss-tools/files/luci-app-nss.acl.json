{
	"luci-app-nss": {
		"description": "Grant access to the NSS offload status page",
		"read": {
			"file": {
				"/usr/sbin/nss-status -j": [ "exec" ],
				"/sys/kernel/debug/qca-nss-drv/stats/cpu_load_ubi": [ "read" ],
				"/sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count": [ "read" ],
				"/sys/kernel/debug/ecm/ecm_nss_ipv6/accelerated_count": [ "read" ],
				"/sys/class/thermal": [ "list" ],
				"/sys/class/thermal/*": [ "read" ],
				"/sys/devices/virtual/thermal/*": [ "read" ]
			}
		}
	}
}
