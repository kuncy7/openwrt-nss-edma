#!/bin/sh
# TP-Link Archer AX55 v1 test image - bring the Wi-Fi up as a WPA2 AP.
#
# This runs from the ieee80211 hotplug (ACTION=add) which fires when ath11k
# finishes loading its firmware and registers each PHY (~14s into boot) - i.e.
# AFTER 10-wifi-detect has run "wifi config" to generate /etc/config/wireless.
# Doing this from a uci-defaults script instead would run too early (~10s),
# before the radios exist, and leave the Wi-Fi unconfigured.

[ "${ACTION}" = "add" ] || exit 0
[ -f /etc/config/wireless ] || exit 0

WIFI_SSID="OpenWrt-AX55"
WIFI_KEY="ax55test"
WIFI_COUNTRY="PL"

. /lib/functions.sh
. /lib/functions/system.sh
config_load wireless

# factory MACs for the radios: base+2 (2.4 GHz/phy0), base+3 (5 GHz/phy1)
BASE_MAC="$(/lib/read-ax55-mac 2>/dev/null)"

enable_device() {
	uci -q set wireless."$1".disabled='0'
	uci -q set wireless."$1".country="$WIFI_COUNTRY"
}

setup_iface() {
	local dev off
	uci -q set wireless."$1".disabled='0'
	uci -q set wireless."$1".mode='ap'
	# factory MAC for the AP: base+2 (radio0/2.4G), base+3 (radio1/5G).
	# NB: this must be set on the wifi-iface - the wifi-device "macaddr"
	# option is a radio-identification key in mac80211, not a setter.
	if [ -n "$BASE_MAC" ]; then
		dev=$(uci -q get wireless."$1".device)
		case "$dev" in
		*0) off=2 ;;
		*1) off=3 ;;
		*) off="" ;;
		esac
		[ -n "$off" ] && \
			uci -q set wireless."$1".macaddr="$(macaddr_add "$BASE_MAC" $off)"
	fi
	uci -q set wireless."$1".network='lan'
	uci -q set wireless."$1".encryption='psk2'
	uci -q set wireless."$1".key="$WIFI_KEY"
	uci -q set wireless."$1".ssid="$WIFI_SSID"
}

config_foreach enable_device wifi-device
config_foreach setup_iface wifi-iface
uci -q commit wireless

wifi up
