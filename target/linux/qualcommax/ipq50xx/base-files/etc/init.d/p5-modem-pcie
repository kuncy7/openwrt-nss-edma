#!/bin/sh /etc/rc.common

START=20
USE_PROCD=1

extra_command "scan" "Wait briefly for the P5 modem PCIe link"

start_service() {
	[ "$(board_name)" = "cudy,p5-ubootmod" ] || return 0

	procd_open_instance
	procd_set_param command /etc/init.d/p5-modem-pcie scan
	procd_close_instance
}

scan() {
	[ "$(board_name)" = "cudy,p5-ubootmod" ] || return 0

	local rootport="/sys/bus/pci/devices/0001:00:00.0"
	local endpoint="$rootport/0001:01:00.0"
	local retries=30 width

	# The modem can train its link after Linux's initial PCIe scan.
	while [ "$retries" -gt 0 ]; do
		[ -e "$endpoint" ] && return 0
		if read -r width 2>/dev/null < "$rootport/current_link_width" &&
		   [ "$width" -gt 0 ] 2>/dev/null &&
		   [ -w "$rootport/rescan" ]; then
			echo 1 > "$rootport/rescan"
			if [ -e "$endpoint" ]; then
				logger -t p5-modem-pcie "Modem PCIe endpoint found after boot scan"
				return 0
			fi
		fi
		retries=$((retries - 1))
		sleep 2
	done

	logger -t p5-modem-pcie "Modem PCIe endpoint did not appear within 60 seconds"
}
