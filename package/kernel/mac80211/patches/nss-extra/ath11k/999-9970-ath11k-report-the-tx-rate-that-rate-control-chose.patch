 void ath11k_debugfs_sta_update_txcompl(struct ath11k *ar,
@@ -28,6 +29,7 @@ void ath11k_debugfs_sta_update_txcompl(s
 
 static inline void
 ath11k_debugfs_sta_add_tx_stats(struct ath11k_sta *arsta,
