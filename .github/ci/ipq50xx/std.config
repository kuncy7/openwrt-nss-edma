# Group "std": boards with 512 MB or 1 GB of RAM. ath11k host profile 1G + NSS MEDIUM, as on the
# validated images. A multi-device image shares one profile, so it is chosen here explicitly
# (README.ipq50xx.md, "Memory profiles").
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_cmcc_mr3000d-ci=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_cmcc_pz-l8=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_elecom_wrc-x3000gs2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_elecom_wrc-x3000gst2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_glinet_gl-b3000=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_iodata_wn-dax3000gr=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_linksys_mr5500=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_linksys_mx2000=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_linksys_mx5500=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_linksys_mx6200=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_linksys_spnmx56=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_tplink_archer-ax55-v1=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_ax6000=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax5400=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_yuncore_ax830=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_yuncore_ax850=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_zyxel_scr50axe=y
