# Pick the topology for the ipq50xx NSS plane. A DSA switch with a tag_8021q
# tagger (qca8k, rtl8365mb) means C-3PO
# (topology 'dsa': the driver and the ports stay, nothing below applies).
# Otherwise migrate the network config from the DSA ports to the VLAN-trunk
# topology: the switch fabric splits the front ports into VLANs (VTU
# programmed by qca8337-nss), the eth0 trunk carries them tagged, and
# netifd builds eth0.1 (lan) / eth0.2 (wan) on top. The same topology
# serves both data paths, so this migration is one-way and guarded by a
# marker - rerunning the script (or a sysupgrade that keeps settings)
# changes nothing.
#
# The per-board table and the board_name keying are George Moussalem's
# (https://gist.github.com/georgemoussalem/89a1a99d8516855d54533329d391b2ac),
# folded in with permission.
#
# Adding a board: read its switch node in the DTS. cpu_port is the port
# holding the 'ethernet' phandle; ports is the bitmask of every port in
# the node; wake_phys lists the front PHYs on the SoC's MDIO bus; vtu
# puts the CPU port tagged in both VLANs, the lan* ports untagged in 1
# and wan untagged in 2. If the CPU link enters the switch through one of
# the switch's own PHYs instead of an SGMII MAC port, use cpu_port=255
# ("no forced port") and list that PHY in wake_phys too - it has to
# autonegotiate like a front port. switch_dev names the switch's own MDIO
# device when it does not sit at the usual address 17 (90000.mdio-1:11).
#
# Two GMACs: trunk_if is the GMAC index of the trunk (default 1; 0 where the
# switch hangs off GMAC0), extra_ports lists any other GMAC in use as
# '<if>:<netdev>' (a WAN PHY on the other GMAC), and fw_mask says which of
# them the firmware gets - bit N = GMAC N. fabric='none' on a board with no
# switch at all. Entries marked UNTESTED come straight from the DTS in
# openwrt main and have not run on the board: the first report decides.

. /lib/functions.sh

nss_dwmac_board_defaults() {
	case "$1" in
	glinet,gl-b3000)
		# port 0 = CPU (SGMII), 1 = wan, 2-3 = lan
		fw_mask='0x2'
		trunk='eth0'
		switch_args=''
		vtu='1:0t,2u,3u;2:0t,1u'
		;;
	linksys,mx2000|\
	linksys,mx5500)
		# port 6 = CPU (SGMII), 2 = wan, 3-5 = lan
		fw_mask='0x2'
		trunk='eth0'
		switch_args='cpu_port=6 ports=0x7c wake_phys=90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03,90000.mdio-1:04'
		vtu='1:6t,3u,4u,5u;2:6t,2u'
		;;
	linksys,mr5500)
		# port 6 = CPU (SGMII), 5 = wan, 1-4 = lan
		# needs openwrt/openwrt#24927 for the mdio-1 PHY names
		fw_mask='0x2'
		trunk='eth0'
		switch_args='cpu_port=6 ports=0x7e wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03,90000.mdio-1:04'
		vtu='1:6t,1u,2u,3u,4u;2:6t,5u'
		;;
	xunison,exigo-hub-d50-5g)
		# WAN is GMAC0's own GE PHY (netdev 'wan'), so GMAC1 - the switch
		# trunk - comes up as eth1 and carries LAN only: port 0 = CPU
		# (SGMII), 1-3 = lan. No VTU: one untagged LAN, br-lan on eth1.
		# Both GMACs are armed: 0x3 hands the ethernet WAN over as
		# phys_if 0 as well, so routed LAN<->WAN over that PHY is
		# accelerated. Measured on LS3434's board 2026-09-09: with
		# 0x2 the WAN side sat on the host, ECM created no rule at all
		# (empty '#ipv4 special stats', every packet excepted) and the
		# CPU ran at 90-100%; with 0x3, 98% hash hits and 4% CPU.
		# A board that uses the 5G modem instead just leaves phys_if 0
		# armed with the link down, which costs nothing.
		fw_mask='0x3'
		trunk='eth1'
		trunk_if='1'
		extra_ports='0:wan'
		wan_on_trunk=0
		switch_args=''
		vtu=''
		;;
	linksys,spnmx56)
		# Confirmed on LS3434's board 2026-09-09 - the first board to
		# arm two GMACs, and the entry below was right as written from
		# the DTS alone (both ports started, 98% hash hits, 4% CPU).
		# The switch hangs off GMAC0 through the switch's own
		# PHY 4 (port 5 = CPU, PHY-to-PHY gmii), so the trunk is eth0
		# and phys_if 0; ports 2-4 = lan3/lan2/lan1 (PHY 1-3). WAN is a
		# QCA8081 2.5G PHY on GMAC1, netdev 'wan' = phys_if 1. No VTU:
		# the switch carries LAN only.
		fw_mask='0x3'
		trunk='eth0'
		trunk_if='0'
		extra_ports='1:wan'
		wan_on_trunk=0
		switch_args='cpu_port=255 ports=0x3c wake_phys=90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03,90000.mdio-1:04'
		vtu=''
		;;
	linksys,mx6200)
		# Confirmed on LS3434's board 2026-09-10. No switch: GMAC0 is the
		# LAN PHY (netdev 'lan'), GMAC1 a GPY115C on SGMII (netdev 'wan').
		# Two plain ports, both handed to the firmware; br-lan sits on 'lan'.
		fw_mask='0x3'
		trunk='lan'
		trunk_if='0'
		extra_ports='1:wan'
		wan_on_trunk=0
		fabric='none'
		switch_args=''
		vtu=''
		;;
	xiaomi,redmi-ax5400)
		# Run on the board (Yongzhao, PR #1, 2026-09-14), both CPU links in
		# use: LAN rides port 6 -> GMAC1 (SGMII), the trunk eth1 = phys_if 1,
		# 2-4 = lan1-3; WAN rides port 5 -> PHY 4 -> GMAC0 (PHY-to-PHY), as
		# VLAN 2 on eth0 = phys_if 0, 1 = wan. Clean 4138fb5e87 build: both
		# ports started, WAN download through eth0.2; on his build with
		# local qca8337-nss checks, Ookla 914/856 wired. PHY 4 has to be
		# woken for GMAC0's link. Wi-Fi stays on the host, as in every run
		# on this board so far.
		fw_mask='0x3'
		trunk='eth1'
		trunk_if='1'
		wan_trunk='eth0'
		extra_ports='0:eth0'
		wifi_offload='0'
		switch_args='cpu_port=6 ports=0x7e wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03,90000.mdio-1:04'
		vtu='1:6t,2u,3u,4u;2:5t,1u'
		;;
	cudy,p5)
		# P5 uses both QCA8337 CPU links. LAN rides port 6 -> GMAC1
		# (SGMII), so eth1 = phys_if 1 carries VLAN 1 for ports 1-3.
		# WAN rides port 5 -> switch PHY 4 -> GMAC0, so eth0 = phys_if 0
		# carries VLAN 2 for external port 4. Wi-Fi uses the global NSS
		# offload default, matching the other validated 256 MB board.
		fw_mask='0x3'
		trunk='eth1'
		trunk_if='1'
		wan_trunk='eth0'
		extra_ports='0:eth0'
		switch_args='cpu_port=6 ports=0x7e wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03,90000.mdio-1:04'
		vtu='1:6t,1u,2u,3u;2:5t,4u'
		;;
	cmcc,pz-l8)
		# UNTESTED. The AX5400's two CPU ports, with the SGMII one on port
		# 0: port 0 -> GMAC1 (SGMII), port 5 -> GMAC0 (PHY-to-PHY). Trunk
		# = eth1 = phys_if 1, 4 = wan, 1-3 = lan3/lan2/lan1; port 5 is left
		# out of the fabric.
		fw_mask='0x2'
		trunk='eth1'
		trunk_if='1'
		switch_args='cpu_port=0 ports=0x1f wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03'
		vtu='1:0t,1u,2u,3u;2:0t,4u'
		;;
	cmcc,mr3000d-ci)
		# Run on the board (forum #313): the wired plane and 5 GHz Wi-Fi
		# offload come up on this entry unchanged. Port 6 = CPU (SGMII,
		# GMAC1), 4 = wan, 1-3 = lan3/lan2/lan1. GMAC0 is wired to the
		# switch's PHY 4 as well, but the DTS gives it no port, so it stays
		# out of the fabric - it still takes eth0, which makes the trunk eth1.
		fw_mask='0x2'
		trunk='eth1'
		trunk_if='1'
		switch_args='cpu_port=6 ports=0x5e wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03'
		vtu='1:6t,1u,2u,3u;2:6t,4u'
		;;
	zyxel,scr50axe|\
	iodata,wn-dax3000gr|\
	elecom,wrc-x3000gs2|\
	elecom,wrc-x3000gst2)
		# UNTESTED. The D50's layout with the CPU on port 6: GMAC0 is the
		# SoC's GE PHY as 'wan', GMAC1 the switch trunk on SGMII (eth1),
		# 1-4 = lan1-4. No VTU: the switch carries LAN only, and both GMACs
		# go to the firmware as on the D50. The I-O DATA and Elecom boards
		# put the switch at MDIO address 0x18.
		fw_mask='0x3'
		trunk='eth1'
		trunk_if='1'
		extra_ports='0:wan'
		wan_on_trunk=0
		[ "$1" = "zyxel,scr50axe" ] || switch_dev='90000.mdio-1:18'
		switch_args='cpu_port=6 ports=0x5e wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03'
		vtu=''
		;;
	xiaomi,ax6000)
		# UNTESTED. The SPNMX56's layout: the switch hangs off GMAC0
		# through the switch's own PHY 3 (port 4 = CPU, PHY-to-PHY gmii),
		# 1-3 = lan1-3 (PHY 0-2). WAN is a QCA8081 2.5G PHY on GMAC1,
		# netdev 'wan' = phys_if 1. No VTU: the switch carries LAN only.
		fw_mask='0x3'
		trunk='eth0'
		trunk_if='0'
		extra_ports='1:wan'
		wan_on_trunk=0
		switch_args='cpu_port=255 ports=0x1e wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03'
		vtu=''
		;;
	yuncore,ax830|\
	yuncore,ax850)
		# UNTESTED. The MX6200's layout: no switch, GMAC0 = 'lan' (GE
		# PHY), GMAC1 = 'wan' on a QCA8081 2.5G PHY.
		fw_mask='0x3'
		trunk='lan'
		trunk_if='0'
		extra_ports='1:wan'
		wan_on_trunk=0
		fabric='none'
		switch_args=''
		vtu=''
		;;
	tplink,ex511-v2)
		# RTL8367D (not a QCA8337) at MDIO addr 29 on mdio1, driven by the
		# rtl8365mb DSA driver. port 6 = CPU on gmac1 (SGMII 1G, eth0),
		# port 0 = wan, ports 1-4 = lan1-4.
		#
		# fabric='none': rtl8365mb stays bound and keeps the switch. The
		# CPU tag is turned off in the driver instead, via the DT property
		# realtek,headerless-cpu-port (DSA_TAG_PROTO_NONE + CPU_CTRL_EN=0),
		# so eth0 carries the plain 802.1Q the firmware parses. Leaving
		# this unset would insmod qca8337-nss against MDIO address 17 on
		# this bus and write whatever answers there.
		#
		# The unbind route that every QCA8337 board uses does NOT work
		# here: this switch's CPU port is a phylink-managed SGMII PCS, not
		# a forced-mode MAC, so unbinding the driver takes the link down
		# and the fabric goes quiet however correctly it is programmed.
		#
		# Flat dumb AP: one untagged domain, no VTU, wan is not a separate
		# VLAN - br-lan sits on the untagged trunk.
		fw_mask='0x2'
		trunk='eth0'
		trunk_if='1'
		wan_on_trunk=0
		fabric='none'
		switch_args=''
		vtu=''
		# With no tagger the DSA user ports cannot receive, so they are not
		# bridge members -- but they must still be brought up: dsa_port_disable
		# both stops phylink and writes BR_STATE_DISABLED into the switch, so a
		# down port is a dead port in the fabric, not just a dark PHY.
		keep_ports='wan lan1 lan2 lan3 lan4'
		;;
	*)
		return 1
		;;
	esac
}

[ -n "$(uci -q get nss.general.topology)" ] && exit 0

# C-3PO: a board whose switch is driven by qca8k or rtl8365mb gets the dsa
# topology - the tag_8021q tagger keeps the driver and the ports, and everything the
# trunk table below carries (VTU, cpu_port, ports, wake_phys, which GMAC
# is the trunk, fw_mask) is read off the board at every boot instead (see
# nss_dsa_* in /lib/nss/functions.sh, and nss-dwmac-probe). There is
# nothing to migrate: the network config stays on the DSA ports exactly
# as netifd generated it. The switch drivers have probed by now (qca8k is
# built in, rtl8365mb autoloads at 42), so their device lists are the whole
# test.
c3po_switch_bound() {
	local d
	for d in /sys/bus/mdio_bus/drivers/qca8k/*mdio* \
		 /sys/bus/mdio_bus/drivers/rtl8365mb-mdio/*mdio*; do
		[ -e "$d" ] && return 0
	done
	return 1
}
# Firmware memory mode 2 is what the QCN6122 on a GL-B3000 was measured to
# need for wifili, but it is not a condition for the offload as such: an
# AX6000 and an Archer AX55, both with mode 1 in their DTS, run the Wi-Fi
# datapath in the firmware at full rate. This used to gate wifi_offload and
# turned it off on the 13 of 17 IPQ5018 boards whose DTS says 1 - silently,
# for anyone moving from the trunk topology, where the default has always
# been on. It now only warns, and the mode is reported by nss-status.
wifi_fw_memory_mode_2() {
	local f
	for f in /sys/firmware/devicetree/base/soc*/wifi*/qcom,ath11k-fw-memory-mode; do
		[ -e "$f" ] || continue
		[ "$(hexdump -v -e '1/1 "%02x"' "$f")" = "00000002" ] || return 1
	done
	return 0
}
if c3po_switch_bound; then
	[ -x /etc/init.d/qca-nss-drv ] && /etc/init.d/qca-nss-drv disable
	[ -n "$(uci -q get nss.general.enabled)" ] || uci set nss.general.enabled='1'
	if [ -z "$(uci -q get nss.general.wifi_offload)" ]; then
		uci set nss.general.wifi_offload='1'
		wifi_fw_memory_mode_2 || logger -t nss "topology dsa: a radio asks for ath11k-fw-memory-mode 1 in the DTS; Wi-Fi offload is on anyway (measured working on mode 1) - set nss.general.wifi_offload=0 if a radio misbehaves"
	fi
	[ -n "$(uci -q get nss.general.fw_logbuf)" ] || uci set nss.general.fw_logbuf='256'
	# board.d may split the DSA ports across two CPU links: the Redmi AX5400
	# and the CMCC PZ-L8 put lan1-3 on eth1 and the WAN port on eth0. This
	# topology cannot keep that split. The plane arms one conduit and
	# qca-dsa-nss hangs a firmware VLAN interface off that conduit's
	# interface number, so a port on the other link is host-only; on the
	# AX5400 the odd link is also GMAC0 (PHY to PHY into port 5), whose RX
	# is dead in mainline too (openwrt#24696, worked around there by
	# dropping the same conduit assignments). Put every port that names a
	# conduit on the one that already carries most of them - the same link
	# nss_dsa_conduit() picks at boot. A tie is left alone: with one port on
	# each link there is nothing here to say which of them works.
	dsa_conduit_vote() {
		local c
		config_get c "$1" conduit
		[ -n "$c" ] && conduit_votes="$conduit_votes $c"
		return 0
	}
	dsa_conduit_move() {
		local name c
		config_get name "$1" name
		config_get c "$1" conduit
		[ -n "$c" ] && [ "$c" != "$main_conduit" ] || return 0
		uci set "network.$1.conduit=$main_conduit"
		logger -t nss "topology dsa: $name moves from conduit $c to $main_conduit - the plane arms one CPU link and only its ports reach the firmware"
	}
	conduit_votes=''
	main_conduit=''
	tied=0
	config_load network
	config_foreach dsa_conduit_vote device
	if [ -n "$conduit_votes" ]; then
		best=0
		total=0
		for c in $conduit_votes; do
			total=$((total + 1))
			n=0
			for d in $conduit_votes; do
				[ "$d" = "$c" ] && n=$((n + 1))
			done
			if [ "$n" -gt "$best" ]; then
				best=$n
				main_conduit="$c"
				tied=0
			elif [ "$n" = "$best" ] && [ "$c" != "$main_conduit" ]; then
				tied=1
			fi
		done
		if [ "$best" = "$total" ]; then
			main_conduit=''
		elif [ "$tied" = 1 ]; then
			logger -t nss "topology dsa: the DSA ports are split evenly between two CPU links - leaving the conduits alone, set them by hand if only one link works"
			main_conduit=''
		fi
	fi
	if [ -n "$main_conduit" ]; then
		config_load network
		config_foreach dsa_conduit_move device
	fi

	uci set nss.general.topology='dsa'
	uci commit nss
	logger -t nss "topology dsa: a tag_8021q-capable switch found, the ports stay with DSA and the wiring is read off the board"
	exit 0
fi

board="$(board_name)"
known_board=1
if ! nss_dwmac_board_defaults "$board"; then
	known_board=0
	logger -t nss "no NSS switch defaults for board '$board' - set nss.general.{vtu,switch_args} by hand (see README.ipq50xx.md)"
fi

# qca-nss-drv's own init does nothing but interrupt affinity and firmware
# RPS, from a table written for a quad-core ipq807x, at START=94 - before
# the plane is armed, so the interrupts it wants do not exist yet and the
# CPU 2/3 writes fail on this SoC. nss-irq-affinity does the same job from
# nss-dwmac-up, after the arm, so keep the driver's version out of the way.
[ -x /etc/init.d/qca-nss-drv ] && /etc/init.d/qca-nss-drv disable

# Defaults for the ipq50xx plane (the config file itself ships with
# qca-nss-drv; only fill what is not set).
[ -n "$(uci -q get nss.general.enabled)" ] || uci set nss.general.enabled='1'
# Wi-Fi offload on by default: it has run on the GL-B3000 and the MX2000. A
# board entry can still set wifi_offload='0' to keep its radios on the host.
[ -n "$(uci -q get nss.general.wifi_offload)" ] || uci set nss.general.wifi_offload="${wifi_offload:-1}"
[ -n "$(uci -q get nss.general.fw_logbuf)" ] || uci set nss.general.fw_logbuf='256'
[ -z "$(uci -q get nss.general.fw_mask)" ] && [ -n "$fw_mask" ] && uci set nss.general.fw_mask="$fw_mask"
# Do not touch a WAN that is already a VLAN on the trunk. Someone coming from
# another tree with a tagged ISP handover has network.wan.device set to
# eth0.<their vid>, and rewriting that to eth0.2 takes their link down -
# measured on an MX2000 whose ISP hands over tagged 35 (LS3434, forum #232).
wan_vid=2
cur_wan="$(uci -q get network.wan.device)"
if [ "$known_board" = 1 ] && [ "${wan_on_trunk:-1}" = 1 ]; then
	# wan_trunk: the netdev the wan VLAN rides - the trunk, unless the board
	# has a second link into the switch for it (Redmi AX5400: eth0).
	[ -n "$wan_trunk" ] || wan_trunk="$trunk"
	[ -n "$wan_trunk" ] || wan_trunk=eth0
	case "$cur_wan" in
	"$wan_trunk".*)
		vid="${cur_wan##*.}"
		case "$vid" in
		''|*[!0-9]*) ;;
		*) wan_vid="$vid" ;;
		esac
		;;
	esac
fi

# The board tables put the WAN on VLAN 2; if the admin's WAN device says a
# different vid, carry it into the VTU's wan block so both sides match. The
# block is the last one and starts with '2:', so only its vid changes - the
# port membership the board needs stays as it is.
if [ -n "$vtu" ] && [ "${wan_vid:-2}" != 2 ]; then
	case "$vtu" in
	*';2:'*) vtu="${vtu%;2:*};${wan_vid}:${vtu##*;2:}" ;;
	esac
fi

[ -z "$(uci -q get nss.general.vtu)" ] && [ -n "$vtu" ] && uci set nss.general.vtu="$vtu"
[ -z "$(uci -q get nss.general.switch_args)" ] && [ -n "$switch_args" ] && uci set nss.general.switch_args="$switch_args"
[ -z "$(uci -q get nss.general.switch_dev)" ] && [ -n "$switch_dev" ] && uci set nss.general.switch_dev="$switch_dev"
# The trunk netdev: eth0 where GMAC0 is disabled or is the trunk itself; eth1
# where GMAC0 takes a netdev of its own (a WAN PHY, or a second link into the
# switch); the PHY's name on a board with no switch.
[ -z "$(uci -q get nss.general.trunk)" ] && [ -n "$trunk" ] && uci set nss.general.trunk="$trunk"
[ -z "$(uci -q get nss.general.trunk_if)" ] && [ -n "$trunk_if" ] && uci set nss.general.trunk_if="$trunk_if"
[ -z "$(uci -q get nss.general.extra_ports)" ] && [ -n "$extra_ports" ] && uci set nss.general.extra_ports="$extra_ports"
[ -z "$(uci -q get nss.general.fabric)" ] && [ -n "$fabric" ] && uci set nss.general.fabric="$fabric"

# Rewrite the network only for a board this script actually knows. On an
# unknown board the trunk may not be the right topology at all - e.g. the
# Xunison Exigo D50 puts WAN on its own GE PHY and hangs only LAN ports off
# the switch, so there is no wan VLAN to move anything to, and forcing
# eth0.1/eth0.2 here left it with a WAN device that does not exist.
if [ "$known_board" = 1 ]; then
	[ -n "$trunk" ] || trunk=eth0
	if [ "${wan_on_trunk:-1}" = 1 ]; then
		# WAN shares the trunk: br-lan gets the lan VLAN, wan the wan VLAN.
		lan_port="$trunk.1"

		# wan_vid was worked out above: 2 unless the admin already has
		# the WAN on another VLAN of the trunk, in which case theirs is
		# kept and the VTU was rewritten to match.
		if [ "${wan_vid:-2}" = 2 ]; then
			[ -n "$(uci -q get network.wan)" ] && uci set network.wan.device="$wan_trunk.2"
			[ -n "$(uci -q get network.wan6)" ] && uci set network.wan6.device="$wan_trunk.2"
			# A device section for the old WAN netdev (a cloned MAC, an
			# MTU) moves with it. The DSA conduit such a section carries
			# on the AX5400 means nothing on a VLAN, so it goes.
			wan_device_follow() {
				local name
				config_get name "$1" name
				[ -n "$cur_wan" ] && [ "$name" = "$cur_wan" ] || return 0
				uci set "network.$1.name=$wan_trunk.2"
				uci -q delete "network.$1.conduit"
			}
			config_load network
			config_foreach wan_device_follow device
		else
			logger -t nss "keeping the existing WAN device $cur_wan (VLAN $wan_vid on the trunk); the default VTU is being rewritten to match, but tagged-vs-untagged on the WAN port is yours to set in nss.general.vtu"
		fi
		uci set nss.general.topology='vlan-trunk'
	else
		# LAN-only trunk: br-lan sits on the untagged trunk, wan is its
		# own netdev and stays whatever the board's defaults made it.
		lan_port="$trunk"
		uci set nss.general.topology='lan-trunk'
	fi

	# br-lan: replace the DSA user ports with the trunk (or its lan VLAN).
	lan_dev="$(uci -q get network.@device[0].name)"
	if [ "$lan_dev" = "br-lan" ]; then
		uci -q delete network.@device[0].ports
		uci add_list network.@device[0].ports="$lan_port"
	fi

	#
	# Boards whose switch keeps its DSA driver bound (fabric='none' with a
	# headerless CPU port) still have user port netdevs, and those ports are
	# no longer bridge members after the rewrite above. They must not be left
	# down: dsa_port_disable() stops phylink *and* writes BR_STATE_DISABLED
	# into the switch, so an admin-down port is dead in the fabric and no
	# frame ever reaches the trunk. Hold them up with an unconfigured
	# interface each - no proto, no address, just IFF_UP.
	#
	for _p in $keep_ports; do
		[ -n "$(uci -q get "network.port_$_p")" ] && continue
		uci set "network.port_$_p=interface"
		uci set "network.port_$_p.device=$_p"
		uci set "network.port_$_p.proto=none"
		uci set "network.port_$_p.auto=1"
	done
	#
	# A headerless DSA port can transmit but never receive (tag_none has
	# no .rcv), so the board's default wan/wan6 interfaces on it would
	# run DHCP forever: every DISCOVER leaves through the conduit and is
	# flooded to the LAN sockets, and wan never comes up. On such a board
	# the WAN socket is one more port of the flat LAN: wan keeps its
	# section with no protocol on it, wan6 goes. Only while they still sit
	# on the dead port - a wan someone has already moved onto a VLAN of
	# the trunk works, and is left alone.
	#
	case " $keep_ports " in
	*" wan "*)
		[ "$(uci -q get network.wan.device)" = wan ] && uci set network.wan.proto='none'
		[ "$(uci -q get network.wan6.device)" = wan ] && uci -q delete network.wan6
		;;
	esac
fi

uci commit

exit 0
