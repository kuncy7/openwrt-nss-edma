From: Andrei-Alexandru Bleortu <me@andrei-z.com>
Subject: [PATCH] ath11k: nss: use the current timer API for the mesh mpp
 expiry timer

from_timer() and del_timer_sync() are gone from the kernels this tree
targets (renamed to timer_container_of() in 6.16, timer_delete_sync()
in 6.15), so ath11k does not build once ATH11K_NSS_MESH_SUPPORT is on.

Signed-off-by: Andrei-Alexandru Bleortu <me@andrei-z.com>

--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -1980,7 +1980,7 @@ int ath11k_nss_dump_mpp_request(struct ath11k_vif *arvif)
 static void ath11k_nss_mpp_timer_cb(struct timer_list *timer)
 {
 	nss_wifi_mesh_msg_callback_t msg_cb;
-	struct arvif_nss *nss = from_timer(nss, timer,mpp_expiry_timer);
+	struct arvif_nss *nss = timer_container_of(nss, timer, mpp_expiry_timer);
 	struct ath11k_vif *arvif = container_of(nss, struct ath11k_vif, nss);
 	struct ath11k_base *ab = arvif->ar->ab;
 	LIST_HEAD(local_entry);
@@ -2604,7 +2604,7 @@ static void ath11k_nss_mesh_vdev_free(struct ath11k_vif *arvif)
 	LIST_HEAD(mpp_local_entry);
 	nss_tx_status_t status;
 
-	del_timer_sync(&nss->mpp_expiry_timer);
+	timer_delete_sync(&nss->mpp_expiry_timer);
 
 	spin_lock_bh(&ar->nss.dump_lock);
 	list_splice_tail_init(&nss->mpath_dump, &mpath_local_entry);
