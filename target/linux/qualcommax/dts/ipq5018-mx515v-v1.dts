/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-nss.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "TP-Link MX515v v1";
	compatible = "tplink,mx515v-v1", "qcom,ipq5018";

	aliases {
		/*
		 * No label-mac-device: this board has no MAC in the device tree at
		 * all. 0:ART carries none, so it comes from the misc_ro UBIFS volume
		 * at runtime (mounted read-only by lib/preinit/09_mount_tp_data), see
		 * board.d/02_network, which also publishes the label address into
		 * board.json.
		 */
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;

		serial0 = &blsp1_uart1;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	/* No gpio_fan node: MX515v has no fan (NX510v-only component). */

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		button-wps {
			label = "wps";
			gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_power: led-power {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 38 GPIO_ACTIVE_HIGH>;
		};

		led-wlan {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "network";
			mode = "link";
		};

		led-internet {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
		};

		led-internet-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
		};

		led-internet-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
		};

		led-internet-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};

		led-signal-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_MOBILE;
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};

		led-signal-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_MOBILE;
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
		};

		led-signal-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_MOBILE;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};

		led-telephone {
			color = <LED_COLOR_ID_WHITE>;
			label = "telephone";
			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		};

	};

	gpio_export {
		compatible = "gpio-export";

		modem-power {
			gpio-export,name = "modempwr";
			gpio-export,output = <0>;
			gpios = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		};

		modem-reset {
			gpio-export,name = "modemrst";
			gpio-export,output = <0>;
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
		};

		modem-pwrkey {
			gpio-export,name = "pwrkey";
			gpio-export,output = <1>;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		};

		modem-mode {
			gpio-export,name = "modemmode";
			gpio-export,output = <0>;
			gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
		};

		ant {
			gpio-export,name = "ant";
			gpio-export,output = <0>;
			gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		};
	};

	reserved-memory {
		q6_region_qcn6122_1: q6-region-qcn6122-1@4d200000 {
			reg = <0x0 0x4d200000 0x0 0xd00000>;
			no-map;
		};

		m3_dump_qcn6122_1: m3-dump-qcn6122-1@4df00000 {
			reg = <0x0 0x4df00000 0x0 0x100000>;
			no-map;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <8>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "0:MIBIB";
				reg = <0x80000 0x80000>;
				read-only;
			};

			partition@100000 {
				label = "0:BOOTCONFIG";
				reg = <0x100000 0x40000>;
				read-only;
			};

			partition@140000 {
				label = "0:BOOTCONFIG1";
				reg = <0x140000 0x40000>;
				read-only;
			};

			partition@180000 {
				label = "0:QSEE";
				reg = <0x180000 0x100000>;
				read-only;
			};

			partition@280000 {
				label = "0:QSEE_1";
				reg = <0x280000 0x100000>;
				read-only;
			};

			partition@380000 {
				label = "0:DEVCFG";
				reg = <0x380000 0x040000>;
				read-only;
			};

			partition@3c0000 {
				label = "0:DEVCFG_1";
				reg = <0x3c0000 0x040000>;
				read-only;
			};

			partition@400000 {
				label = "0:CDT";
				reg = <0x400000 0x040000>;
				read-only;
			};

			partition@440000 {
				label = "0:CDT_1";
				reg = <0x440000 0x040000>;
				read-only;
			};

			partition@480000 {
				label = "0:APPSBLENV";
				reg = <0x480000 0x080000>;
			};

			partition@500000 {
				label = "0:APPSBL";
				reg = <0x500000 0x140000>;
				read-only;
			};

			partition@640000 {
				label = "0:APPSBL_1";
				reg = <0x640000 0x140000>;
				read-only;
			};

			partition@780000 {
				label = "0:ART";
				reg = <0x780000 0x100000>;
				read-only;
			};

			partition@880000 {
				label = "0:TRAINING";
				reg = <0x880000 0x080000>;
				read-only;
			};

			partition@900000 {
				label = "misc_data_ro";
				reg = <0x900000 0xc00000>;
				read-only;
			};

			partition@1500000 {
				label = "misc_data_rw";
				reg = <0x1500000 0xc00000>;
			};

			partition@2100000 {
				label = "rootfs";
				reg = <0x2100000 0x2460000>;
			};

			partition@4560000 {
				label = "rootfs_1";
				reg = <0x4560000 0x2460000>;
			};

			partition@69c0000 {
				label = "lte_fwimage";
				reg = <0x69c0000 0x6400000>;
				read-only;
			};

			partition@cdc0000 {
				label = "misc_data_rwbak";
				reg = <0xcdc0000 0x0c00000>;
				read-only;
			};

			partition@d9c0000 {
				label = "misc_data_isp";
				reg = <0xd9c0000 0x0c00000>;
				read-only;
			};
		};
	};
};


/*
 * ===========================================================================
 * Ethernet:
 *
 *   IPQ5018 gmac1 -> uniphy0 PCS -> 2.5G SGMII trunk -> RTL8367S DSA switch
 *   Three front jacks, all RTL8367S internal PHYs:
 *     WAN = phy0 ("wan"), LAN1 = phy2 ("lan1"), LAN2 = phy1 ("lan2")
 *   The SoC's internal GE PHY (mdio0:7/gmac0) is NOT bonded out, so gmac0
 *   stays at its default disabled state.
 * ===========================================================================
 */

/*
 * mdio0 must stay enabled even though the GE PHY behind it is unused:
 * registering the ge_phy deasserts GCC_GEPHY_MISC_ARES, and that reset also
 * gates the MDC/MDIO path shared with mdio1. With mdio0 disabled the
 * RTL8367S on mdio1 stops responding to SMI entirely (chip id read
 * -ETIMEDOUT, measured on NX510v 2026-07-30; unverified on MX515v).
 */
&mdio0 {
	status = "okay";
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	/*
	 * RTL8367S (OEM labels it "qca83xx"), MDIO-connected (realtek-mdio) at
	 * address 29. Reset is GPIO39 (reset-gpios below) - GPIO33 is unrelated,
	 * it drives the signal-green LED on this board, not any reset line.
	 *
	 * The reset line belongs on the switch node, not on the MDIO bus: on
	 * the bus node it is the MDIO core that drives it, with a 10 us pulse
	 * (DEFAULT_GPIO_RESET_DELAY) and no post-reset delay, immediately
	 * followed by the C22 bus scan. On the switch node the realtek driver
	 * owns it and gives the chip the 25 ms / 100 ms it expects before any
	 * register access.
	 */
	switch@29 {
		compatible = "realtek,rtl8365mb";
		reg = <29>;
		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

		/*
		 * The RTL8367S internal user-side MDIO bus. The DSA realtek
		 * driver (rtl83xx_setup_user_mdio) requires this child node -
		 * without it probe fails with "no MDIO bus node". wan, lan1 and
		 * lan2 hang off the switch's internal PHYs 0-2.
		 */
		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			switchphy0: ethernet-phy@0 {
				reg = <0>;
			};

			switchphy1: ethernet-phy@1 {
				reg = <1>;
			};

			switchphy2: ethernet-phy@2 {
				reg = <2>;
			};

		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "wan";
				phy-handle = <&switchphy0>;
			};

			port@1 {
				reg = <1>;
				label = "lan2";
				phy-handle = <&switchphy1>;
			};

			port@2 {
				reg = <2>;
				label = "lan1";
				phy-handle = <&switchphy2>;
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac1>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-pins {
		button-pins {
			pins = "gpio27", "gpio35";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led-pins {
		pins = "gpio12", "gpio13", "gpio22", "gpio24", "gpio25", "gpio31", "gpio32", "gpio33", "gpio34", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};
};

&usb {
	status = "okay";

	dr_mode = "host";
};

&usbphy0 {
	status = "okay";

};

/* the Quectel EG120K-EA modem enumerates at SuperSpeed */
&usbphy1 {
	status = "okay";

};

&q6v5_wcss {
	/* PCIe0, payload length 4, user-PD2, reset GPIO15. */
	boot-args = <0x1 4 2 15 0 0>;
};

&wifi {
	/* IPQ5018 2.4GHz */
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "TP-Link-MX515v";
	qcom,ath11k-fw-memory-mode = <2>;
};

&wifi1 {
	/* QCN6122 5GHz */
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "TP-Link-MX515v";
	qcom,ath11k-fw-memory-mode = <2>;

	memory-region = <&q6_region_qcn6122_1>, <&q6_region_ipq5018>, <&m3_dump_qcn6122_1>;
	memory-region-names = "q6-region", "m3-region", "m3-dump";
};
