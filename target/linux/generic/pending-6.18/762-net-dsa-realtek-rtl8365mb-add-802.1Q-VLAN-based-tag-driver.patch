--- /dev/null
+++ b/net/dsa/tag_rtl8365mb_8021q.c
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (C) 2026 Stanislaw Pal <stefdo61@gmail.com>
+ *
+ * 802.1Q VLAN-based tag driver for the Realtek RTL8365MB switch family,
+ * built on the tag_8021q framework: the source port travels in a VLAN tag
+ * the switch itself inserts, instead of the 8-byte Realtek CPU tag that
+ * only the switch and tag_rtl8_4 understand. That keeps the conduit's
+ * frames plain 802.1Q, which any MAC - and any hardware in front of it -
+ * parses. Same wire format as tag_rtl8365mb_8021q; the switch side differs.
+ */
+#include <linux/dsa/8021q.h>
+#include <linux/if_vlan.h>
+#include <net/dsa.h>
+
+#include "tag.h"
+#include "tag_8021q.h"
+
+#define RTL8365MB_8021Q_NAME "rtl8365mb-8021q"
+
+static struct sk_buff *rtl8365mb_8021q_xmit(struct sk_buff *skb,
+				      struct net_device *netdev)
+{
+	struct dsa_port *dp = dsa_user_to_port(netdev);
+	u16 queue_mapping = skb_get_queue_mapping(skb);
+	u16 tx_vid = dsa_tag_8021q_standalone_vid(dp);
+	u8 pcp;
+
+	if (skb->offload_fwd_mark) {
+		unsigned int bridge_num = dsa_port_bridge_num_get(dp);
+		struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+		/* A VLAN-aware bridge carries its own VID; the switch
+		 * forwards on that one.
+		 */
+		if (br_vlan_enabled(br))
+			return skb;
+
+		tx_vid = dsa_tag_8021q_bridge_vid(bridge_num);
+	}
+
+	/* An 802.1Q upper of the port (wan.35 for a PPPoE ISP) already
+	 * put its own tag in the skb. The switch carries that VLAN as it
+	 * is - the port and the CPU port are tagged members of it (see
+	 * rtl8365mb_port_vlan_add) - so send the frame with that tag alone
+	 * instead of stacking the port's tag_8021q VID in front of it.
+	 */
+	if (skb_vlan_tag_present(skb) &&
+	    !vid_is_dsa_8021q(skb_vlan_tag_get_id(skb)))
+		return skb;
+
+	pcp = netdev_txq_to_tc(netdev, queue_mapping);
+
+	return dsa_8021q_xmit(skb, netdev, ETH_P_8021Q,
+			      ((pcp << VLAN_PRIO_SHIFT) | tx_vid));
+}
+
+/* The user port that owns an 802.1Q upper with this VID, for a frame the
+ * switch delivered in a VLAN that is not a tag_8021q one. Such a VLAN is
+ * only ever installed for one port (rtl8365mb_port_vlan_add refuses a second),
+ * so the first match is the only match.
+ */
+static struct net_device *rtl8365mb_8021q_find_vlan_upper(struct net_device *conduit,
+						    __be16 proto, u16 vid)
+{
+	struct dsa_port *cpu_dp = conduit->dsa_ptr;
+	struct dsa_port *dp;
+
+	dsa_tree_for_each_user_port(dp, cpu_dp->dst) {
+		if (dp->cpu_dp != cpu_dp)
+			continue;
+		if (__vlan_find_dev_deep_rcu(dp->user, proto, vid))
+			return dp->user;
+	}
+
+	return NULL;
+}
+
+static struct sk_buff *rtl8365mb_8021q_rcv(struct sk_buff *skb,
+				     struct net_device *netdev)
+{
+	int src_port = -1, switch_id = -1, vbid = -1, vid = -1;
+
+	/* The conduit is promiscuous for the sake of the tag_8021q VIDs,
+	 * and a promiscuous MAC passes MAC control frames up as well. The
+	 * switch sends PAUSE at the CPU port whenever a slow user port
+	 * cannot drain what the CPU pushes; they carry no VLAN tag and
+	 * nothing above wants them.
+	 */
+	if (unlikely(eth_hdr(skb)->h_proto == htons(ETH_P_PAUSE)))
+		return NULL;
+
+	dsa_8021q_rcv(skb, &src_port, &switch_id, &vbid, &vid);
+
+	/* A VLAN of an 802.1Q upper: dsa_8021q_rcv left its tag on the skb
+	 * as hwaccel metadata, so once the frame reaches the user port the
+	 * kernel's VLAN demux hands it to the upper; we only pick the port.
+	 */
+	if (vid >= 0 && !vid_is_dsa_8021q(vid) && skb_vlan_tag_present(skb))
+		skb->dev = rtl8365mb_8021q_find_vlan_upper(netdev, skb->vlan_proto, vid);
+	else
+		skb->dev = dsa_tag_8021q_find_user(netdev, src_port, switch_id,
+						   vid, vbid);
+	if (!skb->dev) {
+		net_warn_ratelimited("%s: dropped frame from %pM proto 0x%04x: src_port=%d switch_id=%d vid=%d vbid=%d\n",
+				     netdev->name, eth_hdr(skb)->h_source,
+				     ntohs(eth_hdr(skb)->h_proto), src_port,
+				     switch_id, vid, vbid);
+		return NULL;
+	}
+
+	dsa_default_offload_fwd_mark(skb);
+
+	return skb;
+}
+
+static const struct dsa_device_ops rtl8365mb_8021q_netdev_ops = {
+	.name			= RTL8365MB_8021Q_NAME,
+	.proto			= DSA_TAG_PROTO_RTL8365MB_8021Q,
+	.xmit			= rtl8365mb_8021q_xmit,
+	.rcv			= rtl8365mb_8021q_rcv,
+	.needed_headroom	= VLAN_HLEN,
+	.promisc_on_conduit	= true,
+};
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("DSA tag driver for Realtek RTL8365MB switches, using VLAN");
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_RTL8365MB_8021Q, RTL8365MB_8021Q_NAME);
+
+module_dsa_tag_driver(rtl8365mb_8021q_netdev_ops);
