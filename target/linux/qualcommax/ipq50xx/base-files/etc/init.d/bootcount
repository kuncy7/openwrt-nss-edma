#!/bin/sh /etc/rc.common

START=99

boot() {
	case $(board_name) in
	linksys,mr2000|\
	linksys,mr5500|\
	linksys,mx2000|\
	linksys,mx5500|\
	linksys,mx6200|\
	linksys,spnmx56)
		mtd resetbc s_env || true
	;;
	netgear,wax630e)
		# U-Boot counts every start and switches the slot after three,
		# the stock firmware resets it. Skip RAM boots via TFTP, they
		# have no ubi.mtd= from bootipq.
		grep -q "ubi.mtd=" /proc/cmdline || return 0
		[ "$(fw_printenv -n boot_count 2>/dev/null)" = "0" ] || \
			fw_setenv boot_count 0
	;;
	xiaomi,mi-router-ax3000t-v2)
		. /lib/upgrade/common.sh
		[ "$(rootfs_type)" = "tmpfs" ] && return 0
		# The stock loader keeps counting boot attempts and eventually
		# gives up on the installed image unless the boot is confirmed.
		[ "$(fw_printenv -n flag_boot_success 2>/dev/null)" = "1" ] && \
		[ "$(fw_printenv -n flag_last_success 2>/dev/null)" = "1" ] && \
		[ "$(fw_printenv -n flag_try_sys1_failed 2>/dev/null)" = "8" ] && \
		[ "$(fw_printenv -n flag_try_sys2_failed 2>/dev/null)" = "8" ] && \
			return 0
		fw_setenv -s - <<-EOF
			flag_boot_success 1
			flag_last_success 1
			flag_try_sys1_failed 8
			flag_try_sys2_failed 8
		EOF
	;;
	esac
}
