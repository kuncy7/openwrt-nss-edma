 /* The vendor driver selects between two sets of SerDes tuning parameters based
@@ -1429,6 +1470,64 @@ static int rtl8365mb_sds_raise_rate_limi
 				  RTL8365MB_PORT6_EGRESSBW_CTRL1_MASK);
