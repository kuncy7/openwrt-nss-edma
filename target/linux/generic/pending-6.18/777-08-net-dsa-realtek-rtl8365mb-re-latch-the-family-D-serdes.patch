+/* The family D receiver latches on a DISABLE -> mode edge in SDS_MISC
+ * rather than on the value, and only once the far-end MAC has brought up
+ * its half of the link. There is no reliable local signal for that (bit
+ * 8 of the SDS link-status word does not correlate with it), and phylink
+ * never calls rtl8365mb_pcs_get_state() for this fixed-link port in the
+ * first place (mb->pcs.poll only arms phylink's own poll for in-band
+ * links), so this cannot rely on being polled at all. Instead,
+ * pcs_config() kicks off one attempt, and rtl8365mb_sds_relatch_work()
+ * re-arms itself after every edge, its next run checking whether the
+ * edge took, capped at RTL8365MB_D_SDS_RELATCH_MAX_TRIES attempts per
+ * episode so that a far end which never comes up costs a bounded burst
+ * of 20 ms parks. The episode starts at pcs_config(). Once the receiver
+ * has latched the count is back to 0 and the same work keeps polling the
+ * link every RTL8365MB_D_SDS_HEALTHCHECK_INTERVAL; finding it down then
+ * (count still 0) starts a new episode, e.g. after the far end reset its
+ * PLL without a reconfiguration. After the last attempt one more run
+ * checks whether it took and only then reports failure; the work then
+ * keeps driving one edge per healthcheck interval, so a far end that
+ * comes up late is recovered without a reconfiguration.
+ */
+
+static void rtl8365mb_sds_relatch_schedule(struct rtl8365mb *mb)
+{
+	unsigned int attempts;
+	unsigned long last;
+	unsigned long due;
+
+	if (delayed_work_pending(&mb->sds_relatch))
+		return;
+
+	/* Count is the runs scheduled so far. MAX_TRIES falls through below
+	 * and schedules the run after the last attempt, spaced by the
+	 * interval; above that, edges go on at the healthcheck cadence.
+	 */
+	attempts = READ_ONCE(mb->sds_relatch_count);
+	if (attempts > RTL8365MB_D_SDS_RELATCH_MAX_TRIES) {
+		schedule_delayed_work(&mb->sds_relatch,
+				      RTL8365MB_D_SDS_HEALTHCHECK_INTERVAL);
+		return;
+	}
+
+	/* No external caller re-checks this later (see the function comment
+	 * above), so even a too-early call must still end up scheduled - for
+	 * whenever the interval elapses - rather than just being dropped. The
+	 * work updates sds_relatch_last when it actually drives an attempt;
+	 * this only reads it, so back-to-back calls here cannot make the
+	 * cadence drift.
+	 */
+	last = READ_ONCE(mb->sds_relatch_last);
+	due = last + RTL8365MB_D_SDS_RELATCH_INTERVAL;
+	/* Only bounds the retries: a lost update under concurrent scheduling
+	 * shifts the cap by one attempt, not worth a lock.
+	 */
+	WRITE_ONCE(mb->sds_relatch_count, attempts + 1);
+	schedule_delayed_work(&mb->sds_relatch,
+			      time_before(jiffies, due) ? due - jiffies : 0);
+}
+
 static int rtl8365mb_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 				phy_interface_t interface,
 				const unsigned long *advertising,
@@ -1450,6 +1549,13 @@ static int rtl8365mb_pcs_config(struct p
 
 	is_d = rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D;
 
+	/* Cancel any in-flight re-latch edge before touching SDS_MISC: the
+	 * work drops sds_lock across its sleep and could otherwise interleave
+	 * with the reconfiguration below.
+	 */
+	if (is_d)
+		cancel_delayed_work_sync(&mb->sds_relatch);
+
 	/* Select the appropriate tuning table and SDS mode */
 	if (interface == PHY_INTERFACE_MODE_2500BASEX) {
 		if (is_d) {
@@ -1517,10 +1623,6 @@ static int rtl8365mb_pcs_config(struct p
 		if (ret)
 			return ret;
 
-		misc_mask = RTL8365MB_D_SDS_MISC_PA33PC_EN |
-			    RTL8365MB_D_SDS_MISC_PA12PC_EN |
-			    RTL8365MB_D_SDS_MISC_MODE_FIELD_MASK |
-			    RTL8365MB_D_SDS_MISC_MAC6_SEL_SDS0;
 		misc_val  = RTL8365MB_D_SDS_MISC_PA33PC_EN |
 			    RTL8365MB_D_SDS_MISC_PA12PC_EN |
 			    RTL8365MB_D_SDS_MISC_MAC6_SEL_SDS0 | sds_mode;
@@ -1533,12 +1635,33 @@ static int rtl8365mb_pcs_config(struct p
 			    RTL8365MB_SDS_MISC_MAC8_SEL_HSGMII_MASK;
 	}
 
-	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
-				 misc_mask, misc_val);
-	if (ret)
-		return ret;
+	if (is_d) {
+		/* Full write rather than update_bits: misc_val carries every
+		 * field of SDS_MISC that matters here (the PA enables,
+		 * MAC6_SEL_SDS0 and the mode), and comes out as 0x0E12 for
+		 * HSGMII - the same value the stock firmware holds with the
+		 * trunk up.
+		 *
+		 * The receiver latches on a DISABLE -> mode edge rather than
+		 * on the value; that edge is driven by the re-latch work
+		 * kicked off below, since phylink does not poll this
+		 * fixed-link port (see rtl8365mb_sds_relatch_schedule()).
+		 */
+		mutex_lock(&mb->sds_lock);
+		ret = regmap_write(priv->map, RTL8365MB_SDS_MISC_REG, misc_val);
+		mutex_unlock(&mb->sds_lock);
+		if (ret)
+			return ret;
+
+		WRITE_ONCE(mb->sds_misc_target_val, misc_val);
+	} else {
+		mutex_lock(&mb->sds_lock);
+		ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
+					 misc_mask, misc_val);
+		mutex_unlock(&mb->sds_lock);
+		if (ret)
+			return ret;
 
-	if (!is_d) {
 		val = sds_mode << RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_OFFSET(id);
 		ret = regmap_update_bits(priv->map,
 					 RTL8365MB_DIGITAL_INTERFACE_SELECT_REG(id),
@@ -1585,8 +1708,122 @@ static int rtl8365mb_pcs_config(struct p
 	val &= ~RTL8365MB_SDS_NWAY_EN_MASK;
 	val |= RTL8365MB_SDS_NWAY_RESTART_MASK;
 
-	return rtl8365mb_sds_write(priv, sds_index,
-				   RTL8365MB_SDS_REG_NWAY, val);
+	ret = rtl8365mb_sds_write(priv, sds_index,
+				  RTL8365MB_SDS_REG_NWAY, val);
+	if (ret)
+		return ret;
+
+	if (is_d) {
+		/* Start a new re-latch episode and kick off the first attempt;
+		 * see rtl8365mb_sds_relatch_schedule() for why this cannot wait
+		 * for phylink to ask again.
+		 */
+		WRITE_ONCE(mb->sds_relatch_count, 0);
+		WRITE_ONCE(mb->sds_relatch_last,
+			   jiffies - RTL8365MB_D_SDS_RELATCH_INTERVAL);
+		rtl8365mb_sds_relatch_schedule(mb);
+	}
+
+	return 0;
+}
+
+/* Check whether the receiver has latched; if not, drive a single
+ * DISABLE -> target edge and re-arm through rtl8365mb_sds_relatch_schedule(),
+ * whose next run checks whether it took. Once latched it only polls; once
+ * the budget is spent it keeps driving edges, at the healthcheck interval.
+ */
+static void rtl8365mb_sds_relatch_work(struct work_struct *work)
+{
+	struct rtl8365mb *mb = container_of(to_delayed_work(work),
+					    struct rtl8365mb, sds_relatch);
+	struct realtek_priv *priv = mb->priv;
+	u32 park = (READ_ONCE(mb->sds_misc_target_val) &
+		    ~RTL8365MB_D_SDS_MISC_MODE_FIELD_MASK) |
+		   RTL8365MB_D_PORT_SDS_MODE_DISABLE;
+	unsigned int attempts;
+	u16 status;
+	int ret;
+
+	/* Marks the start of this attempt, not of the scheduling decision
+	 * that led to it: rtl8365mb_sds_relatch_schedule() only reads this,
+	 * so the ~1 s cadence between attempts does not drift.
+	 */
+	WRITE_ONCE(mb->sds_relatch_last, jiffies);
+
+	/* The condition that queued this work may already be stale by the
+	 * time it runs (e.g. an earlier edge from a prior attempt just
+	 * latched). Parking an already-live link would drop it for no
+	 * reason.
+	 */
+	ret = rtl8365mb_sds_read(priv, RTL8365MB_D_SDS_EXT0_INDEX,
+				 RTL8365MB_SDS_REG_LINK_STATUS, &status);
+	if (ret) {
+		dev_err_ratelimited(priv->dev,
+				    "failed to read SerDes link status: %pe\n",
+				    ERR_PTR(ret));
+		rtl8365mb_sds_relatch_schedule(mb);
+		return;
+	}
+	if (status & RTL8365MB_SDS_LINK_STATUS_LINK_MASK) {
+		/* Latched: end the episode, keep watching for a later loss. */
+		WRITE_ONCE(mb->sds_relatch_count, 0);
+		schedule_delayed_work(&mb->sds_relatch,
+				      RTL8365MB_D_SDS_HEALTHCHECK_INTERVAL);
+		return;
+	}
+
+	attempts = READ_ONCE(mb->sds_relatch_count);
+	if (attempts > RTL8365MB_D_SDS_RELATCH_MAX_TRIES) {
+		/* Past the fast-retry budget. The receiver latches only on a
+		 * DISABLE -> mode edge and nothing re-runs pcs_config() for a
+		 * fixed-link port, so keep driving one edge per healthcheck
+		 * interval (see rtl8365mb_sds_relatch_schedule()). Warn once.
+		 */
+		if (attempts == RTL8365MB_D_SDS_RELATCH_MAX_TRIES + 1) {
+			WRITE_ONCE(mb->sds_relatch_count, attempts + 1);
+			dev_warn(priv->dev,
+				 "SerDes did not latch after %u re-latch attempts; still retrying every %lu s\n",
+				 RTL8365MB_D_SDS_RELATCH_MAX_TRIES,
+				 RTL8365MB_D_SDS_HEALTHCHECK_INTERVAL / HZ);
+		}
+	} else if (!attempts) {
+		dev_warn(priv->dev,
+			 "SerDes link lost outside a reconfiguration; re-latching\n");
+		WRITE_ONCE(mb->sds_relatch_count, 1);
+	}
+
+	mutex_lock(&mb->sds_lock);
+	ret = regmap_write(priv->map, RTL8365MB_SDS_MISC_REG, park);
+	mutex_unlock(&mb->sds_lock);
+	if (ret) {
+		dev_err_ratelimited(priv->dev,
+				    "failed to park SDS_MISC: %pe\n",
+				    ERR_PTR(ret));
+		rtl8365mb_sds_relatch_schedule(mb);
+		return;
+	}
+
+	usleep_range(20000, 21000);
+
+	mutex_lock(&mb->sds_lock);
+	ret = regmap_write(priv->map, RTL8365MB_SDS_MISC_REG,
+			   READ_ONCE(mb->sds_misc_target_val));
+	mutex_unlock(&mb->sds_lock);
+	if (ret) {
+		dev_err_ratelimited(priv->dev,
+				    "failed to restore SDS_MISC: %pe\n",
+				    ERR_PTR(ret));
+		rtl8365mb_sds_relatch_schedule(mb);
+		return;
+	}
+
+	dev_dbg(priv->dev, "SerDes re-latch edge driven (attempt %u)\n",
+		READ_ONCE(mb->sds_relatch_count));
+
+	/* This edge may not have taken either; the next attempt (if any
+	 * remain) is scheduled the same way the first one was.
+	 */
+	rtl8365mb_sds_relatch_schedule(mb);
 }
 
 static bool rtl8365mb_interface_is_serdes(phy_interface_t interface)
@@ -1638,20 +1875,33 @@ static void rtl8365mb_pcs_get_state(stru
 
 	state->link = !!(status & RTL8365MB_SDS_LINK_STATUS_LINK_MASK);
 	state->an_complete = state->link;
-	if (!state->link)
-		return;
-
 	if (is_d) {
+		/* Re-latching is driven from pcs_config() (see
+		 * rtl8365mb_sds_relatch_schedule()), not from here: phylink
+		 * does not poll pcs_get_state() for a fixed-link port, which
+		 * this CPU port normally is.
+		 */
+		if (!state->link)
+			return;
+
+		/* Latched: the next loss of link starts a fresh episode. */
+		WRITE_ONCE(mb->sds_relatch_count, 0);
+
 		state->duplex = DUPLEX_FULL;
 		state->speed = state->interface == PHY_INTERFACE_MODE_2500BASEX ?
 				SPEED_2500 : SPEED_1000;
 		return;
 	}
 
+	if (!state->link)
+		return;
+
