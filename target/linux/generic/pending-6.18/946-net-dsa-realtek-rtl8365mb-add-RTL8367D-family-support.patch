From: Gustavo Foletto Mora <gusfmora@gmail.com>
Subject: [PATCH] net: dsa: realtek: rtl8365mb: add RTL8367D family support

The RTL8367S-VB reports chip number 0x6642 with chip version 0x0010. It is
not another RTL8367C variant: it is an RTL8367D part, and the vendor driver
treats it as one. qca-ssdk's switch_probe() tries the RTL8367C IDs first and,
when none match, re-reads the chip number through the D register layer and
dispatches the whole device to a second abstraction layer (dal_rtl8367d_*).
OpenWrt's own swconfig driver (drivers/net/phy/rtl8367b.c) makes the same
split, calling 0x6642/0x0010 "8367S-VB" and giving it a family D path.

The switch core register map is shared, so detection, the init jam table,
table access, VLAN control, MIB and port setup all work unchanged. The
external interface and SerDes block, however, moved:

  - External interface 0 is port 6 and interface 1 is port 7, where the
    RTL8367C has interface 0 on port 5, 1 on port 6 and 2 on port 7. A chip
    info entry cloned from an RTL8367C part therefore drives the wrong
    external interface for the CPU link.

  - The MAC force configuration is a pair of registers per port, 0x12C0 and
    0x12C8 indexed by port number, not the two registers indexed by external
    interface ID at 0x1310. The force enable has a register of its own rather
    than living in bit 12, and the speed field is four bits split across
    bits 1:0 and 13:12, with a real 2.5 Gbps encoding of 5.

  - The SerDes is a different block. Its mode is selected by a field in a
    per-SerDes misc register (0x1D11 for the SerDes behind interface 0,
    0x1D78 for interface 1) instead of by the DIGITAL_INTERFACE_SELECT
    nibble plus the RTL8367C's SGMII/HSGMII mux bits, the indirect access
    command register takes a SerDes selector in its low bits, the tuning
    parameters are written to different SerDes registers, and the vendor's
    NCTL controller at 0x612F shares the indirect access window. NCTL runs a
    microprogram the vendor loads into its RAM before enabling it, which this
    driver does not load, so it leaves NCTL alone and only parks it around an
    indirect access. phylink manages the link either way.

Without these the driver binds, reports a forced link that phylink believes,
and passes no frames at all across the CPU port: every register it writes to
bring the link up is either at a different address or applies to the other
external interface.

Add an explicit family tag to the chip info, the RTL8367S-VB entry, and the
family D paths for the SerDes configuration and the external interface force.
Everything else stays common.

Read from a TP-Link EX511 v2, where the switch sits at MDIO address 29 on the
IPQ5018 mdio1 bus:

  BUS=90000.mdio-1 ADDR=29 CHIP_ID=0x6642 CHIP_VER=0x0010

The register addresses and sequences are taken from
dal_rtl8367d_port_macForceLinkExt_set() and dal_rtl8367d_port_sgmiiNway_set()
in that device's stock qca-ssdk.ko, whose rtl8367s glue configures the CPU
link with rtk_port_macForceLinkExt_set(EXT_PORT0, SGMII, ...).

--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -316,6 +316,75 @@
 #define   RTL8365MB_SDS_OPTION_ARM_KEY		0x0249
 #define RTL8365MB_SDS_OPTION_REG		0x13C1
 
+/* RTL8367D family registers.
+ *
+ * The RTL8367D die keeps most of the RTL8367C register map, but the whole
+ * external interface and SerDes block moved. The vendor driver reflects that
+ * with a second DAL (dal_rtl8367d_*) selected by a chip ID re-read through the
+ * D register layer. The addresses below come from
+ * dal_rtl8367d_port_macForceLinkExt_set() and dal_rtl8367d_port_sgmiiNway_set()
+ * in the stock qca-ssdk.ko of a TP-Link EX511 v2, and agree with the "family D"
+ * path of OpenWrt's older swconfig rtl8367b driver.
+ */
+
+/* Per-port MAC force configuration. The RTL8367C forces its external
+ * interfaces through registers indexed by external interface ID, with the
+ * force enable in bit 12. The RTL8367D has one pair of registers per port,
+ * indexed by port number, and a separate all-or-nothing enable register.
+ */
+#define RTL8367D_MAC_FORCE_REG(_port)		(0x12C0 + (_port))
+#define   RTL8367D_MAC_FORCE_SPEED_LO_MASK	0x0003
+#define   RTL8367D_MAC_FORCE_DUPLEX_MASK	0x0004
+#define   RTL8367D_MAC_FORCE_LINK_MASK		0x0010
+#define   RTL8367D_MAC_FORCE_RXPAUSE_MASK	0x0020
+#define   RTL8367D_MAC_FORCE_TXPAUSE_MASK	0x0040
+#define   RTL8367D_MAC_FORCE_NWAY_MASK		0x0080
+#define   RTL8367D_MAC_FORCE_SPEED_HI_MASK	0x3000
+#define RTL8367D_MAC_FORCE_EN_REG(_port)	(0x12C8 + (_port))
+#define   RTL8367D_MAC_FORCE_EN_ALL		0xFFFF
+
+/* The force speed field is four bits wide, split across the two masks above,
+ * and unlike the RTL8367C it has a real 2.5 Gbps encoding.
+ */
+#define RTL8367D_PORT_SPEED_10M			0
+#define RTL8367D_PORT_SPEED_100M		1
+#define RTL8367D_PORT_SPEED_1000M		2
+#define RTL8367D_PORT_SPEED_2500M		5
+
+/* SerDes miscellaneous configuration, one register per SerDes: SDS0 feeds
+ * external interface 0 (port 6), SDS1 feeds external interface 1 (port 7).
+ * The mode field replaces the RTL8367C's DIGITAL_INTERFACE_SELECT nibble and
+ * its separate SGMII/HSGMII mux bits.
+ */
+#define RTL8367D_SDS0_MISC_REG			0x1D11
+#define RTL8367D_SDS1_MISC_REG			0x1D78
+#define   RTL8367D_SDS_MISC_MODE_MASK		0x001F
+#define     RTL8367D_SDS_MODE_SGMII		0x02
+#define     RTL8367D_SDS_MODE_HSGMII		0x12
+#define     RTL8367D_SDS_MODE_DISABLE		0x1F
+#define   RTL8367D_SDS_MISC_EN_MASK		0x0E00
+
+/* The SerDes indirect access command register takes a SerDes selector in its
+ * low bits, which the RTL8367C leaves at zero.
+ */
+#define RTL8367D_SDS_INDACS_SEL_SDS0		13
+#define RTL8367D_SDS_INDACS_SEL_SDS1		15
+
+/* Configured before enabling a SerDes on external interface 0 */
+#define RTL8367D_EXT0_SDS_CFG_REG		0x13E8
+#define   RTL8367D_EXT0_SDS_CFG_MASK		0x00C0
+#define   RTL8367D_EXT0_SDS_CFG_VALUE		0x0040
+
+/* NCTL, the vendor's analogue controller for the SerDes: bit 2 enables it and
+ * bit 3 lets a bit error rate trigger a retrain. It shares the indirect
+ * access window, so the vendor driver parks it around every indirect access.
+ * It also runs a microprogram that the vendor loads into its RAM before
+ * enabling it (SDSNctrlPatch, written through 0x6135/0x6136). This driver
+ * loads none, and phylink manages the link, so it never enables NCTL: it
+ * only parks whatever it finds for the duration of an access.
+ */
+#define RTL8367D_SDS_NCTL_REG			0x612F
+
 /* Embedded DW8051 microcontroller control registers. The microcontroller
  * can run firmware to manage the SerDes link, but this driver keeps it in
  * reset and disabled: phylink already performs the link management that
@@ -661,6 +730,23 @@
 	{ 0x0424, 0xD810 }, { 0x0001, 0x0F80 }, { 0x002E, 0x83F2 },
 };
 
+/* SGMII SerDes tuning parameters for RTL8367D parts, from the vendor driver.
+ * The RTL8367D SerDes is a different block with a different register layout,
+ * so it needs its own tables; the two differ only in one entry.
+ */
+static const struct rtl8365mb_jam_tbl_entry rtl8367d_sds_jam_sgmii[] = {
+	{ 0x0427, 0x4E0C }, { 0x0428, 0xAA00 }, { 0x0425, 0x5189 },
+	{ 0x0424, 0x8414 }, { 0x0423, 0x1020 }, { 0x0410, 0x0002 },
+	{ 0x0484, 0x011B }, { 0x0421, 0x8E13 }, { 0x0422, 0x1140 },
+};
+
+/* HSGMII SerDes tuning parameters for RTL8367D parts */
+static const struct rtl8365mb_jam_tbl_entry rtl8367d_sds_jam_hsgmii[] = {
+	{ 0x0427, 0x4E0C }, { 0x0428, 0xAA00 }, { 0x0425, 0x5189 },
+	{ 0x0424, 0x8414 }, { 0x0423, 0x1020 }, { 0x0410, 0x0002 },
+	{ 0x0504, 0x051B }, { 0x0421, 0x8E13 }, { 0x0422, 0x1140 },
+};
+
 enum rtl8365mb_phy_interface_mode {
 	RTL8365MB_PHY_INTERFACE_MODE_INVAL = 0,
 	RTL8365MB_PHY_INTERFACE_MODE_INTERNAL = BIT(0),
@@ -673,6 +759,21 @@
 };
 
 /**
+ * enum rtl8365mb_family - register map family of a supported chip
+ * @RTL8365MB_FAMILY_C: RTL8365MB-VC and RTL8367C parts
+ * @RTL8365MB_FAMILY_D: RTL8367D parts
+ *
+ * The RTL8367D shares the switch core register map with the older parts, so
+ * detection, tables, VLAN control, MIB and port setup are common, but its
+ * external interface and SerDes registers moved. Chips are tagged with their
+ * family so that the few places which differ can branch.
+ */
+enum rtl8365mb_family {
+	RTL8365MB_FAMILY_C = 0,
+	RTL8365MB_FAMILY_D,
+};
+
+/**
  * struct rtl8365mb_extint - external interface info
  * @port: the port with an external interface
  * @id: the external interface ID, which is either 0, 1, or 2
@@ -692,6 +793,7 @@
  * @name: human-readable chip name
  * @chip_id: chip identifier
  * @chip_ver: chip silicon revision
+ * @family: register map family this chip belongs to
  * @extints: available external interfaces
  * @jam_table: chip-specific initialization jam table
  * @jam_size: size of the chip's jam table
@@ -704,6 +806,7 @@
 	const char *name;
 	u32 chip_id;
 	u32 chip_ver;
+	enum rtl8365mb_family family;
 	const struct rtl8365mb_extint extints[RTL8365MB_MAX_NUM_EXTINTS];
 	const struct rtl8365mb_jam_tbl_entry *jam_table;
 	size_t jam_size;
@@ -750,6 +853,29 @@
 		.jam_size = ARRAY_SIZE(rtl8365mb_init_jam_8365mb_vc),
 	},
 	{
+		/* The RTL8367S-VB is an RTL8367D part: it reports a chip
+		 * number of its own, and the vendor driver dispatches it to a
+		 * separate register abstraction layer. External interface 0
+		 * is port 6 here, not port 5 as on the RTL8367C.
+		 */
+		.name = "RTL8367S-VB",
+		.chip_id = 0x6642,
+		.chip_ver = 0x0010,
+		.family = RTL8365MB_FAMILY_D,
+		.extints = {
+			{ 6, 0, PHY_INTF(SGMII) | PHY_INTF(HSGMII) },
+			/* Interface 1 (port 7) is an RGMII/MII interface on
+			 * this part, but its configuration registers moved
+			 * with the D die and rtl8365mb_ext_config_rgmii()
+			 * still writes the RTL8367C ones. Not advertised until
+			 * a D path exists, so a DTS using it fails to probe
+			 * instead of coming up with a silently dead link.
+			 */
+		},
+		.jam_table = rtl8365mb_init_jam_8365mb_vc,
+		.jam_size = ARRAY_SIZE(rtl8365mb_init_jam_8365mb_vc),
+	},
+	{
 		.name = "RTL8367RB-VB",
 		.chip_id = 0x6367,
 		.chip_ver = 0x0020,
@@ -1159,40 +1285,114 @@
 	return 0;
 }
 
+static bool rtl8365mb_family_is_d(struct realtek_priv *priv)
+{
+	struct rtl8365mb *mb = priv->chip_data;
+
+	return mb->chip_info->family == RTL8365MB_FAMILY_D;
+}
+
+/* The indirect access command register carries a SerDes selector in its low
+ * bits. The RTL8367C has a single SerDes and leaves them at zero; on the
+ * RTL8367D the SerDes behind external interface 0 is selector 13.
+ */
+static u32 rtl8365mb_sds_indacs_sel(struct realtek_priv *priv)
+{
+	if (rtl8365mb_family_is_d(priv))
+		return RTL8367D_SDS_INDACS_SEL_SDS0;
+
+	return 0;
+}
+
+/* NCTL drives the SerDes through the same indirect access window, so park it
+ * for the duration of an access and put back whatever was there. Nothing
+ * equivalent exists on the RTL8367C, where these helpers are no-ops.
+ */
+static int rtl8365mb_sds_nctl_park(struct realtek_priv *priv, u32 *saved)
+{
+	int ret;
+
+	*saved = 0;
+
+	if (!rtl8365mb_family_is_d(priv))
+		return 0;
+
+	ret = regmap_read(priv->map, RTL8367D_SDS_NCTL_REG, saved);
+	if (ret)
+		return ret;
+
+	if (!*saved)
+		return 0;
+
+	return regmap_write(priv->map, RTL8367D_SDS_NCTL_REG, 0);
+}
+
+static int rtl8365mb_sds_nctl_restore(struct realtek_priv *priv, u32 saved)
+{
+	if (!saved)
+		return 0;
+
+	return regmap_write(priv->map, RTL8367D_SDS_NCTL_REG, saved);
+}
+
 static int rtl8365mb_sds_write(struct realtek_priv *priv, u16 addr, u16 data)
 {
+	u32 nctl;
 	int ret;
 
-	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, data);
+	ret = rtl8365mb_sds_nctl_park(priv, &nctl);
 	if (ret)
 		return ret;
 
+	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, data);
+	if (ret)
+		goto out_resume;
+
 	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
 	if (ret)
-		return ret;
+		goto out_resume;
 
 	/* The SerDes indirect access engine completes the command within the
 	 * register write transaction, so there is no need to wait or poll for
 	 * completion before the next access, matching the vendor driver.
 	 */
-	return regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
-			    RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
-			    RTL8365MB_SDS_INDACS_CMD_WR_MASK);
+	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
+			   RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
+			   RTL8365MB_SDS_INDACS_CMD_WR_MASK |
+			   rtl8365mb_sds_indacs_sel(priv));
+
+out_resume:
+	/* Put NCTL back even after a failed access: these run from the PCS poll
+	 * every second, so one MDIO hiccup must not leave it parked for good
+	 * if something else enabled it.
+	 */
+	if (ret)
+		rtl8365mb_sds_nctl_restore(priv, nctl);
+	else
+		ret = rtl8365mb_sds_nctl_restore(priv, nctl);
+
+	return ret;
 }
 
 static int rtl8365mb_sds_read(struct realtek_priv *priv, u16 addr, u16 *data)
 {
+	u32 nctl;
 	u32 val;
 	int ret;
 
-	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
+	ret = rtl8365mb_sds_nctl_park(priv, &nctl);
 	if (ret)
 		return ret;
 
+	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_ADR_REG, addr);
+	if (ret)
+		goto out_resume;
+
 	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
-			   RTL8365MB_SDS_INDACS_CMD_RUN_MASK);
+			   RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
+			   rtl8365mb_sds_indacs_sel(priv));
 	if (ret)
-		return ret;
+		goto out_resume;
 
 	/* Wait for the indirect read to complete: the engine clears the BUSY
 	 * bit once the data register holds the result.
@@ -1202,15 +1402,21 @@
 				       !(val & RTL8365MB_SDS_INDACS_CMD_BUSY_MASK),
 				       10, 1000);
 	if (ret)
-		return ret;
+		goto out_resume;
 
 	ret = regmap_read(priv->map, RTL8365MB_SDS_INDACS_DATA_REG, &val);
 	if (ret)
-		return ret;
+		goto out_resume;
 
 	*data = val;
 
-	return 0;
+out_resume:
+	if (ret)
+		rtl8365mb_sds_nctl_restore(priv, nctl);
+	else
+		ret = rtl8365mb_sds_nctl_restore(priv, nctl);
+
+	return ret;
 }
 
 /* The vendor driver selects between two sets of SerDes tuning parameters based
@@ -1242,6 +1448,14 @@
 	if (i == RTL8365MB_MAX_NUM_EXTINTS)
 		return 0;
 
+	/* RTL8367D parts have a single set of SerDes tuning parameters, and
+	 * the vendor driver never consults the chip option register for them.
+	 */
+	if (rtl8365mb_family_is_d(priv)) {
+		mb->sds_supported = true;
+		return 0;
+	}
+
 	ret = regmap_write(priv->map, RTL8365MB_SDS_OPTION_ARM_REG,
 			   RTL8365MB_SDS_OPTION_ARM_KEY);
 	if (ret)
@@ -1303,6 +1517,84 @@
 				  RTL8365MB_PORT6_EGRESSBW_CTRL1_MASK);
 }
 
+/* Bring up the RTL8367D SerDes behind external interface 0. Unlike the
+ * RTL8367C, the interface mode is not written into the DIGITAL_INTERFACE_SELECT
+ * nibble: the SerDes has its own mode field, and the SGMII/HSGMII mux bits the
+ * RTL8367C uses do not exist. Reproduces dal_rtl8367d_port_macForceLinkExt_set()
+ * for EXT_PORT0, minus the DW8051 firmware upload, which this driver replaces
+ * with phylink (see below).
+ */
+static int rtl8367d_pcs_config_serdes(struct realtek_priv *priv,
+				      phy_interface_t interface)
+{
+	const struct rtl8365mb_jam_tbl_entry *sds_jam;
+	size_t sds_jam_size;
+	u32 mode;
+	int ret;
+	int i;
+
+	if (interface == PHY_INTERFACE_MODE_2500BASEX) {
+		sds_jam = rtl8367d_sds_jam_hsgmii;
+		sds_jam_size = ARRAY_SIZE(rtl8367d_sds_jam_hsgmii);
+		mode = RTL8367D_SDS_MODE_HSGMII;
+	} else {
+		sds_jam = rtl8367d_sds_jam_sgmii;
+		sds_jam_size = ARRAY_SIZE(rtl8367d_sds_jam_sgmii);
+		mode = RTL8367D_SDS_MODE_SGMII;
+	}
+
+	/* Hold the embedded DW8051 microcontroller in reset and keep it
+	 * disabled, for the same reason as on the RTL8367C: the vendor driver
+	 * uploads SerDes management firmware into it which polls the port and
+	 * rewrites the very registers phylink manages here.
+	 */
+	ret = regmap_update_bits(priv->map, RTL8365MB_CHIP_RESET_REG,
+				 RTL8365MB_CHIP_RESET_DW8051_MASK,
+				 RTL8365MB_CHIP_RESET_DW8051_MASK);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8365MB_MISC_CFG0_REG,
+				 RTL8365MB_MISC_CFG0_DW8051_EN_MASK, 0);
+	if (ret)
+		return ret;
+
+	/* The vendor driver clears the line rate bypass for all interface
+	 * modes except TMII.
+	 */
+	ret = regmap_update_bits(priv->map, RTL8365MB_BYPASS_LINE_RATE_REG,
+				 RTL8365MB_SDS_BYPASS_LINE_RATE_MASK, 0);
+	if (ret)
+		return ret;
+
+	/* Tune the SerDes with vendor-prescribed parameters */
+	for (i = 0; i < sds_jam_size; i++) {
+		ret = rtl8365mb_sds_write(priv, sds_jam[i].reg,
+					  sds_jam[i].val);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_update_bits(priv->map, RTL8367D_EXT0_SDS_CFG_REG,
+				 RTL8367D_EXT0_SDS_CFG_MASK,
+				 RTL8367D_EXT0_SDS_CFG_VALUE);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8367D_SDS0_MISC_REG,
+				 RTL8367D_SDS_MISC_EN_MASK,
+				 RTL8367D_SDS_MISC_EN_MASK);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8367D_SDS0_MISC_REG,
+				 RTL8367D_SDS_MISC_MODE_MASK, mode);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
 static int rtl8365mb_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 				phy_interface_t interface,
 				const unsigned long *advertising,
@@ -1320,6 +1612,14 @@
 
 	priv = mb->priv;
 
+	if (mb->chip_info->family == RTL8365MB_FAMILY_D) {
+		ret = rtl8367d_pcs_config_serdes(priv, interface);
+		if (ret)
+			return ret;
+
+		goto disable_nway;
+	}
+
 	if (interface == PHY_INTERFACE_MODE_2500BASEX) {
 		sds_jam = rtl8365mb_sds_jam_hsgmii;
 		sds_jam_size = ARRAY_SIZE(rtl8365mb_sds_jam_hsgmii);
@@ -1408,6 +1708,7 @@
 	/* Keep SGMII in-band autonegotiation disabled: the link parameters are
 	 * forced from rtl8365mb_pcs_link_up() instead.
 	 */
+disable_nway:
 	ret = rtl8365mb_sds_read(priv, RTL8365MB_SDS_REG_NWAY, &val);
 	if (ret)
 		return ret;
@@ -1462,6 +1763,18 @@
 	if (!state->link)
 		return;
 
+	/* On RTL8367D parts the SerDes MISC register holds the SerDes mode, not
+	 * a forced speed and duplex: those live in the per-port MAC force
+	 * register instead. Report what was forced there by the caller.
+	 */
+	if (rtl8365mb_family_is_d(priv)) {
+		state->duplex = DUPLEX_FULL;
+		state->speed =
+			state->interface == PHY_INTERFACE_MODE_2500BASEX ?
+				SPEED_2500 : SPEED_1000;
+		return;
+	}
+
 	/* The speed and duplex are forced; read them back from the values
 	 * programmed into the SerDes MISC register.
 	 */
@@ -1503,6 +1816,14 @@
 	u32 r_speed;
 	int ret;
 
+	/* RTL8367D parts have no forced link, speed or duplex in the SerDes
+	 * MISC register -- those bits are the SerDes enables and mode, already
+	 * programmed in rtl8367d_pcs_config_serdes(). The link is forced in the
+	 * per-port MAC force register from rtl8365mb_ext_config_forcemode().
+	 */
+	if (rtl8365mb_family_is_d(priv))
+		return;
+
 	/* The speed field has no value for 2.5 Gbps: the rate is determined by
 	 * the HSGMII SerDes configuration, and the vendor driver programs the
 	 * 1 Gbps value here.
@@ -1544,6 +1865,66 @@
 	.pcs_link_up = rtl8365mb_pcs_link_up,
 };
 
+/* Force the link on an RTL8367D external interface. The register pair is
+ * indexed by port, the enable has a register of its own, and the speed field
+ * is four bits split across two masks, with a real 2.5 Gbps encoding.
+ */
+static int rtl8367d_ext_config_forcemode(struct realtek_priv *priv, int port,
+					 bool link, int speed, int duplex,
+					 bool tx_pause, bool rx_pause)
+{
+	u32 r_speed;
+	u32 val;
+	int ret;
+
+	if (!link) {
