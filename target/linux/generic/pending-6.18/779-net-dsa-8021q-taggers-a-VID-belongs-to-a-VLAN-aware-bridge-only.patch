 			/* A VLAN-unaware bridge still hands its VLANs over
-			 * (VID 1, PVID, untagged, by default). They stay in
-			 * software here: the port's tag_8021q VLAN carries its
-			 * traffic, and the bridge's PVID would replace the one
-			 * tag_8021q set.
-			 *
-			 * An 802.1Q upper of a user port (wan.35 for a PPPoE
-			 * ISP) comes through the same call, tagged and not
-			 * PVID, and that one does go into the hardware: the
-			 * port and the CPU port become tagged members, so the
-			 * ISP's tag crosses the switch as it is and the tagger
-			 * passes it through untouched. One port per VID - the
-			 * tagger picks the port by the VID alone.
+			 * (VID 1, PVID, untagged, by default; any other the
+			 * user adds). They stay in software here: the port's
+			 * tag_8021q VLAN carries its traffic. Should the
+			 * bridge turn VLAN-aware, qca8k_port_vlan_filtering()
+			 * fetches them.
 			 */
-			if (pvid || untagged)
-				return 0;
-			if (qca8k_vlan_upper_elsewhere(ds, port, vlan->vid)) {
-				NL_SET_ERR_MSG_MOD(extack,
-						   "VID is already an 802.1Q upper of another port");
-				return -EBUSY;
-			}
+			return 0;
 		} else if (qca8k_vlan_upper_elsewhere(ds, port, vlan->vid)) {
 			/* A VLAN-aware bridge's VLANs go in as they are, PVID
 			 * and untagged included; the tagger delivers by the
 			 * VID, so the VID may span the bridge's ports but not
 			 * reach beyond the bridge.
+			 *
+			 * An 802.1Q upper of a user port (wan.35 for a PPPoE
+			 * ISP) goes in as well, whatever the port is part of:
+			 * the port and the CPU port become tagged members, so
+			 * the ISP's tag crosses the switch as it is and the
+			 * tagger passes it through untouched. One port per
+			 * VID - the tagger picks the port by the VID alone.
 			 */
 			NL_SET_ERR_MSG_MOD(extack,
 					   "VID is already an 802.1Q upper of another port");
@@ -1322,6 +1434,11 @@
 					   "VID is already a VLAN of another VLAN-aware bridge");
 			return -EBUSY;
 		}
+
+		if (!bridge_vlan) {
+			untagged = false;
+			pvid = false;
+		}
 	}
 
 	ret = qca8k_vlan_add(priv, port, vlan->vid, untagged);
@@ -1330,6 +1447,11 @@
 		return ret;
 	}
 
+	if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q &&
+	    dsa_is_user_port(ds, port))
+		__set_bit(vlan->vid, bridge_vlan ? priv->bridge_vlans[port] :
+						   priv->upper_vlans[port]);
+
 	if (pvid) {
 		if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q) {
 			priv->bridge_pvid[port] = vlan->vid;
@@ -1386,20 +1508,29 @@
 	int ret;
 
 	/* Never committed, see qca8k_port_vlan_add(): the tag_8021q range,
-	 * and a VLAN-unaware bridge's VLANs (PVID/untagged) on a user port.
-	 * The rest was committed and goes; a VLAN-aware bridge's PVID stays
-	 * in the register, where the secure lookup now drops untagged frames
-	 * as the bridge would, and is forgotten here.
+	 * VID 0, and a VLAN-unaware bridge's VLANs on a user port. A user
+	 * port loses what it was given and nothing else - qca8k_vlan_del()
+	 * must not be asked for a VLAN the port is not in. A VLAN-aware
+	 * bridge's PVID stays in the register, where the secure lookup now
+	 * drops untagged frames as the bridge would, and is forgotten here.
 	 */
 	if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q) {
-		if (vid_is_dsa_8021q(vlan->vid))
+		if (vid_is_dsa_8021q(vlan->vid) || !vlan->vid)
 			return 0;
-		if (dsa_is_user_port(ds, port) &&
-		    !dsa_port_is_vlan_filtering(dsa_to_port(ds, port)) &&
-		    (vlan->flags & (BRIDGE_VLAN_INFO_PVID | BRIDGE_VLAN_INFO_UNTAGGED)))
-			return 0;
-		if (priv->bridge_pvid[port] == vlan->vid)
-			priv->bridge_pvid[port] = 0;
+
+		if (dsa_is_user_port(ds, port)) {
+			bool bridge_vlan = vlan->obj.orig_dev;
+			unsigned long *vlans;
+
+			vlans = bridge_vlan ? priv->bridge_vlans[port] :
+					      priv->upper_vlans[port];
+			if (!test_bit(vlan->vid, vlans))
+				return 0;
+			__clear_bit(vlan->vid, vlans);
+
+			if (bridge_vlan && priv->bridge_pvid[port] == vlan->vid)
+				priv->bridge_pvid[port] = 0;
+		}
 	}
 
 	ret = qca8k_vlan_del(priv, port, vlan->vid);
