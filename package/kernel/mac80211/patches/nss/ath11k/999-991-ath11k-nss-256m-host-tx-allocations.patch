From: Georg Seema <georgseema@gmail.com>
Subject: [PATCH] wifi: ath11k: skip unused host TX arrays in the NSS 256 MiB profile

Add an optional profile for IPQ5018 and QCN6122 with the 256M memory
profile and active NSS. Skip unused host TX software arrays, retain DMA
rings, and guard cleanup and completion paths. Keep the allocation
decision stable through recovery. Other hardware keeps normal arrays.

Signed-off-by: Georg Seema <georgseema@gmail.com>
---
--- a/local-symbols
+++ b/local-symbols
@@ -509,3 +509,4 @@
 USB_TMC=
 STAGING=
 RTL8723BS=
+ATH11K_NSS_MEM_PROFILE_256M=
--- a/drivers/net/wireless/ath/ath11k/Kconfig
+++ b/drivers/net/wireless/ath/ath11k/Kconfig
@@ -120,3 +120,14 @@
 	depends on THERMAL
 	help
 	  Enable ath11k thermal sensors and throttling support.
+
+config ATH11K_NSS_MEM_PROFILE_256M
+	bool "Smaller NSS allocations for 256 MiB IPQ5018/QCN6122 devices"
+	depends on ATH11K_NSS_SUPPORT && ATH11K_MEM_PROFILE_256M
+	default n
+	help
+	  Skip unused host TX arrays, reduce NSS TX pools and completion
+	  rings, use private RX fragment caches, and reduce CE5 buffers.
+	  Only IPQ5018 and QCN6122 with active NSS use this profile.
+	  TX and CE5 queue capacity is lower. Other hardware and the
+	  host-only data path retain their existing allocations.
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -1400,6 +1400,16 @@
 	return "unknown";
 }
 
+/* Keep untested hardware and the host data path on their normal sizes. */
+static inline bool ath11k_nss_256m_enabled(struct ath11k_base *ab)
+{
+	return IS_ENABLED(CPTCFG_ATH11K_NSS_MEM_PROFILE_256M) &&
+	       IS_ENABLED(CPTCFG_ATH11K_MEM_PROFILE_256M) &&
+	       ab->nss.enabled &&
+	       (ab->hw_rev == ATH11K_HW_IPQ5018_HW10 ||
+		ab->hw_rev == ATH11K_HW_QCN6122_HW10);
+}
+
 static inline struct ath11k_skb_cb *ATH11K_SKB_CB(struct sk_buff *skb)
 {
 	BUILD_BUG_ON(sizeof(struct ath11k_skb_cb) >
