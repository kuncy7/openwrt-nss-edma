+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 802.1Q VLAN-based tag driver for the Motorcomm YT921x switches, built on
+ * the tag_8021q framework: the source port travels in a VLAN tag the switch
+ * itself inserts, instead of the 8-byte Motorcomm CPU tag that only the
+ * switch and tag_yt921x understand. That keeps the conduit's frames plain
+ * 802.1Q, which any MAC - and the Qualcomm NSS firmware in front of the
+ * IPQ5018 GMAC - parses natively.
+ *
+ * Same wire format and much the same code as tag_an8855_8021q,
+ * tag_qca_8021q and tag_rtl8365mb_8021q; only the switch side differs
+ * (yt921x_dsa_change_tag_protocol and the tag_8021q_vlan_add/del hooks in
+ * drivers/net/dsa/yt921x.c).
+ */
+#include <linux/dsa/8021q.h>
+#include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
+#include <net/dsa.h>
+
+#include "tag.h"
+#include "tag_8021q.h"
+
+#define YT921X_8021Q_NAME "yt921x-8021q"
+
+/* @dev's own 802.1Q upper with this VID, if any. */
+static struct net_device *yt921x_8021q_vlan_upper_of(struct net_device *dev,
+						     __be16 proto, u16 vid)
+{
+	struct net_device *upper;
+	struct list_head *iter;
+
+	netdev_for_each_upper_dev_rcu(dev, upper, iter) {
+		if (is_vlan_dev(upper) && vlan_dev_vlan_proto(upper) == proto &&
+		    vlan_dev_vlan_id(upper) == vid)
+			return upper;
+	}
+
+	return NULL;
+}
+
+/* Did an 802.1Q upper of this port tag the frame already? */
+static bool yt921x_8021q_upper_tagged(struct sk_buff *skb,
+				      struct net_device *netdev)
+{
+	u16 tci;
+
+	if (skb_vlan_tag_present(skb))
+		return !vid_is_dsa_8021q(skb_vlan_tag_get_id(skb));
+
+	if (skb->offload_fwd_mark || skb->protocol != htons(ETH_P_8021Q) ||
+	    __vlan_get_tag(skb, &tci))
+		return false;
+
+	tci &= VLAN_VID_MASK;
+	return !vid_is_dsa_8021q(tci) &&
+	       yt921x_8021q_vlan_upper_of(netdev, htons(ETH_P_8021Q), tci);
+}
+
+static struct sk_buff *yt921x_8021q_xmit(struct sk_buff *skb,
+					 struct net_device *netdev)
+{
+	struct dsa_port *dp = dsa_user_to_port(netdev);
+	u16 queue_mapping = skb_get_queue_mapping(skb);
+	u16 tx_vid = dsa_tag_8021q_standalone_vid(dp);
+	u8 pcp;
+
+	if (skb->offload_fwd_mark) {
+		unsigned int bridge_num = dsa_port_bridge_num_get(dp);
+		struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+		/* A VLAN-aware bridge carries its own VID. */
+		if (br_vlan_enabled(br))
+			return skb;
+
+		tx_vid = dsa_tag_8021q_bridge_vid(bridge_num);
+	}
+
+	if (yt921x_8021q_upper_tagged(skb, netdev))
+		return skb;
+
+	pcp = netdev_txq_to_tc(netdev, queue_mapping);
+
+	return dsa_8021q_xmit(skb, netdev, ETH_P_8021Q,
+			      ((pcp << VLAN_PRIO_SHIFT) | tx_vid));
+}
+
+/* The user port that owns an 802.1Q upper with this VID. */
+static struct net_device *yt921x_8021q_find_vlan_upper(struct net_device *conduit,
+						       __be16 proto, u16 vid)
+{
+	struct dsa_port *cpu_dp = conduit->dsa_ptr;
+	struct dsa_port *dp;
+
+	dsa_tree_for_each_user_port(dp, cpu_dp->dst) {
+		if (dp->cpu_dp != cpu_dp)
+			continue;
+		if (yt921x_8021q_vlan_upper_of(dp->user, proto, vid))
+			return dp->user;
+	}
+
+	return NULL;
+}
+
+static struct sk_buff *yt921x_8021q_rcv(struct sk_buff *skb,
+					struct net_device *netdev)
+{
+	int src_port = -1, switch_id = -1, vbid = -1, vid = -1;
+
+	/* The conduit is promiscuous for the tag_8021q VIDs and passes MAC
+	 * control frames up too; nothing above wants PAUSE.
+	 */
+	if (unlikely(eth_hdr(skb)->h_proto == htons(ETH_P_PAUSE)))
+		return NULL;
+
+	dsa_8021q_rcv(skb, &src_port, &switch_id, &vbid, &vid);
+
+	if (vid >= 0 && !vid_is_dsa_8021q(vid) && skb_vlan_tag_present(skb))
+		skb->dev = yt921x_8021q_find_vlan_upper(netdev, skb->vlan_proto,
+							vid);
+	else
+		skb->dev = dsa_tag_8021q_find_user(netdev, src_port, switch_id,
+						   vid, vbid);
+	if (!skb->dev) {
+		net_warn_ratelimited("%s: dropped frame from %pM proto 0x%04x: src_port=%d switch_id=%d vid=%d vbid=%d\n",
+				     netdev->name, eth_hdr(skb)->h_source,
+				     ntohs(eth_hdr(skb)->h_proto), src_port,
+				     switch_id, vid, vbid);
+		return NULL;
+	}
+
+	dsa_default_offload_fwd_mark(skb);
+
+	return skb;
+}
+
+static const struct dsa_device_ops yt921x_8021q_netdev_ops = {
+	.name			= YT921X_8021Q_NAME,
+	.proto			= DSA_TAG_PROTO_YT921X_8021Q,
+	.xmit			= yt921x_8021q_xmit,
+	.rcv			= yt921x_8021q_rcv,
+	.needed_headroom	= VLAN_HLEN,
+	.promisc_on_conduit	= true,
+};
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("DSA tag driver for Motorcomm YT921x switches, using VLAN");
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_YT921X_8021Q, YT921X_8021Q_NAME);
+
+module_dsa_tag_driver(yt921x_8021q_netdev_ops);
