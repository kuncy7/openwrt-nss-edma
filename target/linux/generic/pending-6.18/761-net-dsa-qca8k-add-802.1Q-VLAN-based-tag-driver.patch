 }
 
+static int qca8k_set_hdr_mode(struct qca8k_priv *priv, u32 mode)
+{
+	struct dsa_port *dp;
+	int ret;
+
+	dsa_switch_for_each_cpu_port(dp, priv->ds) {
+		ret = qca8k_write(priv, QCA8K_REG_PORT_HDR_CTRL(dp->index),
+				  FIELD_PREP(QCA8K_PORT_HDR_CTRL_TX_MASK, mode) |
+				  FIELD_PREP(QCA8K_PORT_HDR_CTRL_RX_MASK, mode));
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* tag_8021q wants every port VLAN-aware: an untagged frame then takes the
+ * port's tag_8021q PVID and reaches the CPU port tagged with it. That
+ * second half needs the port's egress mode set to "untouched", so the
+ * VLAN table's per-port tag/untag bits decide what leaves a port; the
+ * reset default, "unmodified", sends every frame out the way it came in,
+ * and the CPU never sees a tag. With the Atheros header the ports go back
+ * to port-based forwarding, except where a bridge asked for VLAN
+ * filtering itself.
+ */
+static int qca8k_set_tag_8021q_vlan_mode(struct qca8k_priv *priv, bool on)
+{
+	struct dsa_port *dp;
+	u32 mode, mask;
+	int ret;
+
+	dsa_switch_for_each_available_port(dp, priv->ds) {
+		if (on || dsa_port_is_vlan_filtering(dp))
+			mode = QCA8K_PORT_LOOKUP_VLAN_MODE_SECURE;
+		else
+			mode = QCA8K_PORT_LOOKUP_VLAN_MODE_NONE;
+
+		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(dp->index),
+				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK, mode);
+		if (ret)
+			return ret;
+
+		ret = qca8k_rmw(priv, QCA8K_REG_PORT_VLAN_CTRL1(dp->index),
+				QCA8K_PORT_VLAN_CTRL1_EG_MODE_MASK,
+				on ? QCA8K_PORT_VLAN_CTRL1_EG_MODE_UNTOUCH :
+				     QCA8K_PORT_VLAN_CTRL1_EG_MODE_UNMOD);
+		if (ret)
+			return ret;
+	}
+
+	/* With the Atheros header every frame from the CPU names its
+	 * destination ports and skips the lookup, so flooding only ever
+	 * has to reach the CPU. Without it a broadcast or an unknown
+	 * unicast from the CPU goes wherever the flood masks say, and
+	 * "the CPU ports" means nowhere: open them to every port, and let
+	 * the VLAN table keep a flood inside its VLAN.
+	 */
+	mask = on ? dsa_user_ports(priv->ds) | dsa_cpu_ports(priv->ds) :
+		    dsa_cpu_ports(priv->ds);
+
+	return qca8k_write(priv, QCA8K_REG_GLOBAL_FW_CTRL1,
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_IGMP_DP_MASK, mask) |
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_BC_DP_MASK, mask) |
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_MC_DP_MASK, mask) |
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_UC_DP_MASK, mask));
+}
+
+static int qca8k_change_tag_protocol(struct dsa_switch *ds,
+				     enum dsa_tag_protocol proto)
+{
+	struct qca8k_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	int ret;
+
+	if (proto == priv->tag_proto)
+		return 0;
+
+	switch (proto) {
+	case DSA_TAG_PROTO_QCA:
+		dsa_tag_8021q_unregister(ds);
+		priv->tag_proto = proto;
+
+		ret = qca8k_set_tag_8021q_vlan_mode(priv, false);
+		if (ret)
+			return ret;
+
+		/* The user ports go back to the default VID */
+		dsa_switch_for_each_user_port(dp, ds) {
+			ret = qca8k_port_set_pvid(priv, dp->index,
+						  QCA8K_PORT_VID_DEF);
+			if (ret)
+				return ret;
+		}
+
+		return qca8k_set_hdr_mode(priv, QCA8K_PORT_HDR_CTRL_ALL);
+	case DSA_TAG_PROTO_QCA_8021Q:
+		/* Management frames need the Atheros header; from here on
+		 * every register access goes over MDIO.
+		 */
+		mutex_lock(&priv->mgmt_eth_data.mutex);
+		mutex_lock(&priv->mib_eth_data.mutex);
+		priv->mgmt_conduit = NULL;
+		mutex_unlock(&priv->mib_eth_data.mutex);
+		mutex_unlock(&priv->mgmt_eth_data.mutex);
+
+		ret = qca8k_set_hdr_mode(priv, QCA8K_PORT_HDR_CTRL_NONE);
+		if (ret)
+			return ret;
+
+		ret = qca8k_set_tag_8021q_vlan_mode(priv, true);
+		if (ret)
+			goto restore_hdr;
+
+		priv->tag_proto = proto;
+		ret = dsa_tag_8021q_register(ds, htons(ETH_P_8021Q));
+		if (ret)
+			goto restore_vlan;
+
+		return 0;
+	default:
+		return -EPROTONOSUPPORT;
+	}
+
+restore_vlan:
+	priv->tag_proto = DSA_TAG_PROTO_QCA;
+	qca8k_set_tag_8021q_vlan_mode(priv, false);
+restore_hdr:
+	qca8k_set_hdr_mode(priv, QCA8K_PORT_HDR_CTRL_ALL);
+	return ret;
+}
+
 static void qca8k_setup_hol_fixup(struct qca8k_priv *priv, int port)
 {
 	u32 mask;
@@ -2110,6 +2249,13 @@
 	/* HW learn on CPU port is limited and require manual setting */
 	ds->assisted_learning_on_cpu_port = true;
 
+	/* The Atheros header is on (above); tag_8021q comes through
+	 * change_tag_protocol when a conduit asks for it. It tells bridges
+	 * apart by number, and DSA hands those out only up to this many.
+	 */
+	priv->tag_proto = DSA_TAG_PROTO_QCA;
+	ds->max_num_bridges = DSA_TAG_8021Q_MAX_NUM_BRIDGES;
+
 	return 0;
 }
 
@@ -2122,6 +2268,7 @@
 
 static const struct dsa_switch_ops qca8k_switch_ops = {
 	.get_tag_protocol	= qca8k_get_tag_protocol,
+	.change_tag_protocol	= qca8k_change_tag_protocol,
 	.setup			= qca8k_setup,
 	.get_strings		= qca8k_get_strings,
 	.get_ethtool_stats	= qca8k_get_ethtool_stats,
@@ -2151,6 +2298,8 @@
 	.port_vlan_filtering	= qca8k_port_vlan_filtering,
 	.port_vlan_add		= qca8k_port_vlan_add,
 	.port_vlan_del		= qca8k_port_vlan_del,
+	.tag_8021q_vlan_add	= qca8k_tag_8021q_vlan_add,
+	.tag_8021q_vlan_del	= qca8k_tag_8021q_vlan_del,
 	.phylink_get_caps	= qca8k_phylink_get_caps,
 	.get_phy_flags		= qca8k_get_phy_flags,
 	.port_lag_join		= qca8xxx_port_lag_join,
--- a/drivers/net/dsa/qca/qca8k-common.c
+++ b/drivers/net/dsa/qca/qca8k-common.c
@@ -9,6 +9,7 @@
 #include <linux/netdevice.h>
 #include <net/dsa.h>
 #include <linux/if_bridge.h>
+#include <linux/dsa/8021q.h>
 
 #include "qca8k.h"
 
@@ -700,8 +701,21 @@
 			   struct netlink_ext_ack *extack)
 {
 	struct qca8k_priv *priv = ds->priv;
+	int ret;
+
+	ret = qca8k_update_port_member(priv, port, bridge.dev, true);
+	if (ret)
+		return ret;
 
-	return qca8k_update_port_member(priv, port, bridge.dev, true);
+	/* Under tag_8021q the port swaps its standalone VLAN for the
+	 * bridge's, so the switch forwards between the bridge's ports on
+	 * its own and the CPU can send to all of them with one tag.
+	 */
+	if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q)
+		return dsa_tag_8021q_bridge_join(ds, port, bridge,
+						 tx_fwd_offload, extack);
+
+	return 0;
 }
 
 void qca8k_port_bridge_leave(struct dsa_switch *ds, int port,
@@ -710,6 +724,9 @@
 	struct qca8k_priv *priv = ds->priv;
 	int err;
 
+	if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q)
+		dsa_tag_8021q_bridge_leave(ds, port, bridge);
+
 	err = qca8k_update_port_member(priv, port, bridge.dev, false);
 	if (err)
 		dev_err(priv->dev,
@@ -822,6 +839,25 @@
 			     QCA8K_ATU_STATUS_STATIC);
 }
 
+/* Under tag_8021q every lookup happens in the port's tag_8021q VLAN,
+ * so an entry the bridge hands over without a VID has to go there and
+ * not to the port default VID, where nothing would ever find it.
+ */
+static u16 qca8k_db_vid(struct qca8k_priv *priv, struct dsa_db db, u16 vid)
+{
+	if (vid || priv->tag_proto != DSA_TAG_PROTO_QCA_8021Q)
+		return vid;
+
+	switch (db.type) {
+	case DSA_DB_BRIDGE:
+		return dsa_tag_8021q_bridge_vid(db.bridge.num);
+	case DSA_DB_PORT:
+		return dsa_tag_8021q_standalone_vid(db.dp);
+	default:
+		return vid;
+	}
+}
+
 int qca8k_port_fdb_add(struct dsa_switch *ds, int port,
 		       const unsigned char *addr, u16 vid,
 		       struct dsa_db db)
@@ -840,7 +876,8 @@
 	if (dsa_is_cpu_port(ds, port) || dsa_is_dsa_port(ds, port))
 		return 0;
 
-	return qca8k_port_fdb_insert(priv, addr, port_mask, vid);
+	return qca8k_port_fdb_insert(priv, addr, port_mask,
+				     qca8k_db_vid(priv, db, vid));
 }
 
 int qca8k_port_fdb_del(struct dsa_switch *ds, int port,
@@ -853,6 +890,7 @@
 	if (dsa_is_cpu_port(ds, port) || dsa_is_dsa_port(ds, port))
 		return 0;
 
+	vid = qca8k_db_vid(priv, db, vid);
 	if (!vid)
 		vid = QCA8K_PORT_VID_DEF;
 
@@ -888,7 +926,7 @@
 {
 	struct qca8k_priv *priv = ds->priv;
 	const u8 *addr = mdb->addr;
-	u16 vid = mdb->vid;
+	u16 vid = qca8k_db_vid(priv, db, mdb->vid);
 
 	if (!vid)
 		vid = QCA8K_PORT_VID_DEF;
@@ -903,7 +941,7 @@
 {
 	struct qca8k_priv *priv = ds->priv;
 	const u8 *addr = mdb->addr;
-	u16 vid = mdb->vid;
+	u16 vid = qca8k_db_vid(priv, db, mdb->vid);
 
 	if (!vid)
 		vid = QCA8K_PORT_VID_DEF;
@@ -1002,6 +1040,21 @@
 	dev_err(priv->dev, "Failed to del mirror port from %d", port);
 }
 
+int qca8k_port_set_pvid(struct qca8k_priv *priv, int port, u16 vid)
+{
+	int ret;
+
+	ret = qca8k_rmw(priv, QCA8K_EGRESS_VLAN(port),
+			QCA8K_EGREES_VLAN_PORT_MASK(port),
+			QCA8K_EGREES_VLAN_PORT(port, vid));
+	if (ret)
+		return ret;
+
+	return qca8k_write(priv, QCA8K_REG_PORT_VLAN_CTRL0(port),
+			   QCA8K_PORT_VLAN_CVID(vid) |
+			   QCA8K_PORT_VLAN_SVID(vid));
+}
+
 int qca8k_port_vlan_filtering(struct dsa_switch *ds, int port,
 			      bool vlan_filtering,
 			      struct netlink_ext_ack *extack)
@@ -1009,6 +1062,20 @@
 	struct qca8k_priv *priv = ds->priv;
 	int ret;
 
+	/* tag_8021q needs the ports VLAN-aware all the time: that is how
+	 * the switch tells the CPU where a frame came from. A bridge that
+	 * wants to run its own VLANs on top would have to share the port's
+	 * PVID with tag_8021q, which is not handled yet.
+	 */
+	if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q) {
+		if (vlan_filtering) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "VLAN-aware bridges are not supported with the qca-8021q tagger yet");
+			return -EOPNOTSUPP;
+		}
+		return 0;
+	}
+
 	if (vlan_filtering) {
 		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(port),
 				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
@@ -1031,24 +1098,65 @@
 	struct qca8k_priv *priv = ds->priv;
 	int ret;
 
+	if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q) {
+		if (vid_is_dsa_8021q(vlan->vid)) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "Range 3072-4095 reserved for dsa_8021q operation");
+			return -EBUSY;
+		}
+
+		/* A VLAN-unaware bridge still hands its VLANs over (VID 1,
+		 * PVID, untagged, by default). They stay in software here:
+		 * the port's tag_8021q VLAN carries its traffic, and the
+		 * bridge's PVID would replace the one tag_8021q set.
+		 */
+		if (!dsa_port_is_vlan_filtering(dsa_to_port(ds, port)))
+			return 0;
+	}
+
 	ret = qca8k_vlan_add(priv, port, vlan->vid, untagged);
 	if (ret) {
 		dev_err(priv->dev, "Failed to add VLAN to port %d (%d)", port, ret);
 		return ret;
 	}
 
-	if (pvid) {
-		ret = qca8k_rmw(priv, QCA8K_EGRESS_VLAN(port),
-				QCA8K_EGREES_VLAN_PORT_MASK(port),
-				QCA8K_EGREES_VLAN_PORT(port, vlan->vid));
-		if (ret)
-			return ret;
+	if (pvid)
+		ret = qca8k_port_set_pvid(priv, port, vlan->vid);
 
-		ret = qca8k_write(priv, QCA8K_REG_PORT_VLAN_CTRL0(port),
-				  QCA8K_PORT_VLAN_CVID(vlan->vid) |
-				  QCA8K_PORT_VLAN_SVID(vlan->vid));
+	return ret;
+}
+
+int qca8k_tag_8021q_vlan_add(struct dsa_switch *ds, int port, u16 vid,
+			     u16 flags)
+{
+	bool untagged = flags & BRIDGE_VLAN_INFO_UNTAGGED;
+	bool pvid = flags & BRIDGE_VLAN_INFO_PVID;
+	struct qca8k_priv *priv = ds->priv;
+	int ret;
+
+	ret = qca8k_vlan_add(priv, port, vid, untagged);
+	if (ret) {
+		dev_err(priv->dev, "Failed to add tag_8021q VLAN %d to port %d (%d)",
+			vid, port, ret);
+		return ret;
 	}
 
+	if (pvid)
+		ret = qca8k_port_set_pvid(priv, port, vid);
+
+	return ret;
+}
+
