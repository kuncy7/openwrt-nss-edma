+	if (addr4_valid)
+		ath11k_nss_wds_learn_sa(ar, dev, vif, ta_peer, src_mac,
+					is_sa_valid);
 
 	spin_unlock_bh(&ab->base_lock);
 }
@@ -1102,6 +1113,37 @@ ath11k_nss_ext_vdev_special_data_receive
 	dev_kfree_skb_any(skb);
 }
 
+/* The NSS firmware does not send WDS_LEARN for a station bound to a WDS ext
+ * vdev: a frame from an address with no AST entry comes up on the ext vdev
+ * as plain data. Learn the address here, or frames to a device behind the
+ * station are never sent.
+ */
+static void ath11k_nss_ext_vdev_wds_learn(struct ath11k_vif *arvif,
+					  struct net_device *dev,
+					  struct sk_buff *skb)
+{
+	struct ath11k *ar = arvif->ar;
+	struct ath11k_base *ab = ar->ab;
+	int peer_id = READ_ONCE(arvif->nss.wds_peer_id);
+	struct ath11k_peer *peer;
+	u8 *sa;
+
+	if (peer_id < 0 || skb->len < ETH_HLEN)
+		return;
+
+	sa = ((struct ethhdr *)skb->data)->h_source;
+	if (!is_valid_ether_addr(sa))
+		return;
+
+	spin_lock_bh(&ab->base_lock);
+	peer = ath11k_peer_find_by_id(ar, peer_id);
+	if (peer && peer->nss.ext_vif == arvif->vif &&
+	    !ether_addr_equal(sa, peer->addr) &&
+	    !ath11k_peer_ast_find_by_peer(ar, peer, sa))
+		ath11k_nss_wds_learn_sa(ar, dev, arvif->vif, peer, sa, 1);
+	spin_unlock_bh(&ab->base_lock);
+}
+
 static void
 ath11k_nss_ext_vdev_data_receive(struct net_device *dev, struct sk_buff *skb,
 				 __attribute__((unused)) struct napi_struct *napi)
@@ -1134,6 +1176,9 @@ ath11k_nss_ext_vdev_data_receive(struct
 		return;
 	}
 
+	if (eth_decap)
+		ath11k_nss_ext_vdev_wds_learn(arvif, dev, skb);
+
 	ath11k_nss_deliver_rx(arvif->vif, skb, eth_decap, data_offs, napi);
 }
 
@@ -3379,6 +3424,8 @@ int ath11k_nss_ext_vdev_create(struct at
 	if (ret)
 		return ret;
 
+	WRITE_ONCE(arvif->nss.wds_peer_id, -1);
+
 	ret = ath11k_nss_ext_vdev_register(arvif, wdev->netdev);
 	if (ret)
 		goto free_ext_vdev;
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -5553,6 +5553,8 @@ skip_nss_ext:
 	wds_peer->nss.ext_vif = vif;
 	spin_unlock_bh(&ab->base_lock);
 
+	WRITE_ONCE(ap_vlan_arvif->nss.wds_peer_id, wds_peer_id);
+
 	/* NAWDS and CFG_WDS_BACKHAUL configs should be done on corresponding
 	 * AP vif of the AP_VLAN vif
 	 */
