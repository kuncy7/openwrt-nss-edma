# Group "256m": boards with 256 MB of RAM. ath11k host profile 256M (the 512M profile with smaller
# RXDMA rings) + NSS LOW.
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_NSS_MEM_PROFILE_LOW=y
# NSS firmware 12.2-156: with 12.5-210 some 802.11ac clients leave payload buffers in the
# firmware round after round, which the small pool of a 256 MB board cannot afford; 12.2-156
# gives them back with the same client (kuncy7/openwrt-nss-edma#64).
CONFIG_NSS_FIRMWARE_VERSION_12_2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_cudy_p5=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-nx30=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v1=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v3=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_ruijie_rg-ma3063=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_tplink_archer-ax53-v2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_tplink_archer-ax58-v2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_tplink_ex511-v2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_cr8806=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_mi-router-ax3000t-v2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_ra80=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax3000-ubootmod=y
