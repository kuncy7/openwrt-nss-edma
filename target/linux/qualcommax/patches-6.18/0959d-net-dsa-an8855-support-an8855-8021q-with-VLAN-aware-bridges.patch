From: Adriel Santos <adriel@adriel.eu>
Subject: [PATCH] net: dsa: an8855: support an8855-8021q with VLAN-aware bridges

Fill in the switch side of the an8855-8021q mode: disable the CPU special
tag and use the VLAN table for user-port forwarding and CPU tagging, and
save the register state so that returning to the MediaTek tag restores it.

Track bridge and tagger PVIDs separately, keep the VLANs of a bridge that
is not VLAN-aware inactive, and replay their membership when filtering is
enabled. A port of a VLAN-unaware bridge forwards tagged frames as they
are, as mt7530 does. Support tagged VLAN uppers and tagged or untagged
bridge members, with unique customer VID ownership and reserved-VID and
protocol checks.

Make a bridge-wide filtering change one hardware transaction that is
undone as a whole on failure, and unwind partial VLAN programming
failures. Other state changes are not transactional across callbacks: if
a bridge leave fails to drop filtering, shut the port and finish the
leave on the core's filtering reset that follows. Keep VLAN-upper RX
filtering through bridge transitions and keep per-port transmit VLANs for
directed frames. Clear the egress tagging of the link-local trap rules,
so that trapped frames follow the VLAN table and reach the CPU with a
tag_8021q VID.

Bridge RX identifies the bridge rather than the physical ingress port.

Signed-off-by: Adriel Santos <adriel@adriel.eu>
Assisted-by: Claude
---
--- a/drivers/net/dsa/an8855.c
+++ b/drivers/net/dsa/an8855.c
@@ -10,6 +10,7 @@
 #include <linux/etherdevice.h>
 #include <linux/gpio/consumer.h>
 #include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
 #include <linux/iopoll.h>
 #include <linux/netdevice.h>
 #include <linux/of_net.h>
@@ -357,26 +358,71 @@ static u16 an8855_db_vid(struct an8855_p
 	}
 }
 
+static int an8855_port_set_pid(struct an8855_priv *priv, int port, u16 pid);
+static int an8855_port_set_status(struct an8855_priv *priv, int port, bool enable);
+static int an8855_8021q_port_tx_vlan(struct an8855_priv *priv, int port);
+static int an8855_8021q_set_filtering(struct dsa_switch *ds, int port, bool on,
+				     struct netlink_ext_ack *extack);
+static int an8855_8021q_commit_pvid(struct an8855_priv *priv, int port);
+
 static int an8855_port_bridge_join(struct dsa_switch *ds, int port,
 				   struct dsa_bridge bridge,
 				   bool *tx_fwd_offload,
 				   struct netlink_ext_ack *extack)
 {
 	struct an8855_priv *priv = ds->priv;
+	u16 old_pvid = priv->tag_8021q_pvid[port];
+	u16 proto;
 	int ret;
 
+	if (an8855_is_8021q(priv)) {
+		ret = br_vlan_get_proto(bridge.dev, &proto);
+		if (ret)
+			return ret;
+		if (proto != ETH_P_8021Q) {
+			NL_SET_ERR_MSG_MOD(extack, "an8855-8021q requires an 802.1Q bridge");
+			return -EOPNOTSUPP;
+		}
+	}
+
 	ret = an8855_update_port_member(ds, port, bridge.dev, true);
-	if (ret)
+	if (ret) {
+		an8855_update_port_member(ds, port, bridge.dev, false);
 		return ret;
+	}
 
 	/* 8021q mode: the port trades its standalone VID for the bridge's;
 	 * tag_8021q calls an8855_tag_8021q_vlan_del/_add for the swap.
-	 * TODO(switch side): the port must not drop into fallback mode
-	 * below - it stays in the mode an8855_8021q_port_mode() set.
+	 * The port stays in the security mode an8855_8021q_port_mode() set.
 	 */
-	if (an8855_is_8021q(priv))
-		return dsa_tag_8021q_bridge_join(ds, port, bridge,
-						 tx_fwd_offload, extack);
+	if (an8855_is_8021q(priv)) {
+		ret = an8855_8021q_set_filtering(ds, port, br_vlan_enabled(bridge.dev),
+						extack);
+		if (ret) {
+			an8855_update_port_member(ds, port, bridge.dev, false);
+			return ret;
+		}
+		ret = dsa_tag_8021q_bridge_join(ds, port, bridge,
+					      tx_fwd_offload, extack);
+		if (!ret) {
+			/* Direct TX (STP/LLDP) still uses the standalone VID. */
+			ret = an8855_8021q_port_tx_vlan(priv, port);
+			if (ret)
+				dsa_tag_8021q_bridge_leave(ds, port, bridge);
+		}
+		if (ret) {
+			set_bit(port, &priv->bridge_undo);
+			an8855_8021q_set_filtering(ds, port, false, NULL);
+			an8855_update_port_member(ds, port, bridge.dev, false);
+			/* Restore user membership if deleting the old CPU VID failed. */
+			an8855_8021q_port_tx_vlan(priv, port);
+			/* The new user PVID may have preceded a failed CPU add. */
+			priv->tag_8021q_pvid[port] = old_pvid;
+			an8855_8021q_commit_pvid(priv, port);
+			clear_bit(port, &priv->bridge_undo);
+		}
+		return ret;
+	}
 
 	/* Set to fallback mode for independent VLAN learning if in a bridge */
 	return regmap_update_bits(priv->regmap, AN8855_PCR_P(port),
@@ -389,19 +435,36 @@ static void an8855_port_bridge_leave(str
 				     struct dsa_bridge bridge)
 {
 	struct an8855_priv *priv = ds->priv;
+	int ret;
 
 	/* The bridge core does not clear BR_ISOLATED when a port leaves */
 	priv->port_isolated_map &= ~BIT(port);
-	an8855_update_port_member(ds, port, bridge.dev, false);
+	ret = an8855_update_port_member(ds, port, bridge.dev, false);
+	if (ret)
+		dev_err(priv->dev, "port %d: failed to leave port matrix: %d\n", port, ret);
 
 	/* 8021q mode: back to the standalone VID.
-	 * TODO(switch side): a VLAN-aware bridge's PVID leaves with the
-	 * bridge and the tag_8021q PVID has to be the one in the register
-	 * again (shadow PVIDs); the port keeps its 8021q port mode instead
-	 * of the matrix mode below.
+	 * Keep security mode instead of restoring matrix mode below.
 	 */
 	if (an8855_is_8021q(priv)) {
+		set_bit(port, &priv->bridge_undo);
+		ret = an8855_8021q_set_filtering(ds, port, false, NULL);
+		if (ret) {
+			/* Keep the shadow and shut the port until a later
+			 * filtering callback, such as the core's reset after
+			 * this leave, finishes the cleanup.
+			 */
+			dev_err(priv->dev, "port %d: failed to leave VLAN filtering: %d\n",
+				port, ret);
+			set_bit(port, &priv->leave_pending);
+			an8855_port_set_status(priv, port, false);
+		} else {
+			bitmap_zero(priv->bridge_vlans[port], VLAN_N_VID);
+			bitmap_zero(priv->bridge_untagged[port], VLAN_N_VID);
+			priv->bridge_pvid[port] = 0;
+		}
 		dsa_tag_8021q_bridge_leave(ds, port, bridge);
+		clear_bit(port, &priv->bridge_undo);
 		return;
 	}
 
@@ -575,13 +638,12 @@ static int an8855_vlan_add(struct an8855
 	if (ret)
 		return ret;
 
-	/* CPU port is always taken as a tagged port for serving more than one
-	 * VLANs across and also being applied with egress type stack mode for
-	 * that VLAN tags would be appended after hardware special tag used as
-	 * DSA tag.
+	/* The VLAN tag follows the special tag in MTK mode. With tag_8021q,
+	 * the special tag is disabled and this is the only tag on the wire.
 	 */
-	if (port == AN8855_CPU_PORT)
-		val = AN8855_VLAN_EGRESS_STACK;
+	if (dsa_is_cpu_port(priv->ds, port))
+		val = an8855_is_8021q(priv) ? AN8855_VLAN_EGRESS_TAG :
+					   AN8855_VLAN_EGRESS_STACK;
 	/* Decide whether adding tag or not for those outgoing packets from the
 	 * port inside the VLAN.
 	 */
@@ -732,6 +794,431 @@ static int an8855_port_commit_vlan(struc
 	return an8855_port_set_pid(priv, port, pvid);
 }
 
+struct an8855_vlan_transaction {
+	struct {
+		u32 pcr, pvc, ppbv, pvid;
+	} ports[AN8855_NUM_PORTS];
+	unsigned long port_mask;
+	unsigned int count;
+	struct {
+		u16 vid;
+		u32 value;
+	} rows[];
+};
+
+static int an8855_vlan_transaction_capture_port(struct an8855_priv *priv,
+						 struct an8855_vlan_transaction *state,
+						 int port)
+{
+	int ret;
+
+	ret = regmap_read(priv->regmap, AN8855_PCR_P(port), &state->ports[port].pcr);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->regmap, AN8855_PVC_P(port), &state->ports[port].pvc);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->regmap, AN8855_PPBV1_P(port), &state->ports[port].ppbv);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->regmap, AN8855_PVID_P(port), &state->ports[port].pvid);
+	if (ret)
+		return ret;
+	set_bit(port, &state->port_mask);
+	return 0;
+}
+
+static int an8855_vlan_transaction_begin(struct an8855_priv *priv, int port,
+					 const unsigned long *vids,
+					 struct an8855_vlan_transaction **result)
+	__must_hold(&priv->reg_mutex)
+{
+	struct an8855_vlan_transaction *state;
+	unsigned long vid;
+	unsigned int count = bitmap_weight(vids, VLAN_N_VID), i = 0;
+	int ret;
+
+	state = kzalloc(struct_size(state, rows, count), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	ret = an8855_vlan_transaction_capture_port(priv, state, port);
+	if (ret)
+		goto fail;
+	for_each_set_bit(vid, vids, VLAN_N_VID) {
+		state->rows[i].vid = vid;
+		ret = an8855_vlan_cmd(priv, AN8855_VTCR_RD_VID, vid);
+		if (ret)
+			goto fail;
+		ret = regmap_read(priv->regmap, AN8855_VARD0, &state->rows[i].value);
+		if (ret)
+			goto fail;
+		i++;
+	}
+	state->count = count;
+	*result = state;
+	return 0;
+fail:
+	kfree(state);
+	return ret;
+}
+
+static void an8855_vlan_transaction_restore(struct an8855_priv *priv, int port,
+					    struct an8855_vlan_transaction *state)
+	__must_hold(&priv->reg_mutex)
+{
+	unsigned int i;
+	unsigned long p;
+	int err = 0, ret;
+
+	for (i = 0; i < state->count; i++) {
+		ret = regmap_write(priv->regmap, AN8855_VAWD0, state->rows[i].value);
+		if (ret && !err)
+			err = ret;
+		ret = regmap_write(priv->regmap, AN8855_VAWD1, 0);
+		if (ret && !err)
+			err = ret;
+		ret = an8855_vlan_cmd(priv, AN8855_VTCR_WR_VID, state->rows[i].vid);
+		if (ret && !err)
+			err = ret;
+	}
+	for_each_set_bit(p, &state->port_mask, AN8855_NUM_PORTS) {
+		ret = regmap_update_bits(priv->regmap, AN8855_PCR_P(p),
+					 AN8855_PORT_VLAN, state->ports[p].pcr);
+		if (ret && !err)
+			err = ret;
+		ret = regmap_update_bits(priv->regmap, AN8855_PVC_P(p),
+					 AN8855_PVC_EG_TAG | AN8855_VLAN_ATTR | AN8855_ACC_FRM,
+					 state->ports[p].pvc);
+		if (ret && !err)
+			err = ret;
+		ret = regmap_update_bits(priv->regmap, AN8855_PPBV1_P(p),
+					 AN8855_PPBV_G0_PORT_VID, state->ports[p].ppbv);
+		if (ret && !err)
+			err = ret;
+		ret = regmap_update_bits(priv->regmap, AN8855_PVID_P(p),
+					 AN8855_G0_PORT_VID, state->ports[p].pvid);
+		if (ret && !err)
+			err = ret;
+	}
+	if (err)
+		dev_err(priv->dev, "port %d: VLAN rollback failed: %d\n", port, err);
+}
+
+/* The DSA core sets dp->bridge before .port_bridge_join and clears it only
+ * after a failed join returns, and it sends BRIDGE_LEAVE with dp->bridge
+ * still set when it unwinds a join the driver accepted. While the driver
+ * undoes a join, treat the port as standalone so that its registers end up
+ * as if it had never joined.
+ */
+static struct net_device *an8855_8021q_bridge_dev(struct an8855_priv *priv,
+						  int port)
+{
+	if (test_bit(port, &priv->bridge_undo))
+		return NULL;
+	return dsa_port_bridge_dev_get(dsa_to_port(priv->ds, port));
+}
+
+static bool an8855_8021q_is_filtering(struct an8855_priv *priv, int port)
+{
+	return test_bit(port, &priv->vlan_filtering) &&
+	       an8855_8021q_bridge_dev(priv, port);
+}
+
+/* DSA changes dp->vlan_filtering after the callback. Use our committed state. */
+static int an8855_8021q_commit_pvid(struct an8855_priv *priv, int port)
+{
+	enum an8855_vlan_port_attr attr = AN8855_VLAN_USER;
+	u16 pvid;
+	int ret;
+
+	if (!dsa_is_user_port(priv->ds, port))
+		return 0;
+	pvid = an8855_8021q_is_filtering(priv, port) ? priv->bridge_pvid[port] :
+						     priv->tag_8021q_pvid[port];
+	/* A VLAN-unaware bridge forwards tagged frames as they are. Do not
+	 * parse their tags then: they are classified into the bridge's
+	 * tag_8021q VID like untagged ones, and keep their tag as payload,
+	 * as mt7530 does for VLAN-unaware ports. An 802.1Q upper needs its
+	 * VID parsed, so a port with one stays a user port.
+	 */
+	if (an8855_8021q_bridge_dev(priv, port) &&
+	    !an8855_8021q_is_filtering(priv, port) &&
+	    bitmap_empty(priv->upper_vlans[port], VLAN_N_VID))
+		attr = AN8855_VLAN_TRANSPARENT;
+	ret = an8855_port_set_vlan_mode(priv, port, AN8855_PORT_SECURITY_MODE,
+					AN8855_VLAN_EG_DISABLED, attr,
+					pvid ? AN8855_VLAN_ACC_ALL : AN8855_VLAN_ACC_TAGGED);
+	if (ret)
+		return ret;
+	return an8855_port_set_pid(priv, port, pvid);
+}
+
+/* A real VID identifies either one upper port or one active bridge on RX. */
+static int an8855_8021q_vlan_owner(struct an8855_priv *priv, int port, u16 vid,
+				   bool bridge, bool active,
+				   struct netlink_ext_ack *extack)
+{
+	struct net_device *br = an8855_8021q_bridge_dev(priv, port);
+	struct dsa_port *other;
+
+	if (bridge && !active)
+		return 0;
+	dsa_switch_for_each_user_port(other, priv->ds) {
+		if (test_bit(vid, priv->upper_vlans[other->index]) &&
+		    (bridge || other->index != port)) {
+			NL_SET_ERR_MSG_MOD(extack, "VID belongs to a VLAN upper of another owner");
+			return -EBUSY;
+		}
+		if (!an8855_8021q_is_filtering(priv, other->index) ||
+		    !test_bit(vid, priv->bridge_vlans[other->index]))
+			continue;
+		if (!bridge || an8855_8021q_bridge_dev(priv, other->index) != br) {
+			NL_SET_ERR_MSG_MOD(extack, "VID belongs to another VLAN-aware bridge");
+			return -EBUSY;
+		}
+	}
+	return 0;
+}
+
+/* Inactive bridge VLANs stay in software; every active CPU member is tagged. */
+static int an8855_8021q_sync_vlan(struct an8855_priv *priv, u16 vid)
+	__must_hold(&priv->reg_mutex)
+{
+	struct dsa_port *dp;
+	u32 ports = 0, tags = 0, val = 0;
+	int ret;
+
+	dsa_switch_for_each_user_port(dp, priv->ds) {
+		bool upper = test_bit(vid, priv->upper_vlans[dp->index]);
+		bool bridge = an8855_8021q_is_filtering(priv, dp->index) &&
+			      test_bit(vid, priv->bridge_vlans[dp->index]);
+
+		if (!upper && !bridge)
+			continue;
+		ports |= BIT(dp->index);
+		if (upper || !test_bit(vid, priv->bridge_untagged[dp->index]))
+			tags |= AN8855_VA0_ETAG_PORT_VAL(dp->index, AN8855_VLAN_EGRESS_TAG);
+	}
+	if (ports) {
+		dsa_switch_for_each_cpu_port(dp, priv->ds) {
+			ports |= BIT(dp->index);
+			tags |= AN8855_VA0_ETAG_PORT_VAL(dp->index, AN8855_VLAN_EGRESS_TAG);
+		}
+		val = AN8855_VA0_IVL_MAC | AN8855_VA0_VTAG_EN | AN8855_VA0_VLAN_VALID |
+		      FIELD_PREP(AN8855_VA0_FID, AN8855_FID_BRIDGED) |
+		      FIELD_PREP(AN8855_VA0_PORT, ports) | tags;
+	}
+	ret = regmap_write(priv->regmap, AN8855_VAWD0, val);
+	if (ret)
+		return ret;
+	ret = regmap_write(priv->regmap, AN8855_VAWD1, 0);
+	if (ret)
+		return ret;
+	return an8855_vlan_cmd(priv, AN8855_VTCR_WR_VID, vid);
+}
+
+static int an8855_8021q_tag_membership(struct an8855_priv *priv, int port,
+				      u16 vid, bool on)
+	__must_hold(&priv->reg_mutex)
+{
+	u32 val;
+	int ret;
+
+	if (on)
+		return an8855_vlan_add(priv, port, vid, true);
+	ret = an8855_vlan_cmd(priv, AN8855_VTCR_RD_VID, vid);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->regmap, AN8855_VARD0, &val);
+	if (ret)
+		return ret;
+	if (!(val & AN8855_VA0_VLAN_VALID) || !(FIELD_GET(AN8855_VA0_PORT, val) & BIT(port)))
+		return 0;
+	return an8855_vlan_del(priv, port, vid);
+}
+
+/* Finish a bridge leave that failed in an8855_8021q_set_filtering() before:
+ * drop the former bridge's VLANs and bring the port back.
+ */
+static int an8855_8021q_finish_leave(struct an8855_priv *priv, int port)
+{
+	struct dsa_port *dp = dsa_to_port(priv->ds, port);
+
+	if (!test_and_clear_bit(port, &priv->leave_pending))
+		return 0;
+	bitmap_zero(priv->bridge_vlans[port], VLAN_N_VID);
+	bitmap_zero(priv->bridge_untagged[port], VLAN_N_VID);
+	priv->bridge_pvid[port] = 0;
+	if (dp->user && netif_running(dp->user))
+		return an8855_port_set_status(priv, port, true);
+	return 0;
+}
+
+static int an8855_8021q_set_filtering(struct dsa_switch *ds, int port, bool on,
+				     struct netlink_ext_ack *extack)
+{
+	struct an8855_priv *priv = ds->priv;
+	struct an8855_vlan_transaction *state;
+	struct net_device *br = an8855_8021q_bridge_dev(priv, port);
+	struct dsa_port *other;
+	DECLARE_BITMAP(vids, VLAN_N_VID);
+	unsigned long old = priv->vlan_filtering, changed = 0, p, vid;
+	bool bridge_change;
+	int ret;
+
+	if (!dsa_is_user_port(ds, port))
+		return 0;
+	on = on && br;
+	bridge_change = br && br_vlan_enabled(br) == on;
+	/* Switchdev visits ports in sequence without unwinding earlier ports.
+	 * Validate and commit a bridge's awareness in one hardware transaction.
+	 * A detached port is cleaned up alone, preserving its former peers.
+	 */
+	dsa_switch_for_each_user_port(other, ds) {
+		if (bridge_change ? an8855_8021q_bridge_dev(priv, other->index) != br :
+				    other->index != port)
+			continue;
+		if (on) {
+			for_each_set_bit(vid, priv->bridge_vlans[other->index], VLAN_N_VID) {
+				ret = an8855_8021q_vlan_owner(priv, other->index, vid,
+							     true, true, extack);
+				if (ret)
+					return ret;
+			}
+		}
+		if (test_bit(other->index, &priv->vlan_filtering) != on)
+			set_bit(other->index, &changed);
+	}
+	if (!changed)
+		return on || br ? 0 : an8855_8021q_finish_leave(priv, port);
+	bitmap_zero(vids, VLAN_N_VID);
+	for_each_set_bit(p, &changed, AN8855_NUM_PORTS) {
+		bitmap_or(vids, vids, priv->bridge_vlans[p], VLAN_N_VID);
+		bitmap_or(vids, vids, priv->upper_vlans[p], VLAN_N_VID);
+		if (priv->tag_8021q_pvid[p])
+			set_bit(priv->tag_8021q_pvid[p], vids);
+	}
+	mutex_lock(&priv->reg_mutex);
+	/* The callback port need not be one of the ports still needing a change. */
+	p = find_first_bit(&changed, AN8855_NUM_PORTS);
+	ret = an8855_vlan_transaction_begin(priv, p, vids, &state);
+	if (ret)
+		goto out;
+	for_each_set_bit(p, &changed, AN8855_NUM_PORTS) {
+		if (test_bit(p, &state->port_mask))
+			continue;
+		ret = an8855_vlan_transaction_capture_port(priv, state, p);
+		if (ret) {
+			kfree(state);
+			goto out;
+		}
+	}
+	for_each_set_bit(p, &changed, AN8855_NUM_PORTS)
+		__assign_bit(p, &priv->vlan_filtering, on);
+	for_each_set_bit(vid, vids, VLAN_N_VID) {
+		if (vid_is_dsa_8021q(vid))
+			continue;
+		ret = an8855_8021q_sync_vlan(priv, vid);
+		if (ret)
+			goto restore;
+	}
+	for_each_set_bit(p, &changed, AN8855_NUM_PORTS) {
+		u16 tag_vid = priv->tag_8021q_pvid[p];
+
+		if (tag_vid && tag_vid != dsa_tag_8021q_standalone_vid(dsa_to_port(ds, p))) {
+			ret = an8855_8021q_tag_membership(priv, p, tag_vid,
+							!on && br);
+			if (ret)
+				goto restore;
+		}
+		ret = an8855_8021q_commit_pvid(priv, p);
+		if (ret)
+			goto restore;
+	}
+	kfree(state);
+	if (!on && !br)
+		ret = an8855_8021q_finish_leave(priv, port);
+	goto out;
+restore:
+	priv->vlan_filtering = old;
+	an8855_vlan_transaction_restore(priv, port, state);
+	kfree(state);
+out:
+	mutex_unlock(&priv->reg_mutex);
+	return ret;
+}
+
+static int an8855_8021q_customer_vlan(struct dsa_switch *ds, int port,
