#!/bin/sh
# TP-Link/Mercusys boards keep their factory data (including the 6-byte
# "default-mac"/label MAC and, on mx515v-v1, ath11k caldata) in a UBIFS
# volume - "tp_data" on most boards, "misc_ro" on mx515v-v1. Attach and
# mount it read-only during preinit so board.d/02_network and the ath11k
# caldata hotplug can read it without each attaching the volume themselves.

. /lib/functions.sh

preinit_mount_tp_data() {
	local mtd_name vol_name

	case "$(board_name)" in
	mercusys,mr80x-v2|tplink,archer-ax53-v2|tplink,archer-ax55-v1|tplink,archer-ax58-v2)
		mtd_name="tp_data"
		vol_name="tp_data"
		;;
	tplink,mx515v-v1)
		mtd_name="misc_data_ro"
		vol_name="misc_ro"
		;;
	*) return ;;
	esac

	# ubiattach lives in /usr/sbin, which the preinit PATH omits
	local PATH="/usr/sbin:/usr/bin:$PATH"
	local mtd_num ubi_num

	mtd_num=$(find_mtd_index "$mtd_name")
	[ -n "$mtd_num" ] || return

	ubi_num=$(ubiattach -m "$mtd_num" 2>/dev/null | \
		sed -n 's/.*device number \([0-9]*\).*/\1/p')
	[ -n "$ubi_num" ] || return

	mkdir -p /tmp/tp_data
	mount -t ubifs -o ro "ubi${ubi_num}:${vol_name}" /tmp/tp_data 2>/dev/null
}

boot_hook_add preinit_main preinit_mount_tp_data
