#!/bin/sh
# Set the factory MACs from tp_data/default-mac (= the label MAC, OUI
# a8:6e:84 on the AX55). Convention: lan/label = base MAC, wan = base+1.
# WiFi MACs are handled in the ieee80211 hotplug script (25-ax55-wifi).

. /lib/functions.sh
. /lib/functions/system.sh

[ "$(board_name)" = "tplink,archer-ax55-v1" ] || exit 0

mac="$(/lib/read-ax55-mac)" || exit 0
[ -n "$mac" ] || exit 0

uci -q batch <<-EOF
	set network.@device[0].macaddr='$mac'
	set network.wan.macaddr='$(macaddr_add "$mac" 1)'
EOF

# LAN switch ports carry the label MAC too (stock behaviour); without this
# they would inherit the DSA conduit's random MAC (cosmetic only - IP/ARP
# always uses the br-lan MAC set above).
for port in lan1 lan2 lan3 lan4; do
	uci -q batch <<-EOF
		set network.dev_$port=device
		set network.dev_$port.name='$port'
		set network.dev_$port.macaddr='$mac'
	EOF
done
uci -q commit network
exit 0
