@@ -725,7 +853,7 @@ static struct ath11k_hw_params ath11k_hw
 		.coldboot_cal_mm = true,
 		.coldboot_cal_ftm = true,
 		.cbcal_restart_fw = false,
-		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE,
+		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE_PROFILE,
 		.num_vdevs = 3,
 		.num_peers = 512,
 		.supports_suspend = false,
@@ -809,7 +937,7 @@ static struct ath11k_hw_params ath11k_hw
 		.supports_monitor = false,
 		.supports_sta_ps = false,
 		.supports_shadow_regs = false,
-		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE,
+		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE_PROFILE,
 		.num_vdevs = 16 + 1,
 		.num_peers = 512,
 		.supports_regdb = false,
@@ -993,7 +1121,7 @@ static struct ath11k_hw_params ath11k_hw
 		.coldboot_cal_mm = false,
 		.coldboot_cal_ftm = false,
 		.cbcal_restart_fw = false,
-		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE,
+		.fw_mem_mode = ATH11K_QMI_TARGET_MEM_MODE_PROFILE,
 		.num_vdevs = 4,
 		.num_peers = 512,
 		.supports_suspend = true,
@@ -3066,6 +3194,10 @@ static int ath11k_init_hw_params(struct
 
 	ab->hw_params = *hw_params;
 
+	ath11k_core_select_mem_profile(ab);
+	if (ab->hw_params.fw_mem_mode == ATH11K_QMI_TARGET_MEM_MODE_PROFILE)
+		ab->hw_params.fw_mem_mode = ab->mem_profile->fw_mem_mode;
+
 	ret = of_property_read_u32(ab->dev->of_node,
 				   "qcom,ath11k-fw-memory-mode",
 				   &fw_mem_mode);
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -1025,6 +1025,46 @@ struct ath11k_num_vdevs_peers {
 	u32 num_peers;
 };
 
+enum ath11k_mem_profile {
+	ATH11K_MEM_PROFILE_1G,
+	ATH11K_MEM_PROFILE_512M,
+	ATH11K_MEM_PROFILE_256M,
+	ATH11K_MEM_PROFILE_COUNT,
+};
+
+/* The host-side memory profile: the data path ring sizes and whether the
+ * rx descriptor carries the rx header TLV. One row per profile in
+ * ath11k_mem_profile_params (core.c), chosen at run time.
+ */
+struct ath11k_mem_profile_params {
+	enum ath11k_mem_profile id;
+	const char *name;
+	/* the QMI target memory mode for a hw_params entry that leaves the
+	 * choice to the profile and a device tree that names none
+	 */
+	int fw_mem_mode;
+	u32 tx_comp_ring_size;
+	/* frames in flight before the host TX path refuses more; 0 is no limit */
+	u32 tx_comp_max_allowed;
+	u32 rxdma_buf_ring_size;
+	/* not 0: the RXDMA buffer ring of a QCN6122 radio instead */
+	u32 rxdma_buf_ring_size_qcn6122;
+	/* the RX descriptor pool of a radio in the NSS Wi-Fi datapath */
+	u32 nss_rx_swdesc;
+	/* not 0: that pool for a QCN6122 radio instead */
+	u32 nss_rx_swdesc_qcn6122;
+	u32 rxdma_refill_ring_size;
+	/* the rx buffer length handed to the NSS Wi-Fi datapath */
+	u32 rxdma_nss_refill_ring_size;
+	u32 rxdma_err_dst_ring_size;
+	u32 rxdma_mon_status_ring_size;
+	u32 rxdma_monitor_buf_ring_size;
+	u32 rxdma_monitor_dst_ring_size;
+	u32 rxdma_monitor_desc_ring_size;
+	/* leave the rx header TLV out of the rx descriptor */
+	bool compact_rx_desc;
+};
+
 /* Master structure to hold the hw data which may be used in core module */
 struct ath11k_base {
 	enum ath11k_hw_rev hw_rev;
@@ -1087,6 +1127,9 @@ struct ath11k_base {
 	bool pdevs_macaddr_valid;
 
 	struct ath11k_hw_params hw_params;
+	const struct ath11k_mem_profile_params *mem_profile;
+	/* the rx descriptor is used without its rx header TLV */
+	bool compact_rx_desc;
 
 	const struct firmware *cal_file;
 
@@ -1425,7 +1468,7 @@ static inline const char *ath11k_scan_st
 static inline bool ath11k_nss_256m_enabled(struct ath11k_base *ab)
 {
 	return IS_ENABLED(CPTCFG_ATH11K_NSS_MEM_PROFILE_256M) &&
-	       IS_ENABLED(CPTCFG_ATH11K_MEM_PROFILE_256M) &&
+	       ab->mem_profile->id == ATH11K_MEM_PROFILE_256M &&
 	       ab->nss.enabled &&
 	       (ab->hw_rev == ATH11K_HW_IPQ5018_HW10 ||
 		ab->hw_rev == ATH11K_HW_QCN6122_HW10);
