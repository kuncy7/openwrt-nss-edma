 				     struct ath11k_per_peer_tx_stats *peer_stats,
 				     u8 legacy_rate_idx)
 {
-	struct rate_info *txrate = &arsta->txrate;
 	struct ath11k_htt_tx_stats *tx_stats;
 	int gi, mcs, bw, nss, ru_type, ppdu_type;
 
@@ -52,7 +52,7 @@ void ath11k_debugfs_sta_add_tx_stats(str
 		return;
 
 	tx_stats = arsta->tx_stats;
-	gi = FIELD_GET(RATE_INFO_FLAGS_SHORT_GI, arsta->txrate.flags);
+	gi = FIELD_GET(RATE_INFO_FLAGS_SHORT_GI, txrate->flags);
 	mcs = txrate->mcs;
 	bw = ath11k_mac_mac80211_bw_to_ath11k_bw(txrate->bw);
 	nss = txrate->nss - 1;
--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
@@ -689,7 +689,8 @@ void ath11k_dp_tx_update_txcompl(struct
 	}
 
 	if (ath11k_debugfs_is_extd_tx_stats_enabled(ar))
-		ath11k_debugfs_sta_add_tx_stats(arsta, peer_stats, rate_idx);
+		ath11k_debugfs_sta_add_tx_stats(arsta, &arsta->txrate, peer_stats,
+						rate_idx);
 
 err_out:
 	spin_unlock_bh(&ab->base_lock);
