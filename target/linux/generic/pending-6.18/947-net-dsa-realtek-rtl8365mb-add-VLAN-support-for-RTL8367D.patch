From: Gustavo Foletto Mora <gusfmora@gmail.com>
Subject: [PATCH] net: dsa: realtek: rtl8365mb: add VLAN support for RTL8367D

This driver's VLAN support is built on the VLAN membership configuration (MC)
database: the per-port PVID register holds a 5-bit index into it, and every
PVID change allocates, reuses or frees an MC entry.

RTL8367D parts have no such database. Register 0x0728 is not implemented --
writes are dropped and reads return zero, confirmed on hardware -- and the
port-based VID register is a different shape: one register per port at
0x0700 + port, holding a 12-bit VID directly. The VLAN4k table entry is also
two words rather than three, with the member and untag masks needing no
extension words on an eight port die, only four FIDs, and the learning mode
bits at the bottom of the second word instead of bit 14.

The consequence today is worse than "VLAN filtering does not work". The bridge
installs a default PVID on a port when it joins, even with VLAN filtering
disabled, so port_vlan_add() runs on every bridge join; it fails against the
absent database, and the join fails with it:

  rtl8365mb-mdio 90000.mdio-1:1d: VLAN should already exist in VLAN MC
  rtl8365mb-mdio 90000.mdio-1:1d lan1: failed to initialize vlan filtering on this port
  br-lan: port 1(lan1) entered disabled state

Every port is refused and the bridge is left with no members, so a device
built around one of these switches cannot bridge at all.

Add the family D paths. The absent database makes the PVID simpler, not
harder: with the VID living in the port register there is no scarce resource
to allocate, so setting a PVID is a register write plus the frame type filter
change that puts it to use, and clearing one is the same in reverse. The
VLAN4k entry gets its own pack and unpack. Everything else -- the table
access interface, the frame type filter at 0x07AA, the ingress filter at
0x07A9, the egress transparent masks at 0x09D0 and the VLAN enable at 0x07A8
-- is shared with the RTL8367C and needs no change, so VLAN filtering starts
working as a side effect.

The register addresses and the VLAN4k entry layout are taken from
dal_rtl8367d_vlan_portPvid_set(), _dal_rtl8367d_setAsicVlan4kEntry() and
_dal_rtl8367d_getAsicVlan4kEntry() in the stock qca-ssdk.ko of a TP-Link
EX511 v2, and agree with the "family D" path of OpenWrt's older swconfig
rtl8367b driver, which reaches the same conclusion from the other direction
and keeps a software shadow of the MC database purely to satisfy its own API.

--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -1277,7 +1277,7 @@
 	return 0;
 }
 
-static bool rtl8365mb_family_is_d(struct realtek_priv *priv)
+bool rtl8365mb_family_is_d(struct realtek_priv *priv)
 {
 	struct rtl8365mb *mb = priv->chip_data;
 
--- a/drivers/net/dsa/realtek/rtl8365mb_vlan.h
+++ b/drivers/net/dsa/realtek/rtl8365mb_vlan.h
@@ -12,6 +12,12 @@
 
 #include "realtek.h"
 
+/* Defined in rtl8365mb_main.c: RTL8367D parts share the switch core register
+ * map but not the VLAN membership configuration table or the port-based VID
+ * register layout, so the VLAN code has to know which family it is driving.
+ */
+bool rtl8365mb_family_is_d(struct realtek_priv *priv);
+
 enum rtl8365mb_frame_ingress {
 	RTL8365MB_FRAME_TYPE_ANY_FRAME = 0,
 	RTL8365MB_FRAME_TYPE_TAGGED_ONLY,
--- a/drivers/net/dsa/realtek/rtl8365mb_vlan.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_vlan.c
@@ -44,6 +44,14 @@
  *
  * VLANMC index 0 is reserved as a neutral PVID, used for standalone ports.
  *
+ * RTL8367D parts do not have a VLAN membership configuration database at all.
+ * Everything the database is used for here -- the PVID -- is instead expressed
+ * directly: the port-based VID register holds a VID rather than an index into
+ * the database, so a VLAN needs no resource beyond its VLAN4k entry. Their
+ * VLAN4k entry has a layout of its own as well. Those two differences are
+ * confined to the rtl8367d_* helpers below; the table access interface, the
+ * frame type filter and the VLAN control registers are shared.
+ *
  */
 
 #include "rtl8365mb_vlan.h"
@@ -113,6 +121,35 @@
 #define   RTL8365MB_VLAN_PVID_CTRL_PORT_MCIDX_MASK(_p) \
 		(0x1F << RTL8365MB_VLAN_PVID_CTRL_PORT_MCIDX_OFFSET(_p))
 
+/* RTL8367D parts have one port-based VID register per port, holding the VID
+ * itself rather than an index into the (absent) VLAN membership configuration
+ * database.
+ */
+#define RTL8367D_VLAN_PVID_CTRL_REG(_p) \
+		(RTL8365MB_VLAN_PVID_CTRL_BASE + (_p))
+#define   RTL8367D_VLAN_PVID_CTRL_VID_MASK		GENMASK(11, 0)
+
+/* CVLAN (i.e. VLAN4k) table entry layout on RTL8367D parts, u16[2].
+ *
+ * These parts have eight ports, so the member and untag masks need no
+ * extension words, and the entry is two words rather than three. Only four
+ * FIDs are available, and the remaining fields of the RTL8367C entry --
+ * priority, policing and metering -- have no equivalent here.
+ */
+#define RTL8367D_CVLAN_ENTRY_SIZE			2 /* 32-bits */
+#define RTL8367D_CVLAN_ENTRY_D0_MBR_MASK		GENMASK(7, 0)
+#define RTL8367D_CVLAN_ENTRY_D0_UNTAG_MASK		GENMASK(15, 8)
+#define RTL8367D_CVLAN_ENTRY_D1_FID_MASK		GENMASK(1, 0)
+/* Learning mode is selected per lookup domain: bit 3 covers C-VLAN lookups and
+ * bit 2 covers S-VLAN lookups. Both follow &rtl8365mb_vlan4k.ivl_en.
+ */
+#define RTL8367D_CVLAN_ENTRY_D1_SVLAN_IVL_MASK		GENMASK(2, 2)
+#define RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK		GENMASK(3, 3)
+
+/* Some limits for RTL8367D VLAN4k entries */
+#define RTL8367D_PORTMASKMAX	0x00FF
+#define RTL8367D_FIDMAX		3
+
 /* Frame type filtering registers */
 #define RTL8365MB_VLAN_ACCEPT_FRAME_TYPE_BASE	0x07aa
 #define RTL8365MB_VLAN_ACCEPT_FRAME_TYPE_REG(port) \
@@ -182,6 +219,56 @@
 	u8 meteridx : 6;
 };
 
+static int rtl8367d_vlan_4k_read(struct realtek_priv *priv, u16 vid,
+				 struct rtl8365mb_vlan4k *vlan4k)
+{
+	u16 data[RTL8367D_CVLAN_ENTRY_SIZE];
+	int ret;
+
+	ret = rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
+				    RTL8365MB_TABLE_OP_READ, &vid, 0, 0,
+				    data, ARRAY_SIZE(data));
+	if (ret)
+		return ret;
+
+	memset(vlan4k, 0, sizeof(*vlan4k));
+	vlan4k->vid = vid;
+	vlan4k->member = FIELD_GET(RTL8367D_CVLAN_ENTRY_D0_MBR_MASK, data[0]);
+	vlan4k->untag = FIELD_GET(RTL8367D_CVLAN_ENTRY_D0_UNTAG_MASK, data[0]);
+	vlan4k->fid = FIELD_GET(RTL8367D_CVLAN_ENTRY_D1_FID_MASK, data[1]);
+	vlan4k->ivl_en = FIELD_GET(RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK,
+				   data[1]);
+
+	return 0;
+}
+
+static int rtl8367d_vlan_4k_write(struct realtek_priv *priv,
+				  const struct rtl8365mb_vlan4k *vlan4k)
+{
+	u16 data[RTL8367D_CVLAN_ENTRY_SIZE] = { 0 };
+	u16 vid;
+
+	if (vlan4k->member > RTL8367D_PORTMASKMAX ||
+	    vlan4k->untag > RTL8367D_PORTMASKMAX ||
+	    vlan4k->fid > RTL8367D_FIDMAX)
+		return -EINVAL;
+
+	data[0] |= FIELD_PREP(RTL8367D_CVLAN_ENTRY_D0_MBR_MASK,
+			      vlan4k->member);
+	data[0] |= FIELD_PREP(RTL8367D_CVLAN_ENTRY_D0_UNTAG_MASK,
+			      vlan4k->untag);
+	data[1] |= FIELD_PREP(RTL8367D_CVLAN_ENTRY_D1_FID_MASK, vlan4k->fid);
+	data[1] |= FIELD_PREP(RTL8367D_CVLAN_ENTRY_D1_IVL_SVL_MASK,
+			      vlan4k->ivl_en);
+	data[1] |= FIELD_PREP(RTL8367D_CVLAN_ENTRY_D1_SVLAN_IVL_MASK,
+			      vlan4k->ivl_en);
+
+	vid = vlan4k->vid;
+	return rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
+				     RTL8365MB_TABLE_OP_WRITE, &vid, 0, 0,
+				     data, ARRAY_SIZE(data));
+}
+
 static int rtl8365mb_vlan_4k_read(struct realtek_priv *priv, u16 vid,
 				  struct rtl8365mb_vlan4k *vlan4k)
 {
@@ -189,6 +276,9 @@
 	int val;
 	int ret;
 
+	if (rtl8365mb_family_is_d(priv))
+		return rtl8367d_vlan_4k_read(priv, vid, vlan4k);
+
 	ret = rtl8365mb_table_query(priv, RTL8365MB_TABLE_CVLAN,
 				    RTL8365MB_TABLE_OP_READ, &vid, 0, 0,
 				    data, ARRAY_SIZE(data));
@@ -237,6 +327,9 @@
 	u16 vid;
 	int val;
 
+	if (rtl8365mb_family_is_d(priv))
+		return rtl8367d_vlan_4k_write(priv, vlan4k);
+
 	/* Pack table entry value */
 	val = FIELD_GET(RTL8365MB_CVLAN_MBR_LO_MASK, vlan4k->member);
 	data[0] |= FIELD_PREP(RTL8365MB_CVLAN_ENTRY_D0_MBR_MASK, val);
@@ -662,6 +755,33 @@
 	return 0;
 }
 
+static int rtl8367d_vlan_port_get_pvid(struct realtek_priv *priv, int port,
+				       u16 *pvid)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(priv->map, RTL8367D_VLAN_PVID_CTRL_REG(port), &val);
+	if (ret)
+		return ret;
+
+	*pvid = FIELD_GET(RTL8367D_VLAN_PVID_CTRL_VID_MASK, val);
+
+	return 0;
+}
+
+static int rtl8367d_vlan_port_set_pvid(struct realtek_priv *priv, int port,
+				       u16 vid)
+{
+	dev_dbg(priv->dev, "set PVID %d on port %d\n", vid, port);
+
+	return regmap_update_bits(priv->map,
+				  RTL8367D_VLAN_PVID_CTRL_REG(port),
+				  RTL8367D_VLAN_PVID_CTRL_VID_MASK,
+				  FIELD_PREP(RTL8367D_VLAN_PVID_CTRL_VID_MASK,
+					     vid));
+}
+
 /*
  * rtl8365mb_vlan_port_get_pvid - Retrieve the port PVID
  * @priv: realtek switch private structure
@@ -679,6 +799,9 @@
 	u8 vlanmc_idx;
 	int ret;
 
+	if (rtl8365mb_family_is_d(priv))
+		return rtl8367d_vlan_port_get_pvid(priv, port, pvid);
+
 	ret = rtl8365mb_vlan_get_pvid_mc(priv, port, &vlanmc_idx, &vlanmc);
 	if (ret)
 		return ret;
@@ -748,6 +871,109 @@
 				  val);
 }
 
+static int rtl8367d_vlan_pvid_port_set(struct dsa_switch *ds, int port,
+				       u16 vid,
+				       struct netlink_ext_ack *extack)
+{
+	enum rtl8365mb_frame_ingress prev_accepted_frame;
+	struct realtek_priv *priv = ds->priv;
+	u16 prev_pvid;
+	int ret;
+
+	if (vid > RTL8365MB_MAX_4K_VID) {
+		NL_SET_ERR_MSG_MOD(extack, "VLAN ID greater than "
+				   __stringify(RTL8365MB_MAX_4K_VID));
+		return -EINVAL;
+	}
+
+	/* Read the old PVID exclusively to undo in case of error */
+	ret = rtl8367d_vlan_port_get_pvid(priv, port, &prev_pvid);
+	if (ret) {
+		dev_err(priv->dev, "Failed to read current PVID\n");
+		return ret;
+	}
+
+	ret = rtl8365mb_vlan_port_get_framefilter(priv, port,
+						  &prev_accepted_frame);
+	if (ret) {
+		dev_err(priv->dev, "Failed to get current framefilter\n");
+		return ret;
+	}
+
+	ret = rtl8367d_vlan_port_set_pvid(priv, port, vid);
+	if (ret) {
+		dev_err(priv->dev, "Failed to set port PVID\n");
+		return ret;
+	}
+
+	/* Changing accept frame is what enables PVID (if not enabled before) */
+	ret = rtl8365mb_vlan_port_set_framefilter(
+		priv, port, RTL8365MB_FRAME_TYPE_ANY_FRAME);
+	if (ret) {
+		dev_err(priv->dev, "Failed to set port frame filter\n");
+		(void)rtl8367d_vlan_port_set_pvid(priv, port, prev_pvid);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int rtl8367d_vlan_pvid_port_clear(struct dsa_switch *ds, int port,
+					 u16 vid)
+{
+	enum rtl8365mb_frame_ingress accepted_frame, prev_accepted_frame;
+	struct realtek_priv *priv = ds->priv;
+	u16 pvid;
+	int ret;
+
+	ret = rtl8367d_vlan_port_get_pvid(priv, port, &pvid);
+	if (ret) {
+		dev_err(priv->dev, "Failed to read current PVID\n");
+		return ret;
+	}
+
+	/* Port is not using PVID, or is leaving some other VLAN. Nothing to
+	 * remove.
+	 */
+	if (!pvid || pvid != vid)
+		return 0;
+
+	ret = rtl8365mb_vlan_port_get_framefilter(priv, port,
+						  &prev_accepted_frame);
+	if (ret) {
+		dev_err(priv->dev, "Failed to get current framefilter\n");
+		return ret;
+	}
+
+	/* Changing accept frame is what really removes PVID. But only do
+	 * that if we are filtering vlan
+	 */
+	if (dsa_port_is_vlan_filtering(dsa_to_port(ds, port))) {
+		accepted_frame = RTL8365MB_FRAME_TYPE_TAGGED_ONLY;
+
+		ret = rtl8365mb_vlan_port_set_framefilter(priv, port,
+							  accepted_frame);
+		if (ret) {
+			dev_err(priv->dev, "Failed to set port frame filter\n");
+			return ret;
+		}
+	} else {
+		/* skip the framefilter undo below */
+		accepted_frame = prev_accepted_frame;
+	}
+
+	ret = rtl8367d_vlan_port_set_pvid(priv, port, 0);
+	if (ret) {
+		dev_err(priv->dev, "Failed to set port PVID to 0\n");
+		if (prev_accepted_frame != accepted_frame)
+			(void)rtl8365mb_vlan_port_set_framefilter(
+				priv, port, prev_accepted_frame);
+		return ret;
+	}
+
+	return 0;
+}
+
 /*
  * rtl8365mb_vlan_pvid_port_set() - Configure a port's PVID and associated
  * VLANMC entry
@@ -777,6 +1003,9 @@
 
 	lockdep_assert_held(&priv->vlan_lock);
 
+	if (rtl8365mb_family_is_d(priv))
+		return rtl8367d_vlan_pvid_port_set(ds, port, vid, extack);
+
 	/* Read the old PVID exclusively to undo in case of error */
 	ret = rtl8365mb_vlan_get_pvid_mc(priv, port, &prev_vlanmc_idx,
 					 &prev_vlanmc);
@@ -879,6 +1108,9 @@
 
 	lockdep_assert_held(&priv->vlan_lock);
 
+	if (rtl8365mb_family_is_d(priv))
+		return rtl8367d_vlan_pvid_port_clear(ds, port, vid);
+
 	ret = rtl8365mb_vlan_get_pvid_mc(priv, port, &vlanmc_idx,
 					 &vlanmc);
 	if (ret) {
