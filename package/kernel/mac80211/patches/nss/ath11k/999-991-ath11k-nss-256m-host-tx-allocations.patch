+			   dp->host_tx_allocated, ab->nss.enabled);
 
 	INIT_LIST_HEAD(&dp->reo_cmd_list);
 	INIT_LIST_HEAD(&dp->reo_cmd_cache_flush_list);
@@ -1127,8 +1144,14 @@
 	}
 
 	ret = ath11k_dp_srng_common_setup(ab);
-	if (ret)
