#!/bin/sh

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

ipq50xx_setup_interfaces()
{
	local board="$1"
	case $board in
	tplink,archer-ax55-v1)
		# All five jacks are RTL8367S switch ports behind the gmac1
		# DSA conduit: blue WAN jack = port0 ("wan"), LAN1-4 =
		# ports1-4. The SoC's internal GE PHY is not bonded out.
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		ucidef_set_network_device_conduit "lan1" "eth1"
		ucidef_set_network_device_conduit "lan2" "eth1"
		ucidef_set_network_device_conduit "lan3" "eth1"
		ucidef_set_network_device_conduit "lan4" "eth1"
		ucidef_set_network_device_conduit "wan" "eth0"
		;;
	elecom,wrc-x3000gs2|\
	iodata,wn-dax3000gr|\
	linksys,mr5500|\
	zyxel,scr50axe)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		;;
	glinet,gl-b3000)
		ucidef_set_interfaces_lan_wan "lan1 lan2" "wan"
		;;
	cmcc,mr3000d-ci|\
	cmcc,pz-l8|\
	linksys,mx2000|\
	linksys,mx5500|\
	linksys,spnmx56|\
	xiaomi,ax6000)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3" "wan"
		;;
	linksys,mx6200|\
	yuncore,ax830|\
	yuncore,ax850)
		ucidef_set_interfaces_lan_wan "lan" "wan"
		;;
	esac
}

board_config_update
board=$(board_name)
ipq50xx_setup_interfaces $board
board_config_flush

exit 0
