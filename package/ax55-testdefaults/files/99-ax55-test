#!/bin/sh
#
# TP-Link Archer AX55 v1 - bring-up test defaults.
#
# Purpose: keep a freshly booted AX55 reachable during bring-up, over as many
# independent paths as possible, since the RTL8367S LAN trunk (2.5G HSGMII)
# is not yet verified working on real hardware:
#   - LAN management IP -> 192.168.1.3         (via RTL8367S trunk - unverified)
#   - WAN static IP     -> 192.168.2.3         (plain GE PHY, independent of
#                                                the RTL8367S/HSGMII path)
#   - every WiFi radio brought up as a WPA2 AP (SSID OpenWrt-AX55 / needs
#                                                neither LAN nor WAN to work)
#
# This is a TEST helper, not for permanent installs.

WIFI_SSID="OpenWrt-AX55"
WIFI_KEY="ax55test"        # WPA2 PSK, >= 8 chars
WIFI_COUNTRY="PL"
LAN_IP="192.168.1.3"

# --- LAN management address -------------------------------------------------
if ! uci -q get network.lan >/dev/null; then
	uci -q batch <<-EOF
		set network.lan=interface
		set network.lan.proto='static'
		set network.lan.netmask='255.255.255.0'
	EOF
fi
uci -q batch <<-EOF
	set network.lan.proto='static'
	set network.lan.ipaddr='$LAN_IP'
	set network.lan.netmask='255.255.255.0'
	delete network.lan.ip6assign
EOF

# --- WAN --------------------------------------------------------------------
# The blue WAN jack is RTL8367S port 0 ("wan" DSA port). Normal router
# behaviour: DHCP client (board.d default already sets this - nothing to do).

# Open SSH (dropbear) and ping on the wan firewall zone for this test image -
# the default template rejects unsolicited input there.
uci -q batch <<-EOF
	set firewall.ax55_test_ssh=rule
	set firewall.ax55_test_ssh.name='ax55-test-allow-ssh-wan'
	set firewall.ax55_test_ssh.src='wan'
	set firewall.ax55_test_ssh.proto='tcp'
	set firewall.ax55_test_ssh.dest_port='22'
	set firewall.ax55_test_ssh.target='ACCEPT'
	set firewall.ax55_test_ping=rule
	set firewall.ax55_test_ping.name='ax55-test-allow-ping-wan'
	set firewall.ax55_test_ping.src='wan'
	set firewall.ax55_test_ping.proto='icmp'
	set firewall.ax55_test_ping.icmp_type='echo-request'
	set firewall.ax55_test_ping.target='ACCEPT'
EOF

uci -q commit network
uci -q commit dhcp
uci -q commit firewall

# --- WiFi -------------------------------------------------------------------
# NOTE: the WiFi AP is NOT configured here. ath11k loads its firmware
# asynchronously and only registers the radios ~14s into boot, well after
# uci-defaults run (~10s), so doing it here would find no PHYs. It is handled
# instead by /etc/hotplug.d/ieee80211/25-ax55-wifi, which fires exactly when
# each radio registers (SSID OpenWrt-AX55 / key ax55test).

# Apply LAN/WAN addressing and firewall immediately (no reboot needed).
/etc/init.d/network reload >/dev/null 2>&1
/etc/init.d/firewall reload >/dev/null 2>&1

exit 0
